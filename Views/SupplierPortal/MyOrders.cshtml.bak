@model List<StockFlow.Models.PurchaseOrder>
@using System.Linq
@{
    Layout = null;
    ViewData["Title"] = "Supplier Portal";
    var supplierName = ViewBag.SupplierName as string ?? "Supplier";
    int received = Model.Count(o => o.Status == "Received");
    int pending  = Model.Count(o => o.Status != "Received");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Supplier Portal - INVEXA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Metal+Mania&display=swap" rel="stylesheet">
    <style>
        :root { --bg:#0F172A; --card:#162033; --bd:rgba(255,255,255,.06); --text:#F8FAFC; --sec:#94A3B8; --primary:#7C3AED; }
        * { box-sizing:border-box; margin:0; padding:0; font-family:'Plus Jakarta Sans',system-ui,sans-serif; }
        body { background:var(--bg); color:var(--text); min-height:100vh; }
        .sp-top { display:flex; align-items:center; justify-content:space-between; padding:16px 30px;
            background:#132236; border-bottom:1px solid var(--bd); position:sticky; top:0; z-index:10; }
        .sp-brand { display:flex; align-items:center; gap:12px; }
        .sp-logo { width:40px; height:40px; border-radius:11px; background:linear-gradient(135deg,#6366f1,#8b5cf6);
            display:grid; place-items:center; color:#fff; font-size:20px; }
        .sp-brand h1 { font-family:'Metal Mania',cursive; font-weight:400; font-size:26px; letter-spacing:1px; }
        .sp-brand span { font-size:11px; color:var(--sec); display:block; letter-spacing:2px; text-transform:uppercase; margin-top:-4px; }
        .sp-user { display:flex; align-items:center; gap:14px; }
        .sp-name { text-align:right; }
        .sp-name b { font-size:14px; } .sp-name small { color:var(--sec); font-size:12px; display:block; }
        .sp-logout { background:transparent; border:1px solid var(--bd); color:var(--sec); border-radius:10px;
            padding:9px 15px; font-size:13px; font-weight:600; cursor:pointer; display:inline-flex; gap:7px; align-items:center; }
        .sp-logout:hover { background:rgba(239,68,68,.12); color:#fca5a5; border-color:rgba(239,68,68,.3); }
        .sp-wrap { max-width:1000px; margin:0 auto; padding:34px 24px 50px; }
        .sp-head h2 { font-size:24px; font-weight:700; }
        .sp-head p { color:var(--sec); font-size:14px; margin-top:3px; }
        .sp-stats { display:flex; gap:16px; margin:22px 0 28px; flex-wrap:wrap; }
        .sp-stat { background:var(--card); border:1px solid var(--bd); border-radius:14px; padding:16px 22px; min-width:150px; }
        .sp-stat .v { font-size:24px; font-weight:800; } .sp-stat .l { font-size:12.5px; color:var(--sec); }
        .sp-order { background:var(--card); border:1px solid var(--bd); border-radius:16px; padding:20px 22px; margin-bottom:16px; }
        .sp-order-h { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:14px; }
        .sp-order-h .no { font-size:16px; font-weight:700; }
        .sp-order-h .dt { font-size:12.5px; color:var(--sec); margin-top:2px; }
        .badge { font-size:11.5px; font-weight:700; padding:5px 12px; border-radius:999px; }
        .b-draft { background:rgba(148,163,184,.16); color:#cbd5e1; }
        .b-sent  { background:rgba(245,158,11,.16); color:#fcd34d; }
        .b-recv  { background:rgba(34,197,94,.16); color:#86efac; }
        table.sp-items { width:100%; border-collapse:collapse; }
        .sp-items th { text-align:left; font-size:11.5px; text-transform:uppercase; letter-spacing:.3px; color:var(--sec);
            padding:8px 10px; border-bottom:1px solid var(--bd); }
        .sp-items td { padding:10px; border-bottom:1px solid var(--bd); font-size:13.5px; }
        .sp-items tr:last-child td { border-bottom:none; }
        .sp-empty { text-align:center; color:var(--sec); padding:60px 20px; background:var(--card); border:1px solid var(--bd); border-radius:16px; }
        .sp-empty i { font-size:40px; display:block; margin-bottom:12px; color:#475569; }
    </style>
</head>
<body>
    <div class="sp-top">
        <div class="sp-brand">
            <div class="sp-logo"><i class="bi bi-box-seam"></i></div>
            <div><h1>INVEXA</h1><span>Supplier Portal</span></div>
        </div>
        <div class="sp-user">
            <div class="sp-name"><b>@supplierName</b><small>Supplier</small></div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="sp-logout"><i class="bi bi-box-arrow-right"></i> Logout</button>
            </form>
        </div>
    </div>

    <div class="sp-wrap">
        <div class="sp-head">
            <h2>My Purchase Orders</h2>
            <p>Yahan aapko wo saare orders dikhte hain jo aapko (@supplierName) diye gaye hain.</p>
        </div>

        <div class="sp-stats">
            <div class="sp-stat"><div class="v">@Model.Count</div><div class="l">Total Orders</div></div>
            <div class="sp-stat"><div class="v">@pending</div><div class="l">Pending / In Progress</div></div>
            <div class="sp-stat"><div class="v">@received</div><div class="l">Received</div></div>
        </div>

        @if (Model.Any())
        {
            foreach (var o in Model)
            {
                var badge = o.Status == "Received" ? "b-recv" : (o.Status == "Sent" ? "b-sent" : "b-draft");
                <div class="sp-order">
                    <div class="sp-order-h">
                        <div>
                            <div class="no">@o.PurchaseOrderNumber</div>
                            <div class="dt">Ordered: @o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")@(o.ReceivedAt != null ? "  •  Received: " + o.ReceivedAt.Value.ToLocalTime().ToString("dd MMM yyyy") : "")</div>
                        </div>
                        <span class="badge @badge">@o.Status</span>
                    </div>
                    <table class="sp-items">
                        <thead><tr><th>Product</th><th>Ordered Qty</th><th>Received Qty</th><th>Unit Cost</th></tr></thead>
                        <tbody>
                            @foreach (var it in o.Items)
                            {
                                <tr>
                                    <td>@(it.Product?.ProductName ?? "Product #" + it.ProductId)</td>
                                    <td>@it.OrderedQuantity</td>
                                    <td>@it.ReceivedQuantity</td>
                                    <td>&#8377;@it.UnitCost.ToString("N2")</td>
                                </tr>
                            }
                            @if (!o.Items.Any())
                            {
                                <tr><td colspan="4" style="color:var(--sec)">No items on this order.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <div class="sp-empty">
                <i class="bi bi-inbox"></i>
                Abhi aapko koi purchase order nahi mila hai.
            </div>
        }
    </div>
</body>
</html>
