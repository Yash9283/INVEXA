@model List<StockFlow.Models.PurchaseOrder>
@using System.Linq
@{
    Layout = null;
    ViewData["Title"] = "Supplier Portal";
    var supplierName = ViewBag.SupplierName as string ?? "Supplier";
    int received = Model.Count(o => o.Status == "Received");
    int pending  = Model.Count(o => o.Status != "Received");
    decimal grandTotal = Model.Sum(o => o.Items.Sum(i => i.OrderedQuantity * i.UnitCost));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Supplier Portal - INVEXA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Metal+Mania&display=swap" rel="stylesheet">
    <style>
        :root { --bg:#0F172A; --card:#162033; --bd:rgba(255,255,255,.06); --text:#F8FAFC; --sec:#94A3B8;
            --primary:#7C3AED; --green:#22C55E; --amber:#F59E0B; }
        * { box-sizing:border-box; margin:0; padding:0; font-family:'Plus Jakarta Sans',system-ui,sans-serif; }
        body { background:var(--bg); color:var(--text); min-height:100vh; }

        /* Top bar */
        .sp-top { display:flex; align-items:center; justify-content:space-between; padding:15px 30px;
            background:#132236; border-bottom:1px solid var(--bd); position:sticky; top:0; z-index:20; }
        .sp-brand { display:flex; align-items:center; gap:12px; }
        .sp-logo { width:40px; height:40px; border-radius:11px; background:linear-gradient(135deg,#6366f1,#8b5cf6);
            display:grid; place-items:center; color:#fff; font-size:20px; box-shadow:0 6px 16px rgba(124,58,237,.4); }
        .sp-brand h1 { font-family:'Metal Mania',cursive; font-weight:400; font-size:26px; letter-spacing:1px; line-height:1; }
        .sp-brand span { font-size:10.5px; color:var(--sec); display:block; letter-spacing:2px; text-transform:uppercase; margin-top:2px; }
        .sp-user { display:flex; align-items:center; gap:14px; }
        .sp-av { width:40px; height:40px; border-radius:11px; background:linear-gradient(135deg,#7C3AED,#6d28d9);
            display:grid; place-items:center; color:#fff; font-weight:700; font-size:15px; }
        .sp-name { text-align:right; } .sp-name b { font-size:14px; } .sp-name small { color:var(--sec); font-size:11.5px; display:block; }
        .sp-logout { background:transparent; border:1px solid var(--bd); color:var(--sec); border-radius:10px;
            padding:9px 15px; font-size:13px; font-weight:600; cursor:pointer; display:inline-flex; gap:7px; align-items:center; transition:.2s; }
        .sp-logout:hover { background:rgba(239,68,68,.12); color:#fca5a5; border-color:rgba(239,68,68,.3); }

        .sp-wrap { max-width:1020px; margin:0 auto; padding:30px 24px 55px; }

        /* Hero */
        .sp-hero { background:radial-gradient(120% 160% at 0% 0%, rgba(124,58,237,.28), rgba(22,32,51,0) 60%), var(--card);
            border:1px solid var(--bd); border-radius:20px; padding:24px 26px; margin-bottom:22px; }
        .sp-hero h2 { font-size:24px; font-weight:700; }
        .sp-hero p { color:var(--sec); font-size:14px; margin-top:5px; }

        /* Stats */
        .sp-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:26px; }
        .sp-stat { background:var(--card); border:1px solid var(--bd); border-radius:16px; padding:18px 20px;
            display:flex; align-items:center; gap:14px; }
        .sp-stat .ic { width:46px; height:46px; border-radius:12px; display:grid; place-items:center; font-size:21px; flex:0 0 46px; }
        .ic-p { background:rgba(124,58,237,.15); color:#a78bfa; }
        .ic-a { background:rgba(245,158,11,.15); color:#fbbf24; }
        .ic-g { background:rgba(34,197,94,.15); color:#4ade80; }
        .sp-stat .v { font-size:23px; font-weight:800; line-height:1; } .sp-stat .l { font-size:12px; color:var(--sec); margin-top:3px; }

        .sp-sec-title { font-size:16px; font-weight:700; margin:0 0 14px; display:flex; align-items:center; gap:8px; }
        .sp-sec-title .c { font-size:12px; font-weight:600; color:var(--sec); background:rgba(255,255,255,.05);
            border:1px solid var(--bd); padding:3px 10px; border-radius:999px; }

        /* Order card */
        .sp-order { background:var(--card); border:1px solid var(--bd); border-radius:18px; overflow:hidden; margin-bottom:16px;
            box-shadow:0 8px 22px rgba(2,6,23,.25); }
        .sp-order-h { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; padding:18px 22px; border-bottom:1px solid var(--bd); }
        .sp-order-h .no { font-size:17px; font-weight:700; }
        .sp-order-h .dt { font-size:12.5px; color:var(--sec); margin-top:3px; }
        .badge { font-size:11.5px; font-weight:700; padding:6px 13px; border-radius:999px; display:inline-flex; align-items:center; gap:6px; }
        .b-draft { background:rgba(148,163,184,.16); color:#cbd5e1; }
        .b-sent  { background:rgba(245,158,11,.16); color:#fcd34d; }
        .b-recv  { background:rgba(34,197,94,.16); color:#86efac; }

        /* Stepper */
        .sp-steps { display:flex; align-items:center; padding:16px 22px; gap:0; }
        .sp-step { display:flex; align-items:center; gap:9px; }
        .sp-step .dot { width:26px; height:26px; border-radius:50%; display:grid; place-items:center; font-size:13px;
            background:rgba(255,255,255,.06); color:var(--sec); border:1px solid var(--bd); }
        .sp-step.done .dot { background:var(--green); color:#04210f; border-color:transparent; }
        .sp-step .tx { font-size:12.5px; color:var(--sec); font-weight:600; }
        .sp-step.done .tx { color:var(--text); }
        .sp-line { flex:1; height:2px; background:rgba(255,255,255,.08); margin:0 10px; border-radius:2px; }
        .sp-line.done { background:var(--green); }

        /* Items */
        table.sp-items { width:100%; border-collapse:collapse; }
        .sp-items th { text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:.3px; color:var(--sec);
            padding:10px 22px; border-top:1px solid var(--bd); border-bottom:1px solid var(--bd); background:rgba(255,255,255,.02); }
        .sp-items th.r, .sp-items td.r { text-align:right; }
        .sp-items td { padding:12px 22px; border-bottom:1px solid var(--bd); font-size:13.5px; }
        .sp-items tr:last-child td { border-bottom:none; }
        .sp-items .pn { font-weight:600; }
        .rcv-bar { height:5px; width:90px; background:rgba(255,255,255,.08); border-radius:999px; margin-top:5px; overflow:hidden; }
        .rcv-fill { height:100%; background:var(--green); border-radius:999px; }
        .rcv-txt { font-size:11px; color:var(--sec); }
        .sp-order-f { display:flex; align-items:center; justify-content:space-between; padding:14px 22px; background:rgba(255,255,255,.02); }
        .sp-order-f .lbl { font-size:12.5px; color:var(--sec); }
        .sp-order-f .amt { font-size:17px; font-weight:800; }

        .sp-empty { text-align:center; color:var(--sec); padding:64px 20px; background:var(--card); border:1px solid var(--bd); border-radius:18px; }
        .sp-empty i { font-size:44px; display:block; margin-bottom:14px; color:#475569; }
        .sp-empty b { color:var(--text); display:block; margin-bottom:4px; font-size:15px; }

        @@media (max-width:640px){ .sp-stats{ grid-template-columns:1fr; } .sp-top{ padding:14px 18px; } .sp-wrap{ padding:22px 16px 40px; } }
    </style>
</head>
<body>
    <div class="sp-top">
        <div class="sp-brand">
            <div class="sp-logo"><i class="bi bi-box-seam"></i></div>
            <div><h1>INVEXA</h1><span>Supplier Portal</span></div>
        </div>
        <div class="sp-user">
            <div class="sp-name"><b>@supplierName</b><small>Supplier account</small></div>
            <div class="sp-av">@(supplierName.Length > 0 ? supplierName.Substring(0,1).ToUpper() : "S")</div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="sp-logout"><i class="bi bi-box-arrow-right"></i> Logout</button>
            </form>
        </div>
    </div>

    <div class="sp-wrap">
        <div class="sp-hero">
            <h2>Welcome, @supplierName 👋</h2>
        </div>

        <div class="sp-stats">
            <div class="sp-stat"><div class="ic ic-p"><i class="bi bi-receipt"></i></div><div><div class="v">@Model.Count</div><div class="l">Total Orders</div></div></div>
            <div class="sp-stat"><div class="ic ic-a"><i class="bi bi-hourglass-split"></i></div><div><div class="v">@pending</div><div class="l">Pending / In Progress</div></div></div>
            <div class="sp-stat"><div class="ic ic-g"><i class="bi bi-check2-circle"></i></div><div><div class="v">@received</div><div class="l">Received</div></div></div>
        </div>

        <div class="sp-sec-title">Purchase Orders <span class="c">@Model.Count total &#8226; &#8377;@grandTotal.ToString("N0") value</span></div>

        @if (Model.Any())
        {
            foreach (var o in Model)
            {
                var badge = o.Status == "Received" ? "b-recv" : (o.Status == "Sent" ? "b-sent" : "b-draft");
                var bicon = o.Status == "Received" ? "bi-check-circle-fill" : (o.Status == "Sent" ? "bi-send-fill" : "bi-pencil-fill");
                var step = o.Status == "Received" ? 3 : (o.Status == "Sent" ? 2 : 1);
                var orderTotal = o.Items.Sum(i => i.OrderedQuantity * i.UnitCost);
                <div class="sp-order">
                    <div class="sp-order-h">
                        <div>
                            <div class="no">@o.PurchaseOrderNumber</div>
                            <div class="dt"><i class="bi bi-calendar3 me-1"></i>Ordered @o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")@(o.ReceivedAt != null ? "  •  Received " + o.ReceivedAt.Value.ToLocalTime().ToString("dd MMM yyyy") : "")</div>
                        </div>
                        <span class="badge @badge"><i class="bi @bicon"></i>@o.Status</span>
                    </div>

                    <div class="sp-steps">
                        <div class="sp-step @(step >= 1 ? "done" : "")"><div class="dot"><i class="bi bi-pencil"></i></div><span class="tx">Ordered</span></div>
                        <div class="sp-line @(step >= 2 ? "done" : "")"></div>
                        <div class="sp-step @(step >= 2 ? "done" : "")"><div class="dot"><i class="bi bi-send"></i></div><span class="tx">Sent</span></div>
                        <div class="sp-line @(step >= 3 ? "done" : "")"></div>
                        <div class="sp-step @(step >= 3 ? "done" : "")"><div class="dot"><i class="bi bi-check2"></i></div><span class="tx">Received</span></div>
                    </div>

                    <table class="sp-items">
                        <thead><tr><th>Product</th><th class="r">Ordered</th><th>Received</th><th class="r">Unit Cost</th><th class="r">Line Total</th></tr></thead>
                        <tbody>
                            @foreach (var it in o.Items)
                            {
                                var pct = it.OrderedQuantity > 0 ? Math.Min(100, (int)Math.Round(it.ReceivedQuantity * 100.0 / it.OrderedQuantity)) : 0;
                                <tr>
                                    <td class="pn">@(it.Product?.ProductName ?? "Product #" + it.ProductId)</td>
                                    <td class="r">@it.OrderedQuantity</td>
                                    <td>
                                        <div class="rcv-txt">@it.ReceivedQuantity of @it.OrderedQuantity</div>
                                        <div class="rcv-bar"><div class="rcv-fill" style="width:@(pct)%"></div></div>
                                    </td>
                                    <td class="r">&#8377;@it.UnitCost.ToString("N2")</td>
                                    <td class="r">&#8377;@((it.OrderedQuantity * it.UnitCost).ToString("N2"))</td>
                                </tr>
                            }
                            @if (!o.Items.Any())
                            {
                                <tr><td colspan="5" style="color:var(--sec)">No items on this order.</td></tr>
                            }
                        </tbody>
                    </table>

                    <div class="sp-order-f">
                        <span class="lbl">@o.Items.Count item@(o.Items.Count == 1 ? "" : "s")</span>
                        <span><span class="lbl">Order total &nbsp;</span><span class="amt">&#8377;@orderTotal.ToString("N2")</span></span>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="sp-empty">
                <i class="bi bi-inbox"></i>
                <b>No orders yet</b>
                When the company places a purchase order with you, it will appear here.
            </div>
        }
    </div>
</body>
</html>
