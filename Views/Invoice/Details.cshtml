@model StockFlow.Models.Invoice
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Invoice"; }
<style>
    #invoice { background: #9CB080 !important; border: none !important; }
    #invoice * { color: #14210f !important; }
    #invoice .text-muted { color: #2c3b22 !important; }
    #invoice thead th { background: #618764 !important; color: #ffffff !important; }
    #invoice tfoot th { background: #618764 !important; color: #ffffff !important; }
    #invoice tbody td { background: #618764 !important; color: #ffffff !important; }
    #invoice .badge { color: #b91c1c !important; background: #ffffff !important; border: none !important; font-weight: 700 !important; }
    @@media print {
        body * { visibility: hidden; }
        #invoice, #invoice * { visibility: visible; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        #invoice { position: absolute; left: 0; top: 0; width: 100%; background: #9CB080 !important; box-shadow: none !important; border: none !important; }
        #invoice * { color: #14210f !important; }
        #invoice thead th, #invoice tfoot th { background: #618764 !important; color: #ffffff !important; }
        #invoice tbody td { background: #618764 !important; color: #ffffff !important; }
        #invoice .badge { color: #b91c1c !important; background: transparent !important; border: none !important; font-size: 1.05rem !important; padding: 0 !important; font-weight: 700 !important; }
    }
</style>
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Invoice @Model.InvoiceNumber</h2><p class="text-muted mb-0">Issued @Model.InvoiceDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p></div><div><a asp-action="Index" class="btn btn-outline-secondary">Back</a> <button onclick="window.print()" class="btn btn-primary">Print</button></div></div>
<div class="card shadow-sm border-0" id="invoice"><div class="card-body p-4"><div class="d-flex justify-content-between border-bottom pb-3 mb-4"><div><h4>INVEXA</h4><div class="text-muted">Smart inventory receipt</div></div><div class="text-end"><strong>@Model.InvoiceNumber</strong><br/><span class="badge @(Model.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">@Model.PaymentStatus</span></div></div><div class="row mb-4"><div class="col-md-6"><div class="text-muted small">BILL TO</div><div class="fw-semibold">@Model.CustomerName</div><div>@Model.Phone</div><div>@Model.Email</div></div></div><table class="table"><thead><tr><th>Product</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Total</th></tr></thead><tbody><tr><td>@Model.ProductName</td><td class="text-end">@Model.Quantity</td><td class="text-end">₹@Model.UnitPrice.ToString("N2")</td><td class="text-end">₹@Model.TotalAmount.ToString("N2")</td></tr></tbody><tfoot><tr><th colspan="3" class="text-end">Grand total</th><th class="text-end">₹@Model.TotalAmount.ToString("N2")</th></tr></tfoot></table></div></div>
