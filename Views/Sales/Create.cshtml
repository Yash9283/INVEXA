@model StockFlow.Models.SaleCreateViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Checkout";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Smart checkout</h2>
    </div><a asp-action="Index" class="btn btn-outline-secondary">Sales history</a>
</div>
<div class="card shadow-sm border-0" style="max-width:820px">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="ProductId" class="form-label">Product / SKU</label>
                    <select asp-for="ProductId" asp-items="@(ViewBag.Products)" class="form-select" id="product-select">
                        <option value="">Select a product</option>
                    </select><span asp-validation-for="ProductId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Available stock</label><input id="available-stock" class="form-control" value="Select a product" readonly/>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerName" class="form-label">Customer name</label><input asp-for="CustomerName" class="form-control" placeholder="Walk-in customer"/><span asp-validation-for="CustomerName" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CustomerPhone" class="form-label">Phone</label><input asp-for="CustomerPhone" class="form-control"/>
                </div>
                <div class="col-md-3">
                    <label asp-for="CustomerEmail" class="form-label">Email</label><input asp-for="CustomerEmail" class="form-control"/>
                </div>
                <div class="col-md-4">
                    <label asp-for="Quantity" class="form-label">Quantity</label><input asp-for="Quantity" type="number" min="1" class="form-control" id="sale-quantity"/><span asp-validation-for="Quantity" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Unit price</label><input id="unit-price" class="form-control" value="—" readonly/>
                </div>
                <div class="col-md-4">
                    <label asp-for="PaymentStatus" class="form-label">Payment</label>
                    <select asp-for="PaymentStatus" class="form-select">
                        <option value="Paid">Paid</option><option value="Pending">Pending</option>
                    </select>
                </div>
            </div>
            <div class="alert alert-info mt-4 mb-0"><i class="bi bi-shield-check me-1"></i> Price and total are calculated on the server. Overselling is blocked.</div><button class="btn btn-primary mt-4">Complete sale &amp; generate invoice</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial"/><script>const select = document.getElementById('product-select'), available = document.getElementById('available-stock'), price = document.getElementById('unit-price'); select.addEventListener('change', async () => { if (!select.value) { available.value = 'Select a product'; price.value = '—'; return; } const r = await fetch('@Url.Action("ProductInfo")?id=' + select.value); if (!r.ok) return; const p = await r.json(); available.value = p.quantity + ' available · ' + p.sku; price.value = '₹' + Number(p.price).toFixed(2); document.getElementById('sale-quantity').max = p.quantity; });</script> }
