@model List<StockFlow.Models.Sale>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sales";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Sales</h2>
        <p class="text-muted mb-0">
            Completed sales are immutable; voiding a sale returns stock through the ledger.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        New checkout
    </a>
</div>

<div class="d-flex gap-2 mb-3">
    <a asp-controller="Export" asp-action="SalesExcel"
       class="btn btn-sm btn-outline-success">
        <i class="bi bi-file-earmark-excel me-1"></i>Excel
    </a>
    <a asp-controller="Export" asp-action="SalesPdf"
       class="btn btn-sm btn-outline-danger">
        <i class="bi bi-file-earmark-pdf me-1"></i>PDF
    </a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">
        @success
    </div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Product</th>
                    <th>Customer</th>
                    <th>Qty</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var sale in Model)
                {
                    <tr>
                        <td>
                            @sale.SaleDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </td>

                        <td>
                            @sale.ProductName
                        </td>

                        <td>
                            @sale.CustomerName
                        </td>

                        <td>
                            @sale.Quantity
                        </td>

                        <td>
                            ₹@sale.TotalAmount.ToString("N2")
                        </td>

                        <td>
                            <span class="badge @(sale.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                @sale.Status
                            </span>
                        </td>

                        <td class="text-end">
                            @if (sale.Invoice is not null)
                            {
                                <a asp-controller="Invoice"
                                   asp-action="Details"
                                   asp-route-id="@sale.Invoice.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Invoice
                                </a>
                            }

                            @if(sale.Status == "Completed" && Context.Session.GetString("Role") == "Admin")
                            {
                                <form asp-action="Void" asp-route-id="@sale.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Void this sale and return its stock?')">Void</button>
                                </form>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No sales yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>