@model StockFlow.Models.ReportViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Reports & Insights"; }
<div class="mb-4"><h2 class="mb-1">Reports &amp; insights</h2><p class="text-muted mb-0">Actionable inventory intelligence based on your real sales and stock ledger.</p></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card shadow-sm border-0 h-100"><div class="card-body"><div class="text-muted small">30-day revenue</div><div class="fs-3 fw-bold">₹@Model.RevenueLast30Days.ToString("N2")</div></div></div></div><div class="col-md-4"><div class="card shadow-sm border-0 h-100"><div class="card-body"><div class="text-muted small">30-day gross profit</div><div class="fs-3 fw-bold text-success">₹@Model.GrossProfitLast30Days.ToString("N2")</div></div></div></div><div class="col-md-4"><div class="card shadow-sm border-0 h-100"><div class="card-body"><div class="text-muted small">Inventory value (cost)</div><div class="fs-3 fw-bold">₹@Model.InventoryValue.ToString("N2")</div></div></div></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="card shadow-sm border-0 h-100"><div class="card-header bg-transparent"><strong>Reorder recommendations</strong><span class="text-muted ms-2">Lead-time demand + safety stock</span></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Product</th><th>Available</th><th>Avg/day</th><th>Recommended</th><th></th></tr></thead><tbody>@foreach(var s in Model.ReorderSuggestions){<tr><td><div class="fw-semibold">@s.Product.ProductName</div><small class="text-muted">@s.Reason</small></td><td>@s.Product.Quantity</td><td>@s.AverageDailySales</td><td>@s.SuggestedQuantity</td><td><a asp-controller="PurchaseOrder" asp-action="Create" asp-route-productId="@s.Product.Id" asp-route-quantity="@s.SuggestedQuantity" class="btn btn-sm btn-outline-primary">Create PO</a></td></tr>}@if(!Model.ReorderSuggestions.Any()){<tr><td colspan="5" class="text-center text-success py-4">No reorders needed right now.</td></tr>}</tbody></table></div></div></div><div class="col-lg-5"><div class="card shadow-sm border-0 h-100"><div class="card-header bg-transparent"><strong>Dead-stock watch</strong><span class="text-muted ms-2">No sale in 30 days</span></div><ul class="list-group list-group-flush">@foreach(var p in Model.DeadStockProducts.Take(10)){<li class="list-group-item d-flex justify-content-between align-items-center"><span>@p.ProductName</span><span class="badge bg-secondary">@p.Quantity units</span></li>}@if(!Model.DeadStockProducts.Any()){<li class="list-group-item text-success">No dead stock found.</li>}</ul></div></div></div>
<div class="card shadow-sm border-0 mt-4"><div class="card-header bg-transparent"><strong>Recent completed sales</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Date</th><th>Product</th><th>Qty</th><th>Total</th></tr></thead><tbody>@foreach(var sale in Model.RecentSales){<tr><td>@sale.SaleDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>@sale.ProductName</td><td>@sale.Quantity</td><td>₹@sale.TotalAmount.ToString("N2")</td></tr>}@if(!Model.RecentSales.Any()){<tr><td colspan="4" class="text-center text-muted py-4">No sales in the last 30 days.</td></tr>}</tbody></table></div></div>
