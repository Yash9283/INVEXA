@model StockFlow.Models.Product

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Product";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Edit product</h2>
        <p class="text-muted mb-0">
            Stock is changed only through the auditable ledger.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="ProductName" class="form-label"></label>
                    <input asp-for="ProductName" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="SKU" class="form-label"></label>
                    <input asp-for="SKU" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Category</label>
                    <select asp-for="CategoryId"
                            asp-items="@(ViewBag.Categories)"
                            class="form-select"
                            required>
                        <option value="">-- Select category --</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Supplier</label>
                    <select asp-for="SupplierId"
                            asp-items="@(ViewBag.Suppliers)"
                            class="form-select"
                            required>
                        <option value="">-- Select supplier --</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="CostPrice" class="form-label">
                        Cost price (₹)
                    </label>
                    <input asp-for="CostPrice"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="Price" class="form-label">
                        Selling price (₹)
                    </label>
                    <input asp-for="Price"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Current stock</label>

                    <input value="@Model.Quantity"
                           class="form-control"
                           disabled />

                    <a asp-controller="Stock"
                       asp-action="Adjust"
                       asp-route-productId="@Model.Id"
                       class="small">
                        Adjust through ledger
                    </a>
                </div>

                <div class="col-md-4">
                    <label asp-for="ReorderLevel" class="form-label">
                        Reorder level
                    </label>
                    <input asp-for="ReorderLevel"
                           type="number"
                           min="0"
                           class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="ReorderQuantity" class="form-label">
                        Suggested reorder qty
                    </label>
                    <input asp-for="ReorderQuantity"
                           type="number"
                           min="1"
                           class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="LeadTimeDays" class="form-label">
                        Supplier lead time (days)
                    </label>
                    <input asp-for="LeadTimeDays"
                           type="number"
                           min="0"
                           class="form-control" />
                </div>

            </div>

            <button class="btn btn-primary mt-4">
                Save changes
            </button>

        </form>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}