@model List<StockFlow.Models.Product>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Products"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h2 class="mb-1">Products</h2><p class="text-muted mb-0">Active products and their live inventory</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add product</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
<thead><tr><th>Product</th><th>SKU</th><th>Category</th><th>Supplier</th><th>Sell price</th><th>In stock</th><th></th></tr></thead>
<tbody>@foreach (var item in Model) { <tr>
<td class="fw-semibold">@item.ProductName</td><td><code>@item.SKU</code></td><td>@(item.Category?.CategoryName ?? item.CategoryName ?? "—")</td><td>@(item.Supplier?.SupplierName ?? "—")</td><td>₹@item.Price.ToString("N2")</td>
<td><span class="badge @(item.Quantity <= item.ReorderLevel ? "bg-danger" : "bg-success")">@item.Quantity</span><small class="text-muted ms-1">reorder @item.ReorderLevel</small></td>
<td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-controller="Stock" asp-action="Adjust" asp-route-productId="@item.Id" class="btn btn-sm btn-outline-secondary">Adjust</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Archive</a></td>
</tr> } @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No active products yet.</td></tr> }</tbody></table></div></div>
