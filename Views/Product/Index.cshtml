@model List<StockFlow.Models.Product>
@using Microsoft.AspNetCore.Http
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Products";
    var isAdmin = Context.Session.GetString("Role") == "Admin";
    var totalValue = Model.Sum(p => p.CostPrice * p.Quantity);
    var inStock = Model.Count(p => p.Quantity > 20);
    var lowStock = Model.Count(p => p.Quantity is > 0 and <= 20);
    var outOfStock = Model.Count(p => p.Quantity == 0);
}

<div class="products-page-wrapper" style="background: url('/images/products-bg.jpg') no-repeat center center fixed !important; background-size: cover !important;">
<div class="products-page">
    <div class="products-topbar">
        <div>
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px;">
                <i class="bi bi-box-seam" style="color:#a78bfa;font-size:28px;"></i>
                <h1 class="products-title">Products</h1>
            </div>
            <p style="color:#ffffff;font-size:14px;margin:0;font-weight:600;text-shadow:0 2px 6px rgba(0,0,0,0.8);">@Model.Count products · Inventory management</p>
        </div>
        @if (isAdmin) { <a asp-action="Create" class="btn btn-primary product-add"><i class="bi bi-plus-lg"></i> Add product</a> }
    </div>

    <div class="product-summary">
        <div class="summary-card"><span class="summary-icon purple"><i class="bi bi-box-seam"></i></span><div><span>Total products</span><strong>@Model.Count</strong></div></div>
        <div class="summary-card"><span class="summary-icon green"><i class="bi bi-check2-circle"></i></span><div><span>In stock</span><strong>@inStock</strong></div></div>
        <div class="summary-card"><span class="summary-icon amber"><i class="bi bi-exclamation-circle"></i></span><div><span>Low stock</span><strong>@lowStock</strong></div></div>
        <div class="summary-card"><span class="summary-icon red"><i class="bi bi-x-circle"></i></span><div><span>Out of stock</span><strong>@outOfStock</strong></div></div>
        <div class="summary-card value"><span class="summary-icon blue"><i class="bi bi-graph-up-arrow"></i></span><div><span>Inventory value</span><strong>&#8377;@totalValue.ToString("N0")</strong></div></div>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success product-alert"><i class="bi bi-check-circle me-2"></i>@success</div> }

    <section class="product-table-card">
        <div class="product-table-toolbar">
            <div class="product-search-wrap">
                <i class="bi bi-search"></i><input id="productSearch" type="search" placeholder="Search products, SKU, category or supplier…" autocomplete="off" />
                <div id="productSearchResults" class="product-search-results"></div>
            </div>
            <div class="toolbar-actions">
                <a asp-controller="Export" asp-action="ProductsExcel" class="icon-toolbar excel-icon" title="Export Excel"><i class="bi bi-file-earmark-excel"></i></a>
                <a asp-controller="Export" asp-action="ProductsPdf" class="icon-toolbar pdf-icon" title="Export PDF"><i class="bi bi-file-earmark-pdf"></i></a>
            </div>
        </div>

        <div class="table-responsive"><table class="table product-table align-middle mb-0">
            <thead><tr><th>Product</th><th>SKU</th><th>Category</th><th>Supplier</th><th>Price</th><th>Availability</th><th class="text-end">Actions</th></tr></thead>
            <tbody id="productTableBody">
            @foreach (var item in Model)
            {
                var image = string.IsNullOrWhiteSpace(item.ImageUrl) ? Url.Content("~/Images/product-placeholder.svg") : item.ImageUrl;
                var availability = item.Quantity == 0 ? "Out of Stock" : item.Quantity <= 20 ? "Low Stock" : "In Stock";
                var availabilityClass = item.Quantity == 0 ? "out" : item.Quantity <= 20 ? "low" : "in";
                var capacity = Math.Max(20, item.ReorderLevel * 2);
                var stockPercent = Math.Min(100, (int)Math.Round(item.Quantity * 100.0 / capacity));
                var health = stockPercent >= 70 ? "Healthy" : stockPercent >= 30 ? "Running Low" : "Critical";
                var category = item.Category?.CategoryName ?? item.CategoryName ?? "Uncategorized";
                var supplier = item.Supplier?.SupplierName ?? "No supplier";
                <tr class="product-row" tabindex="0"
                    data-search="@($"{item.ProductName} {item.SKU} {category} {supplier}".ToLowerInvariant())"
                    data-name="@item.ProductName" data-sku="@item.SKU" data-category="@category" data-supplier="@supplier"
                    data-image="@image" data-cost="@item.CostPrice.ToString("N2")" data-price="@item.Price.ToString("N2")"
                    data-quantity="@item.Quantity" data-status="@availability" data-status-class="@availabilityClass"
                    data-created="@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")" data-updated="@item.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")">
                    <td><div class="product-name-cell"><button type="button" class="product-thumbnail product-action" aria-label="Preview @item.ProductName"><img src="@image" alt="" /></button><div><strong>@item.ProductName</strong><span class="product-health @availabilityClass"><i class="bi bi-heart-pulse"></i> @health · @stockPercent%</span></div></div>
                        <div class="product-hover-card"><img src="@image" alt="" /><div><strong>@item.ProductName</strong><span>@item.SKU</span><dl><dt>Category</dt><dd>@category</dd><dt>Supplier</dt><dd>@supplier</dd><dt>Price</dt><dd>&#8377;@item.Price.ToString("N2")</dd><dt>Available</dt><dd>@item.Quantity · @availability</dd></dl></div></div></td>
                    <td><code>@item.SKU</code></td><td>@category</td><td>@supplier</td><td><strong>&#8377;@item.Price.ToString("N2")</strong><small>Cost &#8377;@item.CostPrice.ToString("N2")</small></td>
                    <td><div class="stock-cell"><div><strong>@item.Quantity</strong><span class="stock-badge @availabilityClass"><i class="bi bi-circle-fill"></i> @availability</span></div><div class="stock-progress"><span class="@availabilityClass" style="width:@stockPercent%"></span></div><small>@stockPercent% inventory level</small></div></td>
                    <td class="text-end"><div class="product-actions">
                        <button type="button" class="action-button view-product product-action" title="View details"><i class="bi bi-eye"></i></button>
                        @if (isAdmin) { <a asp-action="Edit" asp-route-id="@item.Id" class="action-button product-action" title="Edit product"><i class="bi bi-pencil"></i></a><a asp-controller="Stock" asp-action="Adjust" asp-route-productId="@item.Id" class="action-button product-action" title="Adjust stock"><i class="bi bi-boxes"></i></a><a asp-action="Delete" asp-route-id="@item.Id" class="action-button danger product-action" title="Archive product"><i class="bi bi-archive"></i></a> }
                    </div></td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="7" class="empty-products"><i class="bi bi-box-seam"></i><strong>No active products yet</strong><span>Add your first product to start tracking inventory.</span></td></tr> }
            <tr id="productNoResults" style="display:none"><td colspan="7" class="empty-products"><i class="bi bi-search"></i><strong>No products found</strong><span>Try a different name, SKU, category or supplier.</span></td></tr>
            </tbody>
        </table></div>
    </section>
</div>
</div>

<div class="modal fade" id="productDetailsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content product-details-modal"><div class="modal-header"><h5 class="modal-title">Product details</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="product-detail-hero"><img id="detailImage" src="" alt="" /><div><span id="detailStatus" class="stock-badge"></span><h2 id="detailName"></h2><code id="detailSku"></code><p id="detailCategorySupplier"></p></div></div><div class="product-detail-grid"><div><span>Purchase price</span><strong id="detailCost"></strong></div><div><span>Selling price</span><strong id="detailPrice"></strong></div><div><span>Available stock</span><strong id="detailQuantity"></strong></div><div><span>Created</span><strong id="detailCreated"></strong></div><div><span>Last updated</span><strong id="detailUpdated"></strong></div></div></div></div></div></div>

<style>
.products-page-wrapper {
    position: relative !important;
    min-height: 100vh !important;
    margin: -22px -26px !important;
    padding: 30px !important;
    background: url('/images/products-bg.jpg') no-repeat center center fixed !important;
    background-size: cover !important;
}

.products-page-wrapper::before {
    content: '';
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.55);
    z-index: 0;
    pointer-events: none;
}

.products-page-wrapper > * {
    position: relative;
    z-index: 1;
}


/* Force transparent table */
.products-page-wrapper .product-table-card {
    background: transparent !important;
    border: 2px solid rgba(99, 102, 241, 0.6) !important;
    box-shadow: 0 0 25px rgba(99, 102, 241, 0.4) !important;
}

.products-page-wrapper .product-table {
    background: transparent !important;
}

.products-page-wrapper .product-table thead th {
    background: rgba(99, 102, 241, 0.25) !important;
    color: #ffffff !important;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8) !important;
}

.products-page-wrapper .product-table tbody td {
    background: transparent !important;
    color: #ffffff !important;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8) !important;
}

.products-page-wrapper .product-row {
    background: rgba(128, 128, 128, 0.25) !important;
    backdrop-filter: blur(12px) !important;
}

.products-page-wrapper .product-row:hover {
    background: rgba(128, 128, 128, 0.35) !important;
}

.products-page-wrapper .summary-card {
    background: rgba(23, 34, 54, 0.55) !important;
    backdrop-filter: blur(12px) !important;
}

.products-page-wrapper .summary-card:nth-child(1) {
    background: rgba(30, 30, 50, 0.6) !important;
    border: 2px solid rgba(139, 92, 246, 0.8) !important;
}

.products-page-wrapper .summary-card:nth-child(2) {
    background: rgba(20, 40, 30, 0.6) !important;
    border: 2px solid rgba(34, 197, 94, 0.8) !important;
}

.products-page-wrapper .summary-card:nth-child(3) {
    background: rgba(45, 40, 25, 0.6) !important;
    border: 2px solid rgba(245, 158, 11, 0.8) !important;
}

.products-page-wrapper .summary-card:nth-child(4) {
    background: rgba(45, 25, 30, 0.6) !important;
    border: 2px solid rgba(239, 68, 68, 0.8) !important;
}

.products-page-wrapper .summary-card:nth-child(5) {
    background: rgba(25, 35, 50, 0.6) !important;
    border: 2px solid rgba(59, 130, 246, 0.8) !important;
}

.products-page-wrapper .summary-card span:not(.summary-icon) {
    color: #ffffff !important;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6) !important;
    font-weight: 700 !important;
    font-size: 13px !important;
}

.products-page-wrapper .summary-card strong {
    color: #ffffff !important;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.7) !important;
    font-weight: 900 !important;
    font-size: 26px !important;
}

.products-page-wrapper .summary-icon {
    color: #ffffff !important;
    filter: brightness(1.2) !important;
}

.products-page-wrapper .summary-icon i {
    color: #ffffff !important;
}

.products-page-wrapper .product-table-toolbar {
    background: transparent !important;
}

.products-page-wrapper .product-search-wrap input {
    background: rgba(16, 26, 44, 0.6) !important;
    backdrop-filter: blur(10px) !important;
}

.products-page-wrapper .product-hover-card {
    display: none !important;
}

.products-page{color:#e7edf8}.products-topbar{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:22px}.products-topbar h1{font-size:28px;font-weight:800;margin:3px 0}.products-topbar p{color:#94a3b8;margin:0}.eyebrow{font-size:10px;color:#a78bfa;font-weight:800;letter-spacing:1.6px}.products-title{display:inline-block;background:transparent !important;color:#fff !important;padding:0 !important;border-radius:0 !important;font-size:32px !important;font-weight:800 !important;margin:0 !important;box-shadow:none !important}.product-add{border:0;border-radius:11px;padding:10px 15px;font-weight:700;background:linear-gradient(135deg,#7c3aed,#5b21b6)}
.product-summary{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-bottom:18px}.summary-card{min-height:85px;padding:15px;display:flex;align-items:center;gap:11px;background:#172236;border:3px solid rgba(255,255,255,.3) !important;border-radius:18px !important;transition:all 0.3s ease !important;box-shadow:0 6px 16px rgba(0,0,0,0.4) !important}.summary-card:hover{transform:translateY(-5px) !important;box-shadow:0 12px 28px rgba(0,0,0,0.5) !important;border-color:rgba(255,255,255,.5) !important}.summary-card span:not(.summary-icon){display:block;color:#91a0b7;font-size:12px !important;font-weight:700 !important;text-transform:uppercase !important;letter-spacing:0.5px !important}.summary-card strong{display:block;color:#fff;font-size:28px !important;line-height:1.25;font-weight:900 !important}.summary-icon{width:48px !important;height:48px !important;border-radius:14px !important;display:grid;place-items:center;font-size:22px !important;box-shadow:0 6px 16px rgba(0,0,0,0.4) !important}.purple{background:rgba(124,58,237,.2);color:#a78bfa}.green{background:rgba(34,197,94,.16);color:#4ade80}.amber{background:rgba(245,158,11,.17);color:#fbbf24}.red{background:rgba(239,68,68,.16);color:#fb7185}.blue{background:rgba(59,130,246,.16);color:#60a5fa}.product-alert{border:0;border-radius:12px}.product-table-card{background:#172236;border:1px solid rgba(255,255,255,.07);border-radius:16px;overflow:visible}.product-table-toolbar{padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;gap:12px;justify-content:space-between}.product-search-wrap{position:relative;max-width:470px;flex:1}.product-search-wrap>i{position:absolute;left:13px;top:11px;color:#7f8da5}.product-search-wrap input{width:100%;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:#101a2c;color:#fff;padding:10px 13px 10px 37px;outline:none}.product-search-wrap input:focus{border-color:#8b5cf6;box-shadow:0 0 0 3px rgba(124,58,237,.16)}.product-search-results{display:none;position:absolute;z-index:30;top:calc(100% + 7px);left:0;right:0;background:#111b2d;border:1px solid rgba(255,255,255,.1);border-radius:12px;box-shadow:0 16px 38px rgba(0,0,0,.35);overflow:hidden}.search-result{display:flex;align-items:center;gap:10px;padding:10px 12px;cursor:pointer}.search-result:hover{background:rgba(124,58,237,.12)}.search-result img{width:38px;height:38px;object-fit:cover;border-radius:9px}.search-result strong,.search-result small{display:block}.search-result small{color:#94a3b8;font-size:11px}.toolbar-actions{display:flex;gap:7px}.icon-toolbar,.action-button{display:inline-grid;place-items:center;width:35px;height:35px;border-radius:9px;border:1px solid rgba(255,255,255,.11);background:#202d43;color:#cdd6e5;text-decoration:none;transition:.2s}.icon-toolbar:hover,.action-button:hover{color:#fff;background:#7c3aed;border-color:#8b5cf6;transform:translateY(-1px)}.icon-toolbar.excel-icon{background:#10b981 !important;color:#fff !important;border-color:#059669 !important}.icon-toolbar.excel-icon:hover{background:#059669 !important;box-shadow:0 4px 12px rgba(16, 185, 129, 0.4) !important}.icon-toolbar.pdf-icon{background:#ef4444 !important;color:#fff !important;border-color:#dc2626 !important}.icon-toolbar.pdf-icon:hover{background:#dc2626 !important;box-shadow:0 4px 12px rgba(239, 68, 68, 0.4) !important}.product-table{color:#dbe4f0}.product-table thead th{color:#8191aa;background:rgba(15,23,42,.36);border-color:rgba(255,255,255,.06);font-size:10px;text-transform:uppercase;letter-spacing:.7px;padding:13px 16px}.product-table tbody td{border-color:rgba(255,255,255,.055);padding:13px 16px;position:relative}.product-row{cursor:pointer;transition:background .18s}.product-row:hover{background:rgba(124,58,237,.075)}.product-name-cell{display:flex;align-items:center;gap:10px}.product-thumbnail{padding:0;border:0;background:none;width:50px;height:50px;border-radius:12px;overflow:hidden;flex:0 0 50px}.product-thumbnail img{width:100%;height:100%;object-fit:cover}.product-name-cell strong{display:block;color:#fff}.product-health{display:block;margin-top:3px;font-size:10px}.product-health.in{color:#4ade80}.product-health.low{color:#fbbf24}.product-health.out{color:#fb7185}.product-table code{color:#c4b5fd;font-size:12px}.product-table td>small{display:block;color:#8191aa;font-size:10px;margin-top:3px}.stock-cell{min-width:140px}.stock-cell>div:first-child{display:flex;align-items:center;gap:7px}.stock-badge{font-size:10px;padding:4px 7px;border-radius:999px;font-weight:700;white-space:nowrap}.stock-badge i{font-size:7px}.stock-badge.in{background:rgba(34,197,94,.13);color:#4ade80}.stock-badge.low{background:rgba(245,158,11,.15);color:#fbbf24}.stock-badge.out{background:rgba(239,68,68,.14);color:#fb7185}.stock-progress{height:5px;background:rgba(255,255,255,.09);border-radius:999px;overflow:hidden;margin:7px 0 3px}.stock-progress span{height:100%;display:block;border-radius:inherit}.stock-progress span.in{background:linear-gradient(90deg,#22c55e,#86efac)}.stock-progress span.low{background:linear-gradient(90deg,#f59e0b,#fcd34d)}.stock-progress span.out{background:#ef4444}.stock-cell small{font-size:10px;color:#8191aa}.product-actions{display:flex;justify-content:flex-end;gap:6px}.action-button{width:31px;height:31px;font-size:13px}.action-button.danger:hover{background:#dc2626;border-color:#ef4444}.product-hover-card{display:none;position:absolute;z-index:25;left:14px;top:68px;width:285px;padding:12px;background:#101a2c;border:1px solid rgba(167,139,250,.35);border-radius:14px;box-shadow:0 18px 40px rgba(0,0,0,.45);gap:11px}.product-row:hover .product-hover-card{display:flex}.product-hover-card img{width:68px;height:68px;border-radius:10px;object-fit:cover}.product-hover-card strong,.product-hover-card span{display:block}.product-hover-card span{font-size:11px;color:#94a3b8}.product-hover-card dl{display:grid;grid-template-columns:auto 1fr;gap:3px 12px;margin:8px 0 0;font-size:10px}.product-hover-card dt{color:#718198}.product-hover-card dd{margin:0;color:#dbe4f0;text-align:right}.empty-products{text-align:center!important;padding:45px!important;color:#94a3b8}.empty-products i,.empty-products strong,.empty-products span{display:block}.empty-products i{font-size:27px;color:#8b5cf6;margin-bottom:8px}.empty-products strong{color:#e2e8f0}.empty-products span{font-size:12px;margin-top:4px}.product-details-modal{background:#131e31;color:#e5edf8;border:1px solid rgba(255,255,255,.1);border-radius:17px}.product-details-modal .modal-header{border-color:rgba(255,255,255,.08)}.product-detail-hero{display:flex;align-items:center;gap:18px;padding:8px 0 22px}.product-detail-hero img{width:140px;height:140px;object-fit:cover;border-radius:16px}.product-detail-hero h2{font-size:26px;margin:10px 0 4px}.product-detail-hero p{color:#94a3b8;margin:8px 0}.product-detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.product-detail-grid div{padding:12px;background:#0e1727;border-radius:11px}.product-detail-grid span{display:block;color:#8290a7;font-size:11px}.product-detail-grid strong{display:block;margin-top:4px;color:#fff}
@@media(max-width:1199px){.product-summary{grid-template-columns:repeat(3,1fr)}}@@media(max-width:767px){.products-topbar{flex-direction:column}.product-summary{grid-template-columns:repeat(2,1fr)}.summary-card.value{grid-column:span 2}.product-table-toolbar{align-items:stretch}.product-search-wrap{max-width:none}.product-table th:nth-child(3),.product-table td:nth-child(3),.product-table th:nth-child(4),.product-table td:nth-child(4){display:none}.product-hover-card{display:none!important}.product-detail-grid{grid-template-columns:repeat(2,1fr)}}@@media(max-width:480px){.product-summary{gap:8px}.summary-card{padding:11px}.summary-icon{width:32px;height:32px}.product-table th:nth-child(2),.product-table td:nth-child(2),.product-table th:nth-child(5),.product-table td:nth-child(5){display:none}.product-detail-hero img{width:90px;height:90px}.product-detail-hero h2{font-size:20px}}
</style>

@section Scripts {
<script>
(() => {
 const input=document.getElementById('productSearch'), body=document.getElementById('productTableBody'), noResults=document.getElementById('productNoResults'), results=document.getElementById('productSearchResults'), rows=[...document.querySelectorAll('.product-row')];
 const esc=s=>String(s||'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
 function openDetails(row){document.getElementById('detailImage').src=row.dataset.image;document.getElementById('detailName').textContent=row.dataset.name;document.getElementById('detailSku').textContent=row.dataset.sku;document.getElementById('detailCategorySupplier').textContent=`${row.dataset.category} · ${row.dataset.supplier}`;document.getElementById('detailCost').textContent=`₹${row.dataset.cost}`;document.getElementById('detailPrice').textContent=`₹${row.dataset.price}`;document.getElementById('detailQuantity').textContent=`${row.dataset.quantity} · ${row.dataset.status}`;document.getElementById('detailCreated').textContent=row.dataset.created;document.getElementById('detailUpdated').textContent=row.dataset.updated;const badge=document.getElementById('detailStatus');badge.className=`stock-badge ${row.dataset.statusClass}`;badge.innerHTML=`<i class="bi bi-circle-fill"></i> ${esc(row.dataset.status)}`;bootstrap.Modal.getOrCreateInstance(document.getElementById('productDetailsModal')).show();}
 function filter(){const term=input.value.trim().toLowerCase();let matches=rows.filter(r=>r.dataset.search.includes(term));rows.forEach(r=>r.style.display=matches.includes(r)?'':'none');noResults.style.display=term&&!matches.length?'':'none';if(!term){results.style.display='none';return;}results.innerHTML=matches.slice(0,5).map((r,i)=>`<div class="search-result" data-index="${rows.indexOf(r)}"><img src="${esc(r.dataset.image)}" alt=""><div><strong>${esc(r.dataset.name)}</strong><small>SKU: ${esc(r.dataset.sku)} · <span class="stock-badge ${esc(r.dataset.statusClass)}">${esc(r.dataset.status)}</span></small></div></div>`).join('') || '<div class="search-result text-muted">No products found</div>';results.style.display='block';}
 input.addEventListener('input',filter);document.addEventListener('click',e=>{if(!e.target.closest('.product-search-wrap'))results.style.display='none';});results.addEventListener('click',e=>{const item=e.target.closest('[data-index]');if(item)openDetails(rows[+item.dataset.index]);});
 rows.forEach(row=>{row.addEventListener('click',e=>{if(!e.target.closest('.product-action'))openDetails(row);});row.addEventListener('keydown',e=>{if(e.key==='Enter')openDetails(row);});row.querySelector('.view-product')?.addEventListener('click',()=>openDetails(row));row.querySelector('.product-thumbnail')?.addEventListener('click',()=>openDetails(row));});
 document.querySelectorAll('[title]').forEach(el=>new bootstrap.Tooltip(el));
})();
</script>
}
