@model List<StockFlow.Models.Product>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Products</h2>
        <p class="text-muted mb-0">
            Active products and their live inventory
        </p>
    </div>

    @if (Context.Session.GetString("Role") == "Admin")
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add product
        </a>
    }
</div>

<div class="d-flex gap-2 mb-3">
    <a asp-controller="Export" asp-action="ProductsExcel"
       class="btn btn-sm btn-outline-success">
        <i class="bi bi-file-earmark-excel me-1"></i>Excel
    </a>
    <a asp-controller="Export" asp-action="ProductsPdf"
       class="btn btn-sm btn-outline-danger">
        <i class="bi bi-file-earmark-pdf me-1"></i>PDF
    </a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">
        @success
    </div>
}

<!-- Per-page search -->
<div class="mb-3" style="max-width:380px;">
    <div class="input-group">
        <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text" id="productSearch" class="form-control border-start-0"
               placeholder="Search products..." autocomplete="off" />
    </div>
</div>


<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th>Sell price</th>
                    <th>In stock</th>
                    <th></th>
                </tr>
            </thead>

            <tbody id="productTableBody">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            @item.ProductName
                        </td>

                        <td>
                            <code>@item.SKU</code>
                        </td>

                        <td>
                            @(item.Category?.CategoryName ?? item.CategoryName ?? "—")
                        </td>

                        <td>
                            @(item.Supplier?.SupplierName ?? "—")
                        </td>

                        <td>
                            ₹@item.Price.ToString("N2")
                        </td>

                        <td>
                            <span class="badge @(item.Quantity <= item.ReorderLevel ? "bg-danger" : "bg-success")">
                                @item.Quantity
                            </span>
                            <small class="text-muted ms-1">
                                reorder @item.ReorderLevel
                            </small>
                        </td>

                        <td class="text-end">
                            @if (Context.Session.GetString("Role") == "Admin")
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-controller="Stock" asp-action="Adjust" asp-route-productId="@item.Id" class="btn btn-sm btn-outline-secondary">Adjust</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Archive</a>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No active products yet.
                        </td>
                    </tr>
                }
                <tr id="productNoResults" style="display:none;">
                    <td colspan="7" class="text-center text-muted py-4">
                        No products match your search.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
(function () {
    function norm(s) { return (s || '').toLowerCase().replace(/\s+/g, ''); }

    var input = document.getElementById('productSearch');
    var tbody = document.getElementById('productTableBody');
    var noRes = document.getElementById('productNoResults');

    input.addEventListener('input', function () {
        var term  = norm(this.value);
        var rows  = tbody.querySelectorAll('tr:not(#productNoResults)');
        var shown = 0;
        rows.forEach(function (row) {
            // col 0=ProductName, 1=SKU, 2=Category, 3=Supplier
            var text = norm(
                (row.cells[0]?.textContent || '') + ' ' +
                (row.cells[1]?.textContent || '') + ' ' +
                (row.cells[2]?.textContent || '') + ' ' +
                (row.cells[3]?.textContent || '')
            );
            var match = !term || text.includes(term);
            row.style.display = match ? '' : 'none';
            if (match) shown++;
        });
        noRes.style.display = shown === 0 && term ? '' : 'none';
    });
})();
</script>
}
