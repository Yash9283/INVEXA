@model List<StockFlow.Models.PurchaseOrder>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Purchase Orders"; var suggestions = ViewBag.Suggestions as List<StockFlow.Models.ReorderSuggestion> ?? new(); }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Purchase orders</h2><p class="text-muted mb-0">Receive goods to add stock and preserve a supplier-linked audit trail.</p></div><a asp-action="Create" class="btn btn-primary">New purchase order</a></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
@if(suggestions.Any()){<div class="card border-warning mb-4"><div class="card-body"><div class="d-flex align-items-center justify-content-between mb-2"><h5 class="mb-0"><i class="bi bi-lightbulb me-1"></i> Smart reorder recommendations</h5><a asp-controller="Report" asp-action="Index" class="small">View all insights</a></div><div class="row g-2">@foreach(var s in suggestions.Take(4)){<div class="col-md-3"><div class="border rounded p-3 h-100"><div class="fw-semibold">@s.Product.ProductName</div><div class="small text-muted">@s.Reason</div><div class="mt-2"><span class="badge bg-danger">@s.Product.Quantity left</span> <span class="small">Order @s.SuggestedQuantity</span></div><a asp-action="Create" asp-route-productId="@s.Product.Id" asp-route-quantity="@s.SuggestedQuantity" class="btn btn-sm btn-outline-primary mt-2">Create PO</a></div></div>}</div></div></div>}
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>PO no.</th><th>Supplier</th><th>Items</th><th>Created</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var po in Model){<tr><td class="fw-semibold">@po.PurchaseOrderNumber</td><td>@po.Supplier?.SupplierName</td><td>@string.Join(", ",po.Items.Select(i => $"{i.Product?.ProductName} × {i.OrderedQuantity}"))</td><td>@po.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge @(po.Status == "Received" ? "bg-success" : po.Status == "Sent" ? "bg-primary" : "bg-secondary")">@po.Status</span></td><td class="text-end">@if(po.Status == "Draft"){<form asp-action="MarkSent" asp-route-id="@po.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-primary">Mark sent</button></form>} @if(po.Status != "Received"){<form asp-action="Receive" asp-route-id="@po.Id" method="post" class="d-inline"><button class="btn btn-sm btn-success" onclick="return confirm('Receive all outstanding quantities?')">Receive goods</button></form>}</td></tr>}@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-4">No purchase orders yet.</td></tr>}</tbody></table></div></div>
