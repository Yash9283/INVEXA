@using Microsoft.AspNetCore.Http
@inject StockFlow.Data.ApplicationDbContext DbContext
@{
    Layout = null;
    var sessionRole = Context.Session.GetString("Role");
    var uname = Context.Session.GetString("Username") ?? "Admin";
    var adminId = Context.Session.GetInt32("AdminId");
    var currentUser = adminId.HasValue ? DbContext.Admins.Find(adminId.Value) : null;
    var profilePhoto = currentUser?.ProfilePhoto;
    var initials = string.IsNullOrWhiteSpace(uname) ? "AD" : string.Join("", uname.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
    var cc = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string act(string c) => string.Equals(cc, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - INVEXA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@600;700&family=Metal+Mania&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --sb: #111827;
            --sb2: #1a1a2b;
            --accent1: #818cf8;
            --accent2: #a78bfa;
            --content-dark: #0F172A;
            --panel-dark: #1a1a2b;
            --border-dark: rgba(255,255,255,.07);
            --content-light: #f3f4f8;
            --text-dark: #e7e7f0;
            --muted-dark: #8b8ba7;
        }

        * {
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            margin: 0;
            background: var(--content-light);
        }

            body.dark-mode {
                background: var(--content-dark);
            }

        .iv-app {
            display: flex;
            min-height: 100vh;
        }

        /* ===== SIDEBAR (dark always) ===== */
        .iv-sidebar {
            width: 250px;
            background: var(--sb);
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 20px 14px;
            overflow-y: auto;
            z-index: 1000;
            border-right: none;
            transition: width .25s ease, padding .25s ease;
        }

        .iv-brand {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 4px 8px 20px;
        }

        .iv-logo {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg,#818cf8,#a78bfa);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            box-shadow: 0 6px 16px rgba(167,139,250,.35);
        }

        .iv-brand h5 {
            color: #fff;
            font-family: 'Metal Mania', cursive;
            font-weight: 400;
            margin: 0;
            font-size: 28px;
            letter-spacing: 1.5px;
        }

        .iv-nav {
            list-style: none;
            padding: 0;
            margin: 6px 0;
            flex: 1;
        }

            .iv-nav .sec {
                color: #55556e;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1.5px;
                padding: 14px 12px 6px;
                text-transform: uppercase;
            }

            .iv-nav a {
                display: flex;
                align-items: center;
                gap: 12px;
                color: #a9a9c4;
                text-decoration: none;
                padding: 11px 13px;
                border-radius: 11px;
                margin: 3px 0;
                font-size: 14.5px;
                font-weight: 500;
                transition: .15s;
            }

                .iv-nav a i {
                    font-size: 17px;
                }

                .iv-nav a:hover {
                    background: rgba(255,255,255,.06);
                    color: #fff;
                }

                .iv-nav a.active {
                    background: linear-gradient(135deg,var(--accent1),var(--accent2));
                    color: #fff;
                    box-shadow: 0 6px 16px rgba(129,140,248,.3);
                }

        .iv-upgrade {
            background: linear-gradient(135deg,#818cf8,#a78bfa);
            border-radius: 16px;
            padding: 16px;
            text-align: center;
            margin: 10px 4px;
        }

            .iv-upgrade .crown {
                font-size: 22px;
                color: #fde047;
            }

            .iv-upgrade h6 {
                color: #fff;
                font-weight: 700;
                margin: 6px 0 3px;
                font-size: 14px;
            }

            .iv-upgrade p {
                color: rgba(255,255,255,.8);
                font-size: 11.5px;
                margin: 0 0 10px;
            }

            .iv-upgrade a {
                display: block;
                background: rgba(255,255,255,.16);
                color: #fff;
                text-decoration: none;
                padding: 8px;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 600;
            }

                .iv-upgrade a:hover {
                    background: rgba(255,255,255,.28);
                }

        .iv-user {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 12px 8px 4px;
            border-top: 1px solid rgba(255,255,255,.06);
            margin-top: 8px;
        }

            .iv-user .av {
                width: 40px;
                height: 40px;
                border-radius: 11px;
                background: linear-gradient(135deg,#818cf8,#a78bfa);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 15px;
                overflow: hidden;
            }

                .iv-user .av img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .iv-user .nm {
                color: #fff;
                font-weight: 600;
                font-size: 14px;
                line-height: 1.1;
            }

            .iv-user .rl {
                color: #8b8ba7;
                font-size: 12px;
            }

        /* ===== MAIN ===== */
        .iv-main {
            margin-left: 250px;
            flex: 1;
            min-height: 100vh;
            transition: margin-left .25s ease;
        }

        .iv-top {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px 26px;
            background: #0F172A;
            border-bottom: 1px solid rgba(255,255,255,.06);
            position: sticky;
            top: 0;
            z-index: 900;
            box-shadow: none;
        }

        .iv-collapse {
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            border-radius: 11px;
            border: 1px solid rgba(255,255,255,.26);
            background: rgba(255,255,255,.08);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 19px;
            cursor: pointer;
            transition: background .2s, transform .2s;
        }

        .iv-collapse:hover { background: rgba(255,255,255,.18); }

        /* Compact sidebar: keep icons available while freeing page width. */
        body.sidebar-collapsed .iv-sidebar { width: 76px; padding-left: 10px; padding-right: 10px; }
        body.sidebar-collapsed .iv-main { margin-left: 76px; }
        body.sidebar-collapsed .iv-brand { justify-content: center; padding-left: 0; padding-right: 0; }
        body.sidebar-collapsed .iv-brand h5,
        body.sidebar-collapsed .iv-nav .sec,
        body.sidebar-collapsed .iv-user > div:last-child { display: none; }
        body.sidebar-collapsed .iv-nav a { justify-content: center; gap: 0; padding: 12px; font-size: 0; }
        body.sidebar-collapsed .iv-nav a i { font-size: 19px; margin: 0; }
        body.sidebar-collapsed .iv-user { justify-content: center; padding-left: 0; padding-right: 0; }

        .iv-search {
            flex: 1;
            max-width: 460px;
            margin: 0 auto;
            position: relative;
        }

            .iv-search input {
                width: 100%;
                border: 1px solid #e5e7ef;
                background: #ffffff;
                border-radius: 12px;
                padding: 10px 14px 10px 40px;
                font-size: 14px;
                color: #333;
                outline: none;
            }

                .iv-search input::placeholder {
                    color: #9ca3af;
                }

            .iv-search .si {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #9ca3af;
            }

            .iv-search .kbd {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 11px;
                color: #6b7280;
                border: 1px solid #d1d5db;
                border-radius: 6px;
                padding: 1px 6px;
            }

        .iv-top-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .iv-datepill {
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 11px;
            padding: 8px 14px;
            font-size: 13px;
            color: #fff;
            font-weight: 500;
            white-space: nowrap;
        }

        .iv-iconbtn {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            border: 1px solid rgba(255,255,255,.35);
            background: rgba(255,255,255,.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            cursor: pointer;
            position: relative;
        }

            .iv-iconbtn:hover {
                background: rgba(255,255,255,.2);
            }

            .iv-iconbtn .bdot {
                position: absolute;
                top: 8px;
                right: 9px;
                width: 8px;
                height: 8px;
                background: #ef4444;
                border-radius: 50%;
            }

        .iv-topav {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            object-fit: cover;
        }

        .iv-content {
            padding: 22px 26px;
        }

        body.dark-mode .iv-content {
            background: var(--content-dark);
        }

        html, body { overflow-x: hidden; }
        .iv-sidebar { transition: transform .25s ease, width .25s ease; }
        .iv-backdrop { display: none; }

        @@media (max-width: 992px) {
            .iv-sidebar { transform: translateX(-100%); z-index: 1050; box-shadow: 0 0 40px rgba(0,0,0,.55); }
            body.sidebar-open .iv-sidebar { transform: translateX(0); }
            /* on mobile the toggle opens the FULL sidebar, not the 76px rail */
            body.sidebar-collapsed .iv-sidebar { width: 250px; padding: 20px 14px; }
            body.sidebar-collapsed .iv-brand h5,
            body.sidebar-collapsed .iv-nav .sec,
            body.sidebar-collapsed .iv-user > div:last-child { display: block; }
            body.sidebar-collapsed .iv-nav a { justify-content: flex-start; gap: 12px; padding: 11px 13px; font-size: 14.5px; }
            body.sidebar-collapsed .iv-nav a i { font-size: 18px; }
            .iv-main, body.sidebar-collapsed .iv-main { margin-left: 0; }
            .iv-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 1040; }
            body.sidebar-open .iv-backdrop { display: block; }
            .iv-datepill, .iv-search .kbd { display: none; }
            .iv-content { padding: 16px 14px; }
            .iv-top { padding: 12px 14px; gap: 10px; }
        }
        @@media (max-width: 600px) {
            .iv-top { flex-wrap: nowrap; }
            .iv-search { min-width: 0; }
        }
    </style>
</head>
<body class="dark-mode">
    <div class="iv-app">

        <!-- SIDEBAR -->
        <aside class="iv-sidebar">
            <div class="iv-brand">
                <div class="iv-logo"><i class="bi bi-box-seam-fill"></i></div>
                <h5>INVEXA</h5>
            </div>

            <ul class="iv-nav">
                <li><a class="@act("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a></li>
                <li class="sec">Inventory</li>
                <li><a class="@act("Product")" asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam"></i> Products</a></li>
                <li><a class="@act("Category")" asp-controller="Category" asp-action="Index"><i class="bi bi-tags"></i> Categories</a></li>
                <li><a class="@act("Supplier")" asp-controller="Supplier" asp-action="Index"><i class="bi bi-truck"></i> Suppliers</a></li>
                <li><a class="@act("Stock")" asp-controller="Stock" asp-action="Index"><i class="bi bi-boxes"></i> Live Stock</a></li>
                @if (sessionRole == "Admin")
                {
                    <li><a class="@act("PurchaseOrder")" asp-controller="PurchaseOrder" asp-action="Index"><i class="bi bi-cart-plus"></i> Purchase Orders</a></li>
                }
                <li class="sec">Sales</li>
                <li><a class="@act("Sales")" asp-controller="Sales" asp-action="Index"><i class="bi bi-cart-check"></i> Sales</a></li>
                <li><a class="@act("Invoice")" asp-controller="Invoice" asp-action="Index"><i class="bi bi-receipt"></i> Invoices</a></li>
                <li class="sec">System</li>
                @if (sessionRole == "Admin")
                {
                    <li>
                        <a class="@act("Account")" asp-controller="Account" asp-action="Users">
                            <i class="bi bi-people"></i> Manage Users
                        </a>
                    </li>
                }
                <li><a class="@act("Report")" asp-controller="Report" asp-action="Index"><i class="bi bi-bar-chart"></i> Reports &amp; Insights</a></li>
            </ul>

            <div class="iv-user">
                <div class="av">
                    @if (!string.IsNullOrEmpty(profilePhoto))
                    {
                        <img src="~/images/profiles/@profilePhoto" alt="@uname" />
                    }
                    else
                    {
                        @initials
                    }
                </div>
                <div>
                    <div class="nm">@uname</div>
                    <div class="rl">@(Context.Session.GetString("Role") ?? "Staff")</div>
                </div>
            </div>
        </aside>

        <!-- MAIN -->
        <div class="iv-backdrop" id="ivBackdrop"></div>
        <section class="iv-main">
            <header class="iv-top">
                <button type="button" class="iv-collapse" id="sidebarToggle" aria-label="Collapse sidebar" title="Collapse sidebar">
                    <i class="bi bi-layout-sidebar-inset" id="sidebarToggleIcon"></i>
                </button>
                <div class="iv-search">
                    <i class="bi bi-search si"></i>
                    <div class="iv-search" style="position:relative;">
                        <i class="bi bi-search si"></i>
                        <input type="text" id="globalSearch"
                            placeholder="Search anything..."
                            autocomplete="off">
                        <span class="kbd">⌘ K</span>
                        <!-- Results dropdown -->
                        <div id="globalSearchResults"
                            style="display:none;position:absolute;top:calc(100% + 6px);left:0;right:0;
                                    background:#fff;border:1px solid #e5e7ef;border-radius:12px;
                                    box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:1050;
                                    max-height:420px;overflow-y:auto;min-width:340px;">
                        </div>
                    </div>
                    <span class="kbd">⌘ K</span>
                </div>
                <div class="iv-top-right">
                    <a asp-controller="Notification" asp-action="Index"
                    class="iv-iconbtn text-decoration-none">
                        <i class="bi bi-bell"></i>
                        @if (ViewData["UnreadCount"] is int unread && unread > 0)
                        {
                            <span class="bdot"></span>
                        }
                    </a>
                    <div class="dropdown">
                        <a href="#" class="text-decoration-none" data-bs-toggle="dropdown">
                            @if (!string.IsNullOrEmpty(profilePhoto))
                            {
                                <img src="~/images/profiles/@profilePhoto" alt="@uname" class="iv-topav" />
                            }
                            else
                            {
                                <img src="https://ui-avatars.com/api/?name=@uname&background=6366f1&color=fff" class="iv-topav" />
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person"></i> My Profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangeCredentials"><i class="bi bi-key"></i> Change username / password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Logout</button></form></li>
                        </ul>
                    </div>
                </div>
            </header>

            <div class="iv-content">
                @RenderBody()
            </div>
        </section>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sidebarToggle = document.getElementById("sidebarToggle");
        const sidebarToggleIcon = document.getElementById("sidebarToggleIcon");

        function setSidebarCollapsed(collapsed) {
            document.body.classList.toggle("sidebar-collapsed", collapsed);
            sidebarToggle.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
            sidebarToggle.title = collapsed ? "Expand sidebar" : "Collapse sidebar";
            sidebarToggleIcon.className = collapsed ? "bi bi-layout-sidebar-inset-reverse" : "bi bi-layout-sidebar-inset";
        }

        if (localStorage.getItem("sidebar-collapsed") === "true") {
            setSidebarCollapsed(true);
        }

        sidebarToggle.addEventListener("click", function () {
            if (window.innerWidth <= 992) {
                document.body.classList.toggle("sidebar-open");
            } else {
                const collapsed = !document.body.classList.contains("sidebar-collapsed");
                setSidebarCollapsed(collapsed);
                localStorage.setItem("sidebar-collapsed", collapsed);
            }
        });
        // Mobile: tapping the dark backdrop or a nav link closes the sidebar
        var ivBackdrop = document.getElementById("ivBackdrop");
        if (ivBackdrop) ivBackdrop.addEventListener("click", function () { document.body.classList.remove("sidebar-open"); });
        document.querySelectorAll(".iv-nav a").forEach(function (a) {
            a.addEventListener("click", function () { if (window.innerWidth <= 992) document.body.classList.remove("sidebar-open"); });
        });

        const btn = document.getElementById("themeToggle");
        const icon = document.getElementById("themeIcon");
        if (btn && icon) {
            // Theme toggle disabled - always dark mode
            document.body.classList.add("dark-mode");
            icon.className = "bi bi-sun-fill";
        }
    </script>
    <script>
        (function () {
            var input   = document.getElementById('globalSearch');
            var panel   = document.getElementById('globalSearchResults');
            if (!input || !panel) return;

            var timer;

            function norm(s) { return (s || '').toLowerCase().replace(/\s+/g, ''); }

            function esc(s) {
                var d = document.createElement('div');
                d.textContent = s || '';
                return d.innerHTML;
            }

            function render(data) {
                var p = data.products   || [];
                var c = data.categories || [];
                var s = data.suppliers  || [];
                if (!p.length && !c.length && !s.length) {
                    panel.innerHTML = '<div style="padding:16px;color:#9ca3af;font-size:14px;">No results found.</div>';
                    panel.style.display = 'block';
                    return;
                }
                var html = '';
                function section(label, color, items, renderItem) {
                    if (!items.length) return '';
                    return '<div style="padding:8px 14px 4px;font-size:11px;font-weight:700;'
                        + 'text-transform:uppercase;letter-spacing:1px;color:' + color + ';">'
                        + label + '</div>' + items.map(renderItem).join('');
                }
                function row(href, icon, line1, line2) {
                    return '<a href="' + href + '" style="display:flex;align-items:center;gap:12px;'
                        + 'padding:10px 14px;text-decoration:none;color:#1f2937;border-radius:8px;'
                        + 'margin:2px 6px;transition:.12s;" '
                        + 'onmouseover="this.style.background=\'#f3f4f8\'" '
                        + 'onmouseout="this.style.background=\'\'"><i class="bi ' + icon + '" '
                        + 'style="font-size:18px;color:#6366f1;flex-shrink:0;"></i>'
                        + '<div><div style="font-size:14px;font-weight:500;">' + esc(line1) + '</div>'
                        + (line2 ? '<div style="font-size:12px;color:#9ca3af;">' + esc(line2) + '</div>' : '')
                        + '</div></a>';
                }
                html += section('Products', '#6366f1', p, function(x) {
                    return row('/Product/Index', 'bi-box-seam', x.productName, x.category + (x.sku ? ' · ' + x.sku : ''));
                });
                html += section('Categories', '#22c55e', c, function(x) {
                    return row('/Category/Index', 'bi-tags', x.categoryName, null);
                });
                html += section('Suppliers', '#f59e0b', s, function(x) {
                    return row('/Supplier/Index', 'bi-truck', x.supplierName, x.email || null);
                });
                panel.innerHTML = html;
                panel.style.display = 'block';
            }

            input.addEventListener('input', function () {
                clearTimeout(timer);
                var val = this.value.trim();
                if (!val) { panel.style.display = 'none'; panel.innerHTML = ''; return; }
                timer = setTimeout(function () {
                    fetch('/Search/Global?q=' + encodeURIComponent(val))
                        .then(function(r) { return r.json(); })
                        .then(render)
                        .catch(function() {
                            panel.innerHTML = '<div style="padding:16px;color:#ef4444;font-size:14px;">Search failed.</div>';
                            panel.style.display = 'block';
                        });
                }, 280);
            });

            document.addEventListener('click', function (e) {
                if (!input.contains(e.target) && !panel.contains(e.target)) {
                    panel.style.display = 'none';
                }
            });

            input.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') { panel.style.display = 'none'; input.blur(); }
            });
        })();
        </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
