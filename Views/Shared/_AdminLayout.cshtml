@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var sessionRole = Context.Session.GetString("Role");
    var uname = Context.Session.GetString("Username") ?? "Admin";
    var initials = string.IsNullOrWhiteSpace(uname) ? "AD" : string.Join("", uname.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
    var cc = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string act(string c) => string.Equals(cc, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - INVEXA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- No-flash sidebar: apply collapse state before first paint -->
    <script>
        try { if (localStorage.getItem('sidebar-collapsed') === 'true') document.documentElement.classList.add('sb-pre-coll'); } catch(e){}
    </script>

    <style>
        /* ── INVEXA shell — Inter, Black × Purple ── */
        :root {
            --chrome: #0e1525;   /* sidebar + topbar — ONE colour, no seam */
            --accent: #7c3aed;
            --accent2: #9f67ff;
            --glow: rgba(124,58,237,.4);
            --border: rgba(255,255,255,.07);
            --text: #f0f0fa;
            --muted: #6b6b85;
            --bg: #08080f;
            --card: #12121e;
            --sb-w: 230px;
            --sb-c: 68px;
        }

        *, *::before, *::after { box-sizing: border-box; }

        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }

        html { overflow-y: scroll; scrollbar-gutter: stable; }

        body { margin: 0; background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased; }

        /* pre-paint collapse — zero flash */
        html.sb-pre-coll .iv-sidebar { width: var(--sb-c) !important; }
        html.sb-pre-coll .iv-main    { margin-left: var(--sb-c) !important; }
        html.sb-pre-coll .iv-brand h5,
        html.sb-pre-coll .iv-nav .sec,
        html.sb-pre-coll .iv-nav a span.lbl,
        html.sb-pre-coll .iv-user-info { display: none !important; }
        html.sb-pre-coll .iv-nav a { justify-content: center !important; padding: 12px !important; }

        body.no-trans * { transition: none !important; }

        .iv-app { display: flex; min-height: 100vh; }

        /* ══ SIDEBAR ══ */
        .iv-sidebar {
            width: var(--sb-w);
            background: var(--chrome);     /* same as topbar */
            position: fixed; left: 0; top: 0; height: 100vh;
            display: flex; flex-direction: column;
            padding: 0 10px;
            overflow-y: auto; overflow-x: hidden;
            z-index: 1000;
            border: none;                  /* no border at all */
            transition: width .25s cubic-bezier(.4,0,.2,1);
        }
        .iv-sidebar.collapsed { width: var(--sb-c); }

        /* brand row — same height as topbar so they align */
        .iv-brand {
            display: flex; align-items: center; gap: 11px;
            height: 60px; flex-shrink: 0;
            padding: 0 8px;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }
        .iv-logo {
            width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
            background: linear-gradient(135deg, #7c3aed, #5b21b6);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 18px;
            box-shadow: 0 0 16px var(--glow);
        }
        .iv-brand h5 {
            color: #fff; font-weight: 700; margin: 0;
            font-size: 17px; letter-spacing: .3px;
            white-space: nowrap;
            transition: opacity .2s;
        }
        .iv-sidebar.collapsed .iv-brand h5 { opacity: 0; pointer-events: none; }

        /* nav */
        .iv-nav { list-style: none; padding: 10px 0; margin: 0; flex: 1; }
        .iv-nav .sec {
            font-size: 10px; font-weight: 700; letter-spacing: 1.8px;
            color: #6060a0; padding: 16px 12px 5px; text-transform: uppercase;
            white-space: nowrap; overflow: hidden;
            transition: opacity .2s;
        }
        .iv-sidebar.collapsed .sec { opacity: 0; height: 0; padding: 0; overflow: hidden; }

        .iv-nav a {
            display: flex; align-items: center; gap: 11px;
            color: #e8e8ff; text-decoration: none;
            padding: 10px 12px; border-radius: 10px; margin: 2px 0;
            font-size: 14px; font-weight: 500;
            white-space: nowrap; overflow: hidden;
            position: relative;
            transition: background .15s, color .15s;
        }
        .iv-nav a i { font-size: 17px; flex-shrink: 0; color: #e8e8ff; transition: color .15s; }
        .iv-nav a span.lbl { transition: opacity .2s; }
        .iv-sidebar.collapsed .iv-nav a span.lbl { opacity: 0; width: 0; overflow: hidden; }
        .iv-sidebar.collapsed .iv-nav a { justify-content: center; padding: 12px; }

        .iv-nav a:hover { color: #fff; background: rgba(124,58,237,.18); }
        .iv-nav a:hover i { color: #fff; }
        .iv-nav a.active {
            color: #c4b5fd; background: rgba(124,58,237,.2);
        }
        .iv-nav a.active::before {
            content: ""; position: absolute; left: 0; top: 20%; bottom: 20%;
            width: 3px; border-radius: 0 3px 3px 0;
            background: var(--accent); box-shadow: 0 0 10px var(--glow);
        }

        /* tooltip on collapsed */
        .iv-sidebar.collapsed .iv-nav a:hover::after {
            content: attr(data-tip);
            position: absolute; left: calc(var(--sb-c) + 10px); top: 50%;
            transform: translateY(-50%);
            background: #1a1a2e; border: 1px solid rgba(124,58,237,.3);
            color: #f0f0fa; font-size: 12.5px; font-weight: 500;
            padding: 5px 11px; border-radius: 8px; white-space: nowrap;
            z-index: 200; box-shadow: 0 6px 20px rgba(0,0,0,.5);
            pointer-events: none;
        }

        /* user footer */
        .iv-user {
            display: flex; align-items: center; gap: 10px;
            padding: 13px 10px;
            border-top: 1px solid rgba(255,255,255,.06);
            flex-shrink: 0;
        }
        .iv-user .av {
            width: 36px; height: 36px; border-radius: 9px; flex-shrink: 0;
            background: linear-gradient(135deg, #7c3aed, #5b21b6);
            color: #fff; display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 14px;
        }
        .iv-user-info { overflow: hidden; transition: opacity .2s; }
        .iv-user .nm { color: #f0f0fa; font-weight: 600; font-size: 13px; white-space: nowrap; }
        .iv-user .rl { color: var(--muted); font-size: 11px; white-space: nowrap; }
        .iv-sidebar.collapsed .iv-user-info { opacity: 0; width: 0; pointer-events: none; }

        /* ══ MAIN ══ */
        .iv-main {
            margin-left: var(--sb-w);
            flex: 1; min-height: 100vh;
            display: flex; flex-direction: column;
            transition: margin-left .25s cubic-bezier(.4,0,.2,1);
        }
        .iv-main.sb-coll { margin-left: var(--sb-c); }

        /* ══ TOPBAR — exact same colour as sidebar, no border/shadow seam ══ */
        .iv-top {
            height: 60px;
            background: var(--chrome);     /* same --chrome */
            border: none;
            box-shadow: none;
            display: flex; align-items: center; gap: 14px;
            padding: 0 22px;
            position: sticky; top: 0; z-index: 900;
            flex-shrink: 0;
        }
        /* single subtle separator — content area below */
        .iv-top::after {
            content: "";
            position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
            background: rgba(255,255,255,.06);
            pointer-events: none;
        }

        /* collapse toggle */
        .iv-collapse {
            width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
            border: 1px solid rgba(255,255,255,.35);
            background: rgba(255,255,255,.18);
            color: #ffffff; display: grid; place-items: center;
            font-size: 17px; cursor: pointer;
            transition: background .18s, color .18s, border-color .18s;
        }
        .iv-collapse:hover { background: rgba(124,58,237,.4); border-color: rgba(124,58,237,.8); color: #fff; }

        /* search — blends with chrome, no contrast box */
        .iv-search {
            flex: 1; max-width: 420px;
            margin: 0 auto; position: relative;
        }
        .iv-search input {
            width: 100%;
            background: rgba(255,255,255,.13);
            border: 1px solid rgba(255,255,255,.28);
            border-radius: 10px;
            padding: 9px 60px 9px 36px;
            font-size: 13.5px; color: #f0f0fa; outline: none;
            font-family: inherit;
            caret-color: var(--accent2);
            transition: background .18s, border-color .18s;
        }
        .iv-search input::placeholder { color: rgba(255,255,255,.85); }
        .iv-search input:focus {
            background: rgba(255,255,255,.1);
            border-color: rgba(124,58,237,.55);
            box-shadow: 0 0 0 3px rgba(124,58,237,.1);
        }
        .iv-search .si {
            position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
            color: rgba(255,255,255,.9); font-size: 14px; pointer-events: none;
        }
        .iv-search .kbd {
            position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
            font-size: 10.5px; color: rgba(255,255,255,.4);
            border: 1px solid rgba(255,255,255,.15); border-radius: 5px;
            padding: 1px 6px; background: rgba(255,255,255,.06); pointer-events: none;
        }

        /* search results dropdown */
        #globalSearchResults {
            display: none; position: absolute; top: calc(100% + 6px); left: 0; right: 0;
            background: #1a1a2e; border: 1px solid rgba(124,58,237,.25);
            border-radius: 12px; box-shadow: 0 12px 36px rgba(0,0,0,.6);
            z-index: 1050; max-height: 420px; overflow-y: auto; min-width: 340px;
        }

        .iv-top-right { display: flex; align-items: center; gap: 10px; }

        .iv-iconbtn {
            width: 36px; height: 36px; border-radius: 9px;
            border: 1px solid rgba(255,255,255,.35);
            background: rgba(255,255,255,.18);
            display: flex; align-items: center; justify-content: center;
            color: #ffffff; cursor: pointer; position: relative;
            font-size: 17px;
            transition: all .18s;
        }
        .iv-iconbtn:hover { background: rgba(124,58,237,.4); border-color: rgba(124,58,237,.8); color: #fff; }
        .iv-iconbtn .bdot {
            position: absolute; top: 7px; right: 7px;
            width: 7px; height: 7px;
            background: #ef4444; border-radius: 50%;
            border: 1.5px solid var(--chrome);
        }
        .iv-topav { width: 34px; height: 34px; border-radius: 9px; border: 2px solid rgba(124,58,237,.4); }

        /* dropdown */
        .dropdown-menu {
            background: #1a1a2e !important;
            border: 1px solid rgba(124,58,237,.25) !important;
            border-radius: 12px !important;
            box-shadow: 0 16px 40px rgba(0,0,0,.6) !important;
        }
        .dropdown-item { color: #9090aa !important; font-size: 13px !important; border-radius: 7px; }
        .dropdown-item:hover { background: rgba(124,58,237,.12) !important; color: #f0f0fa !important; }
        .dropdown-divider { border-color: rgba(255,255,255,.07) !important; }

        /* content area */
        .iv-content { padding: 22px 26px; flex: 1; }
        .iv-content > * { animation: pg-in .3s ease; }
        @@keyframes pg-in { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:none; } }

        /* scrollbar */
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #2a2a3e; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

        @@media (max-width: 992px) {
            .iv-sidebar { transform: translateX(-100%); }
            .iv-main { margin-left: 0 !important; }
        }
    </style>
</head>
<body>
    <div class="iv-app">

        <!-- SIDEBAR -->
        <aside class="iv-sidebar" id="ivSidebar">
            <div class="iv-brand">
                <div class="iv-logo"><i class="bi bi-boxes"></i></div>
                <h5>INVEXA</h5>
            </div>

            <ul class="iv-nav">
                <li><a class="@act("Home")" asp-controller="Home" asp-action="Index" data-tip="Dashboard"><i class="bi bi-grid-1x2-fill"></i><span class="lbl"> Dashboard</span></a></li>
                <li class="sec">Inventory</li>
                <li><a class="@act("Product")" asp-controller="Product" asp-action="Index" data-tip="Products"><i class="bi bi-box-seam"></i><span class="lbl"> Products</span></a></li>
                <li><a class="@act("Category")" asp-controller="Category" asp-action="Index" data-tip="Categories"><i class="bi bi-tags"></i><span class="lbl"> Categories</span></a></li>
                <li><a class="@act("Supplier")" asp-controller="Supplier" asp-action="Index" data-tip="Suppliers"><i class="bi bi-building"></i><span class="lbl"> Suppliers</span></a></li>
                <li><a class="@act("Stock")" asp-controller="Stock" asp-action="Index" data-tip="Live Stock"><i class="bi bi-activity"></i><span class="lbl"> Live Stock</span></a></li>
                @if (sessionRole == "Admin") {
                    <li><a class="@act("PurchaseOrder")" asp-controller="PurchaseOrder" asp-action="Index" data-tip="Purchase Orders"><i class="bi bi-cart-plus"></i><span class="lbl"> Purchase Orders</span></a></li>
                }
                <li class="sec">Sales</li>
                <li><a class="@act("Sales")" asp-controller="Sales" asp-action="Index" data-tip="Sales"><i class="bi bi-bag-check"></i><span class="lbl"> Sales</span></a></li>
                <li><a class="@act("Invoice")" asp-controller="Invoice" asp-action="Index" data-tip="Invoices"><i class="bi bi-receipt"></i><span class="lbl"> Invoices</span></a></li>
                <li class="sec">System</li>
                @if (sessionRole == "Admin") {
                    <li><a class="@act("Account")" asp-controller="Account" asp-action="Users" data-tip="Manage Users"><i class="bi bi-people"></i><span class="lbl"> Manage Users</span></a></li>
                }
                <li><a class="@act("Report")" asp-controller="Report" asp-action="Index" data-tip="Reports"><i class="bi bi-bar-chart-line"></i><span class="lbl"> Reports &amp; Insights</span></a></li>
            </ul>

            <div class="iv-user">
                <div class="av">@initials</div>
                <div class="iv-user-info">
                    <div class="nm">@uname</div>
                    <div class="rl">@(Context.Session.GetString("Role") ?? "Staff")</div>
                </div>
            </div>
        </aside>

        <!-- MAIN -->
        <section class="iv-main" id="ivMain">
            <header class="iv-top">
                <button type="button" class="iv-collapse" id="sidebarToggle" title="Toggle sidebar">
                    <i class="bi bi-layout-sidebar-inset" id="sidebarToggleIcon"></i>
                </button>

                <div class="iv-search">
                    <i class="bi bi-search si"></i>
                    <input type="text" id="globalSearch" placeholder="Search products, invoices..." autocomplete="off">
                    <span class="kbd">⌘K</span>
                    <div id="globalSearchResults"></div>
                </div>

                <div class="iv-top-right">
                    <a asp-controller="Notification" asp-action="Index" class="iv-iconbtn text-decoration-none" title="Notifications">
                        <i class="bi bi-bell"></i>
                        @if (ViewData["UnreadCount"] is int unread && unread > 0) { <span class="bdot"></span> }
                    </a>
                    <div class="dropdown">
                        <a href="#" class="text-decoration-none" data-bs-toggle="dropdown">
                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(uname)&background=7c3aed&color=fff&bold=true" class="iv-topav" />
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangeCredentials"><i class="bi bi-key me-2"></i>Change Password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="dropdown-item" style="color:#f87171!important"><i class="bi bi-box-arrow-right me-2"></i>Logout</button></form></li>
                        </ul>
                    </div>
                </div>
            </header>

            <div class="iv-content">
                @RenderBody()
            </div>
        </section>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    (function () {
        var sb    = document.getElementById('ivSidebar');
        var main  = document.getElementById('ivMain');
        var btn   = document.getElementById('sidebarToggle');
        var icon  = document.getElementById('sidebarToggleIcon');
        var coll  = localStorage.getItem('sidebar-collapsed') === 'true';

        function applyCollapse(animate) {
            if (!animate) document.body.classList.add('no-trans');
            if (coll) {
                sb.classList.add('collapsed');
                main.classList.add('sb-coll');
                icon.className = 'bi bi-layout-sidebar-inset-reverse';
                document.documentElement.classList.add('sb-pre-coll');
            } else {
                sb.classList.remove('collapsed');
                main.classList.remove('sb-coll');
                icon.className = 'bi bi-layout-sidebar-inset';
                document.documentElement.classList.remove('sb-pre-coll');
            }
            if (!animate) {
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () {
                        document.body.classList.remove('no-trans');
                    });
                });
            }
        }

        applyCollapse(false);

        btn.addEventListener('click', function () {
            coll = !coll;
            localStorage.setItem('sidebar-collapsed', coll);
            applyCollapse(true);
        });

        /* global search */
        var inp   = document.getElementById('globalSearch');
        var panel = document.getElementById('globalSearchResults');
        if (!inp || !panel) return;
        var timer;
        function esc(s) { var d=document.createElement('div'); d.textContent=s||''; return d.innerHTML; }
        function render(data) {
            var p=data.products||[], c=data.categories||[], s=data.suppliers||[];
            if (!p.length && !c.length && !s.length) {
                panel.innerHTML='<div style="padding:14px 16px;color:#6b6b85;font-size:13px;">No results.</div>';
                panel.style.display='block'; return;
            }
            var html='';
            function sec(lbl,col,items,fn){ if(!items.length)return ''; return '<div style="padding:8px 14px 3px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:'+col+'">'+lbl+'</div>'+items.map(fn).join(''); }
            function row(href,ico,l1,l2){ return '<a href="'+href+'" style="display:flex;align-items:center;gap:11px;padding:9px 14px;text-decoration:none;color:#d0d0e8;border-radius:8px;margin:2px 6px;transition:.12s" onmouseover="this.style.background=\'rgba(124,58,237,.12)\'" onmouseout="this.style.background=\'\'"><i class="bi '+ico+'" style="font-size:17px;color:#9f67ff;flex-shrink:0"></i><div><div style="font-size:13px;font-weight:500">'+esc(l1)+'</div>'+(l2?'<div style="font-size:11.5px;color:#6b6b85">'+esc(l2)+'</div>':'')+'</div></a>'; }
            html+=sec('Products','#9f67ff',p,function(x){return row('/Product/Index','bi-box-seam',x.productName,x.category+(x.sku?' · '+x.sku:''));});
            html+=sec('Categories','#22c55e',c,function(x){return row('/Category/Index','bi-tags',x.categoryName,null);});
            html+=sec('Suppliers','#f59e0b',s,function(x){return row('/Supplier/Index','bi-building',x.supplierName,x.email||null);});
            panel.innerHTML=html; panel.style.display='block';
        }
        inp.addEventListener('input',function(){
            clearTimeout(timer); var v=this.value.trim();
            if(!v){panel.style.display='none';panel.innerHTML='';return;}
            timer=setTimeout(function(){
                fetch('/Search/Global?q='+encodeURIComponent(v)).then(function(r){return r.json();}).then(render)
                .catch(function(){panel.innerHTML='<div style="padding:14px;color:#f87171;font-size:13px;">Failed.</div>';panel.style.display='block';});
            },260);
        });
        document.addEventListener('click',function(e){if(!inp.contains(e.target)&&!panel.contains(e.target))panel.style.display='none';});
        inp.addEventListener('keydown',function(e){if(e.key==='Escape'){panel.style.display='none';inp.blur();}});
    })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
