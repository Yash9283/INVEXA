@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>INVEXA - Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

    <style>
        /* ── Background panels ── */
        .split-wrap {
            background: #0a0a0e !important;
        }

        .scene-panel {
            background: #0a0a0e !important;
        }

        .form-panel {
            background: radial-gradient(circle at 50% 10%, rgba(139,92,246,.10), transparent 45%), #0a0a0e !important;
        }

        /* ── Scene fade — remove orange edge bleed ── */
        .scene-panel .scene-fade {
            background: linear-gradient(90deg, transparent 45%, rgba(10,10,14,.72) 80%, rgba(10,10,14,.98) 100%), linear-gradient(0deg, rgba(0,0,0,.40) 0%, transparent 40%) !important;
        }

        /* ── Form panel glows — orange → purple ── */
        .form-panel::before {
            background: radial-gradient(circle, rgba(139,92,246,.10), transparent 65%) !important;
        }

        .form-panel::after {
            background: radial-gradient(circle, rgba(59,130,246,.08), transparent 65%) !important;
        }

        /* ── Dot grid — orange dots → purple dots ── */
        .form-panel .panel-grid {
            background-image: radial-gradient(rgba(139,92,246,.10) 1px, transparent 1px) !important;
        }

        /* ── Logo separator line — orange → purple ── */
        .brand-logo {
            border-bottom-color: rgba(139,92,246,.20) !important;
        }

        /* ── "WELCOME BACK" heading — gold gradient → white ── */
        .welcome-block h2 {
            background: none !important;
            -webkit-text-fill-color: #ffffff !important;
            color: #ffffff !important;
            letter-spacing: 6px !important;
            text-shadow: 0 2px 26px rgba(139,92,246,.45);
        }

        .welcome-block p {
            color: #9aa4c6 !important;
        }

        /* ── Input group — orange icon bg + orange border → purple ── */
        .input-group-custom {
            background: rgba(255,255,255,.04) !important;
            border: 1px solid rgba(139,92,246,.28) !important;
        }

            .input-group-custom:focus-within {
                border-color: rgba(168,85,247,.75) !important;
                box-shadow: 0 0 0 3px rgba(139,92,246,.20), 0 0 22px rgba(139,92,246,.15) !important;
            }

            .input-group-custom .icon-tab {
                background: rgba(139,92,246,.22) !important;
            }

                .input-group-custom .icon-tab i {
                    color: #c4b5fd !important;
                }

            .input-group-custom input {
                color: #000000 !important;
            }

                .input-group-custom input::placeholder {
                    color: rgba(255,255,255,.42) !important;
                }

            .input-group-custom .toggle-eye:hover {
                color: #c4b5fd !important;
            }

        /* ── Main login button — gold → purple-pink gradient ── */
        .login-btn {
            background: linear-gradient(90deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%) !important;
            box-shadow: 0 10px 30px rgba(139,92,246,.5) !important;
        }

            .login-btn:hover {
                box-shadow: 0 16px 42px rgba(236,72,153,.5), 0 0 60px rgba(139,92,246,.25) !important;
            }

        /* ── Register / forgot links ── */
        .register-text a {
            color: #60a5fa !important;
        }

            .register-text a:hover {
                color: #ffffff !important;
            }

        /* ── Logo size ── */
        .brand-logo img {
            mix-blend-mode: normal !important;
            width: 255px !important;
        }

        /* ── Themed security question box (VerifyQuestion) ── */
        .sq-question-box {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: rgba(139,92,246,.12);
            border: 1px solid rgba(139,92,246,.30);
            border-radius: 12px;
            padding: 12px 16px;
            color: #c4b5fd;
            font-size: 13.5px;
            margin-bottom: 18px;
            line-height: 1.5;
        }

            .sq-question-box i {
                font-size: 16px;
                margin-top: 2px;
                flex-shrink: 0;
            }

        /* ── Success alert (Register) ── */
        .alert-success {
            background: rgba(34,197,94,.1);
            border: 1px solid rgba(34,197,94,.3);
            color: #86efac;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 13.5px;
            margin-bottom: 18px;
            text-align: center;
        }
    </style>

</head>
<body>

    <!-- ================================================
         PRELOADER
         Sequence: rays fire → burst → logo slams in → hold → iris exit
    ================================================ -->
    <div id="preloader">

        <!-- 16 rays: 8 orange + 8 white, alternate for star effect -->
        <div class="pl-rays">
            <span class="ray-o"></span><span class="ray-w"></span>
            <span class="ray-o"></span><span class="ray-w"></span>
            <span class="ray-o"></span><span class="ray-w"></span>
            <span class="ray-o"></span><span class="ray-w"></span>
            <span class="ray-o"></span><span class="ray-w"></span>
            <span class="ray-o"></span><span class="ray-w"></span>
            <span class="ray-o"></span><span class="ray-w"></span>
            <span class="ray-o"></span><span class="ray-w"></span>
        </div>

        <!-- Center glow burst that fires with the rays -->
        <div class="pl-burst"></div>

        <!-- Center stage: logo appears AFTER rays -->
        <div class="pl-stage">

            <!-- mix-blend-mode:lighten — black bg gone, only oval shows -->
            <div class="pl-logo-wrap">
                <img src="~/images/invexa-logo.png"
                     class="pl-logo"
                     alt="INVEXA" />
            </div>

            <!-- Loader text + bar — appears after logo -->
            <div class="pl-bottom">
                <span id="loaderText">Initializing...</span>
                <div class="loader-bar"><span></span></div>
            </div>

        </div>

    </div>

    <!-- ================================================
         LOGIN PAGE
    ================================================ -->
    <div id="login-container">
        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const pre       = document.getElementById("preloader");
        const loginBox  = document.getElementById("login-container");

        /* ── Show preloader only the FIRST time (tracked via sessionStorage) ── */
        const alreadySeen = sessionStorage.getItem("plSeen");

        if (alreadySeen) {
            /* Not the first visit this session — skip preloader immediately */
            pre.style.display   = "none";
            loginBox.style.display = "flex";
        } else {
            /* First visit — play the full animation then mark as seen */
            sessionStorage.setItem("plSeen", "1");

            /* Loader text cycling */
            const messages = [
                "Connecting Database...",
                "Loading Inventory...",
                "Fetching Products...",
                "Authenticating User...",
                "Workspace Ready"
            ];
            let idx = 0;
            const loaderText = document.getElementById("loaderText");
            const msgTimer = setInterval(function () {
                loaderText.textContent = messages[idx];
                idx++;
                if (idx >= messages.length) clearInterval(msgTimer);
            }, 420);

            /* Dismiss after hold time */
            window.addEventListener("load", function () {
                setTimeout(function () {
                    pre.classList.add("wipe-out");
                    setTimeout(function () {
                        pre.style.display      = "none";
                        loginBox.style.display = "flex";
                    }, 720);
                }, 3200);
            });
        }
    </script>

</body>
</html>
