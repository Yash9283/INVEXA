@model StockFlow.Models.DashboardViewModel
@using System.Text.Json
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var uname = Context.Session.GetString("Username") ?? "Admin";

    var st = Model.SalesTotals;
    decimal salesMoM = 0;
    if (st.Count >= 2 && st[st.Count - 2] != 0)
        salesMoM = ((st[st.Count - 1] - st[st.Count - 2]) / st[st.Count - 2]) * 100;

    int payTotal = Model.PaidCount + Model.UnpaidCount;
    int catTotal = Model.CategoryCounts.Sum();
}

<style>
    .dx { padding: 4px 2px 10px; }
    .dx-welcome h2 { font-family: 'Comfortaa', cursive; font-weight: 700; font-size: 28px; color: #0f172a; margin: 0; letter-spacing: -.4px; }
    .dx-welcome p { color: #64748b; margin: 2px 0 0; font-size: 14px; }

    /* Gradient stat cards */
    .gcard {
        border-radius: 18px; padding: 18px 20px 0; color: #fff; position: relative; overflow: hidden;
        min-height: 148px; box-shadow: 0 10px 26px rgba(2,6,23,.18);
    }
    .gcard .g-top { font-size: 13px; opacity: .92; font-weight: 500; }
    .gcard .g-val { font-size: 27px; font-weight: 800; margin: 6px 0 3px; line-height: 1; }
    .gcard .g-sub { font-size: 12px; opacity: .9; }
    .gcard .g-ico {
        position: absolute; top: 16px; right: 16px; width: 40px; height: 40px; border-radius: 12px;
        background: rgba(255,255,255,.18); display: flex; align-items: center; justify-content: center; font-size: 20px;
    }
    .gcard canvas { position: absolute; left: 0; right: 0; bottom: 0; width: 100% !important; height: 46px !important; opacity: .9; }
    .gc-green { background: linear-gradient(135deg, #065f46, #10b981); }
    .gc-blue  { background: linear-gradient(135deg, #1e3a8a, #3b82f6); }
    .gc-violet{ background: linear-gradient(135deg, #5b21b6, #8b5cf6); }
    .gc-red   { background: linear-gradient(135deg, #991b1b, #ef4444); }

    /* Mini pills */
    .pill {
        background: #fff; border: 1px solid #eef2f7; border-radius: 16px; padding: 14px 16px;
        display: flex; align-items: center; gap: 12px; box-shadow: 0 4px 14px rgba(2,6,23,.05); height: 100%;
    }
    .pill-ico { width: 46px; height: 46px; border-radius: 12px; flex: 0 0 46px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 20px; }
    .pill-val { font-size: 20px; font-weight: 800; line-height: 1; color: #0f172a; }
    .pill-lbl { font-size: 12px; color: #64748b; }
    .c-orange { background: linear-gradient(135deg,#fbbf24,#d97706); }
    .c-pink   { background: linear-gradient(135deg,#f472b6,#db2777); }
    .c-teal   { background: linear-gradient(135deg,#2dd4bf,#0d9488); }
    .c-indigo { background: linear-gradient(135deg,#818cf8,#4f46e5); }
    .c-green  { background: linear-gradient(135deg,#34d399,#059669); }

    /* Panels */
    .p2 { background: #fff; border: 1px solid #eef2f7; border-radius: 18px; box-shadow: 0 6px 18px rgba(2,6,23,.05); overflow: hidden; height: 100%; }
    .p2h { padding: 15px 18px; font-weight: 700; color: #0f172a; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; }
    .p2b { padding: 16px 18px; }
    .muted { color: #64748b; }

    /* Legends */
    .leg { display: flex; align-items: center; justify-content: space-between; padding: 7px 0; font-size: 13.5px; }
    .leg .lft { display: flex; align-items: center; gap: 9px; }
    .leg .dot { width: 11px; height: 11px; border-radius: 3px; display: inline-block; }

    /* Recent list */
    .rl { display: flex; align-items: flex-start; gap: 12px; padding: 11px 0; border-bottom: 1px solid #f1f5f9; }
    .rl:last-child { border-bottom: none; }
    .rl-ico { width: 38px; height: 38px; border-radius: 11px; flex: 0 0 38px; display: flex; align-items: center; justify-content: center; font-size: 17px; color: #fff; }
    .rl-title { font-size: 13.5px; font-weight: 600; color: #0f172a; line-height: 1.2; }
    .rl-sub { font-size: 12px; }

    /* ===== DARK MODE overrides ===== */
    body.dark-mode .dx-welcome h2 { color: #f1f5f9; }
    body.dark-mode .dx-welcome p,
    body.dark-mode .muted { color: #94a3b8; }
    body.dark-mode .pill,
    body.dark-mode .p2 { background: #0F3040; border-color: rgba(255,255,255,.07); }
    body.dark-mode .pill-val,
    body.dark-mode .p2h,
    body.dark-mode .rl-title { color: #e2e8f0; }
    body.dark-mode .p2h { border-color: rgba(255,255,255,.07); }
    body.dark-mode .rl { border-color: rgba(255,255,255,.06); }
    body.dark-mode .table td { color: #e2e8f0 !important; border-color: rgba(255,255,255,.06) !important; }
    body.dark-mode .table thead th { background: #0f172a !important; color: #94a3b8 !important; border-color: rgba(255,255,255,.06) !important; }
</style>

<div class="dx">

    <!-- Welcome -->
    <div class="dx-welcome mb-4">
        <h2>Welcome back, @uname! 👋</h2>
        <p>Here's what's happening with your business today.</p>
    </div>

    <!-- Gradient stat cards -->
    <div class="row g-3">
        <div class="col-xl-3 col-md-6">
            <div class="gcard gc-green">
                <div class="g-ico"><i class="bi bi-currency-rupee"></i></div>
                <div class="g-top">Total Revenue</div>
                <div class="g-val">₹@Model.TotalRevenue.ToString("N0")</div>
                <div class="g-sub">₹@Model.UnpaidAmount.ToString("N0") pending</div>
                <canvas id="spark1"></canvas>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="gcard gc-blue">
                <div class="g-ico"><i class="bi bi-box-seam"></i></div>
                <div class="g-top">Stock Value</div>
                <div class="g-val">₹@Model.TotalStockValue.ToString("N0")</div>
                <div class="g-sub">@Model.TotalProducts products in stock</div>
                <canvas id="spark2"></canvas>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="gcard gc-violet">
                <div class="g-ico"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="g-top">Sales Revenue</div>
                <div class="g-val">₹@Model.SalesRevenue.ToString("N0")</div>
                <div class="g-sub">@salesMoM.ToString("+0.0;-0.0;0")% from last month</div>
                <canvas id="spark3"></canvas>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="gcard gc-red">
                <div class="g-ico"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="g-top">Stock Alerts</div>
                <div class="g-val">@Model.LowStockCount</div>
                <div class="g-sub">@Model.OutOfStockCount out of stock</div>
                <canvas id="spark4"></canvas>
            </div>
        </div>
    </div>

    <!-- Mini pills -->
    <div class="row g-3 mt-1">
        <div class="col-md-3 col-6">
            <div class="pill"><div class="pill-ico c-orange"><i class="bi bi-cart-check"></i></div>
                <div><div class="pill-val">@Model.TotalSales</div><div class="pill-lbl">Sales</div></div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="pill"><div class="pill-ico c-pink"><i class="bi bi-receipt"></i></div>
                <div><div class="pill-val">@Model.TotalInvoices</div><div class="pill-lbl">Invoices</div></div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="pill"><div class="pill-ico c-teal"><i class="bi bi-tags"></i></div>
                <div><div class="pill-val">@Model.TotalCategories</div><div class="pill-lbl">Categories</div></div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="pill"><div class="pill-ico c-indigo"><i class="bi bi-truck"></i></div>
                <div><div class="pill-val">@Model.TotalSuppliers</div><div class="pill-lbl">Suppliers</div></div></div>
        </div>
    </div>

    <!-- Main grid -->
    <div class="row g-3 mt-1">

        <!-- LEFT: charts -->
        <div class="col-lg-8">
            <div class="row g-3">
                <div class="col-md-7">
                    <div class="p2">
                        <div class="p2h">Sales Trend (by month)</div>
                        <div class="p2b"><canvas id="salesChart" height="150"></canvas></div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="p2">
                        <div class="p2h">Invoice Payment Status</div>
                        <div class="p2b">
                            <canvas id="paymentChart" height="150"></canvas>
                            <div class="mt-2">
                                <div class="leg"><span class="lft"><span class="dot" style="background:#22c55e"></span>Paid</span>
                                    <span class="muted">@Model.PaidCount (@(payTotal == 0 ? 0 : Model.PaidCount * 100 / payTotal)%)</span></div>
                                <div class="leg"><span class="lft"><span class="dot" style="background:#f59e0b"></span>Unpaid</span>
                                    <span class="muted">@Model.UnpaidCount (@(payTotal == 0 ? 0 : Model.UnpaidCount * 100 / payTotal)%)</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="p2">
                        <div class="p2h">Top Selling Products</div>
                        <div class="p2b"><canvas id="topChart" height="170"></canvas></div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="p2">
                        <div class="p2h">Products by Category</div>
                        <div class="p2b">
                            <canvas id="categoryChart" height="150"></canvas>
                            <div class="mt-2">
                                @for (int i = 0; i < Model.CategoryNames.Count && i < 6; i++)
                                {
                                    var pct = catTotal == 0 ? 0 : Model.CategoryCounts[i] * 100 / catTotal;
                                    <div class="leg">
                                        <span class="lft"><span class="dot" style="background:@(new[]{"#059669","#0d9488","#2563eb","#7c3aed","#f59e0b","#ec4899"}[i % 6])"></span>@Model.CategoryNames[i]</span>
                                        <span class="muted">@Model.CategoryCounts[i] (@pct%)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: stock alerts -->
        <div class="col-lg-4">
            <div class="p2">
                <div class="p2h">Recent Stock Alerts</div>
                <div class="p2b pt-2">
                    @if (Model.LowStockProducts.Any())
                    {
                        foreach (var p in Model.LowStockProducts.Take(6))
                        {
                            <div class="rl">
                                <div class="rl-ico c-red" style="background:linear-gradient(135deg,#f87171,#dc2626)"><i class="bi bi-box"></i></div>
                                <div>
                                    <div class="rl-title">@p.ProductName</div>
                                    <div class="rl-sub text-danger">@(p.Quantity == 0 ? "Out of stock" : "Only " + p.Quantity + " left in stock")</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center muted py-3">No stock alerts 🎉</div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const salesMonths = @Html.Raw(JsonSerializer.Serialize(Model.SalesMonths));
    const salesTotals = @Html.Raw(JsonSerializer.Serialize(Model.SalesTotals));
    const catNames    = @Html.Raw(JsonSerializer.Serialize(Model.CategoryNames));
    const catCounts   = @Html.Raw(JsonSerializer.Serialize(Model.CategoryCounts));
    const topNames    = @Html.Raw(JsonSerializer.Serialize(Model.TopProductNames));
    const topQty      = @Html.Raw(JsonSerializer.Serialize(Model.TopProductQty));
    const paidCount   = @Model.PaidCount;
    const unpaidCount = @Model.UnpaidCount;

    // Adapt chart text/grid to light or dark mode
    const isDark = document.body.classList.contains('dark-mode');
    Chart.defaults.color = isDark ? '#94a3b8' : '#64748b';
    Chart.defaults.borderColor = isDark ? 'rgba(255,255,255,.07)' : 'rgba(2,6,23,.06)';

    const palette = ['#059669','#0d9488','#2563eb','#7c3aed','#f59e0b','#ec4899','#14b8a6','#22c55e'];

    // Mini sparklines on gradient cards
    function spark(id, data, color) {
        new Chart(document.getElementById(id), {
            type: 'line',
            data: { labels: data.map(function(){return '';}),
                datasets: [{ data: data, borderColor: color, backgroundColor: 'rgba(255,255,255,.18)',
                    fill: true, tension: .4, pointRadius: 0, borderWidth: 2 }] },
            options: { plugins: { legend: { display: false }, tooltip: { enabled: false } },
                scales: { x: { display: false }, y: { display: false } } }
        });
    }
    const sd = salesTotals.length ? salesTotals : [3,5,4,7,6,9];
    spark('spark1', sd, 'rgba(255,255,255,.9)');
    spark('spark2', [2,4,3,5,6,7], 'rgba(255,255,255,.9)');
    spark('spark3', sd, 'rgba(255,255,255,.9)');
    spark('spark4', [5,4,6,3,4,2], 'rgba(255,255,255,.9)');

    // Sales trend area
    new Chart(document.getElementById('salesChart'), {
        type: 'line',
        data: { labels: salesMonths, datasets: [{ label: 'Sales (₹)', data: salesTotals,
            borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,.18)', fill: true, tension: .35,
            pointRadius: 3, pointBackgroundColor: '#10b981' }] },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });

    // Payment doughnut
    new Chart(document.getElementById('paymentChart'), {
        type: 'doughnut', data: { labels: ['Paid','Unpaid'],
            datasets: [{ data: [paidCount, unpaidCount], backgroundColor: ['#22c55e','#f59e0b'], borderWidth: 0 }] },
        options: { cutout: '65%', plugins: { legend: { display: false } } }
    });

    // Top products bar
    new Chart(document.getElementById('topChart'), {
        type: 'bar', data: { labels: topNames, datasets: [{ data: topQty, backgroundColor: '#8b5cf6', borderRadius: 6 }] },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });

    // Category doughnut
    new Chart(document.getElementById('categoryChart'), {
        type: 'doughnut', data: { labels: catNames, datasets: [{ data: catCounts, backgroundColor: palette, borderWidth: 0 }] },
        options: { cutout: '62%', plugins: { legend: { display: false } } }
    });
</script>
