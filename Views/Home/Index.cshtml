@model StockFlow.Models.DashboardViewModel
@using System.Text.Json
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var uname = Context.Session.GetString("Username") ?? "Admin";

    // Month-over-month sales change (real data)
    var st = Model.SalesTotals;
    decimal salesMoM = 0;
    if (st.Count >= 2 && st[st.Count - 2] != 0)
        salesMoM = ((st[st.Count - 1] - st[st.Count - 2]) / st[st.Count - 2]) * 100;

    int payTotal = Model.PaidCount + Model.UnpaidCount;
    int catTotal = Model.CategoryCounts.Sum();

    // Time-based greeting
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good Morning" : (hour < 17 ? "Good Afternoon" : "Good Evening");

    // Inventory health — 4-tier weighted scoring:
    // Healthy   = 1.0 pt  (qty > reorderLevel)
    // Warning   = 0.6 pt  (qty > 25% reorder but <= reorderLevel)
    // Critical  = 0.2 pt  (qty > 0 but <= 25% reorderLevel)
    // OutOfStock= 0.0 pt  (qty == 0)
    int healthPct = 100;
    if (Model.TotalProducts > 0) {
        double score =
            (Model.HealthyStockCount   * 1.0) +
            (Model.WarningStockCount   * 0.6) +
            (Model.CriticalStockCount  * 0.2) +
            (Model.OutOfStockCount     * 0.0);
        healthPct = (int)Math.Round(score / Model.TotalProducts * 100);
    }
    if (healthPct < 0) healthPct = 0;
    if (healthPct > 100) healthPct = 100;
    var healthColor = healthPct >= 75 ? "#22C55E" : (healthPct >= 40 ? "#F59E0B" : "#EF4444");
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

