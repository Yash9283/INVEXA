                <span class="ix-tag"><b>@Model.TotalSales</b> sales</span>
                <span class="ix-tag"><b>₹@Model.TotalRevenue.ToString("N0")</b> revenue</span>
                <span class="ix-tag k-warn"><b>@Model.LowStockCount</b> low stock</span>
            </div>
        </div>
        <div class="ix-hero-art">
            <img src="~/Images/dashboard-hero.png" alt="Inventory analytics and packaged products" />
        </div>
    </div>

    <div class="ix-card ix-health">
        <canvas id="speedoCanvas" width="160" height="100"></canvas>
        <div class="speedo-val" id="speedoVal">0%</div>
        <div class="speedo-lbl">Inventory Health</div>
    </div>
    </div>

    <!-- ===== KPI CARDS ===== -->
    <div class="row g-3">
        <div class="col-xl-3 col-md-6">
            <div class="ix-card ix-kpi kpi-revenue">
                <div class="k-top">
                    <span class="k-lbl">Total Revenue</span>
                    <span class="k-ico" style="background:rgba(34,197,94,.15);color:#22C55E"><i class="bi bi-currency-rupee"></i></span>
                </div>
                <div class="k-val">₹@Model.TotalRevenue.ToString("N0")</div>
                <div class="k-sub k-warn">₹@Model.UnpaidAmount.ToString("N0") pending</div>
                <canvas id="spark1"></canvas>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ix-card ix-kpi kpi-products">
                <div class="k-top">
                    <span class="k-lbl">Total Products</span>
                    <span class="k-ico" style="background:rgba(124,58,237,.15);color:#a78bfa"><i class="bi bi-box-seam"></i></span>
                </div>
                <div class="k-val">@Model.TotalProducts</div>
                <div class="k-sub k-mut">₹@Model.TotalStockValue.ToString("N0") stock value</div>
                <canvas id="spark2"></canvas>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ix-card ix-kpi kpi-sales">
                <div class="k-top">
                    <span class="k-lbl">Total Sales</span>
                    <span class="k-ico" style="background:rgba(59,130,246,.15);color:#60a5fa"><i class="bi bi-graph-up-arrow"></i></span>
                </div>
                <div class="k-val">@Model.TotalSales</div>
                <div class="k-sub @(salesMoM >= 0 ? "k-up" : "k-down")">
                    <i class="bi @(salesMoM >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                    @salesMoM.ToString("0.0")% vs last month
                </div>
                <canvas id="spark3"></canvas>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ix-card ix-kpi kpi-low-stock">
                <div class="k-top">
                    <span class="k-lbl">Low Stock Items</span>
                    <span class="k-ico" style="background:rgba(239,68,68,.15);color:#f87171"><i class="bi bi-exclamation-triangle"></i></span>
                </div>
                <div class="k-val">@Model.LowStockCount</div>
                <div class="k-sub @(Model.OutOfStockCount > 0 ? "k-down" : "k-mut")">@Model.OutOfStockCount out of stock</div>
                <canvas id="spark4"></canvas>
            </div>
        </div>
    </div>

    <!-- ===== QUICK ACTIONS ===== -->
    <div class="row g-3 mt-1">
        <div class="col-6 col-md-3">
            <a class="ix-qa" asp-controller="Product" asp-action="Create">
                <i class="bi bi-plus-lg" style="background:linear-gradient(135deg,#7C3AED,#6d28d9)"></i> Add Product
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a class="ix-qa" asp-controller="Sales" asp-action="Create">
                <i class="bi bi-cart-plus" style="background:linear-gradient(135deg,#3b82f6,#2563eb)"></i> New Sale
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a class="ix-qa" asp-controller="Supplier" asp-action="Create">
                <i class="bi bi-truck" style="background:linear-gradient(135deg,#22C55E,#16a34a)"></i> Add Supplier
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a class="ix-qa" asp-controller="Invoice" asp-action="Create">
                <i class="bi bi-receipt" style="background:linear-gradient(135deg,#F59E0B,#d97706)"></i> Create Invoice
            </a>
        </div>
    </div>

    <!-- ===== MINI STATS ===== -->
    <div class="row g-3 mt-1">
        <div class="col-6 col-md-3"><div class="ix-card ix-mini"><div class="m-ico" style="background:linear-gradient(135deg,#f472b6,#db2777)"><i class="bi bi-receipt-cutoff"></i></div><div><div class="m-val">@Model.TotalInvoices</div><div class="m-lbl">Invoices</div></div></div></div>
        <div class="col-6 col-md-3"><div class="ix-card ix-mini"><div class="m-ico" style="background:linear-gradient(135deg,#2dd4bf,#0d9488)"><i class="bi bi-tags"></i></div><div><div class="m-val">@Model.TotalCategories</div><div class="m-lbl">Categories</div></div></div></div>
        <div class="col-6 col-md-3"><div class="ix-card ix-mini"><div class="m-ico" style="background:linear-gradient(135deg,#818cf8,#4f46e5)"><i class="bi bi-truck"></i></div><div><div class="m-val">@Model.TotalSuppliers</div><div class="m-lbl">Suppliers</div></div></div></div>
        <div class="col-6 col-md-3"><div class="ix-card ix-mini"><div class="m-ico" style="background:linear-gradient(135deg,#34d399,#059669)"><i class="bi bi-check2-circle"></i></div><div><div class="m-val">@Model.PaidCount</div><div class="m-lbl">Paid invoices</div></div></div></div>
    </div>

    <!-- ===== MAIN GRID (balanced, space-filled) ===== -->
    <div class="row g-3 mt-1">
        <div class="col-lg-8">
            <div class="ix-card ix-p h-100">
                <div class="ix-ph">Sales Trend (by month)</div>
                <div class="ix-pb"><canvas id="salesChart" height="130"></canvas></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ix-card ix-p h-100">
                <div class="ix-ph">Low Stock Alerts <a asp-controller="Stock" asp-action="Index">View all</a></div>
                <div class="ix-pb pt-2">
                    @if (Model.LowStockProducts.Any())
                    {
                        foreach (var p in Model.LowStockProducts.Take(5))
                        {
                            <div class="ix-row">
                                <div class="r-ico" style="background:linear-gradient(135deg,#f87171,#dc2626)">@if (!string.IsNullOrEmpty(p.ImageUrl)) { <img src="@p.ImageUrl" alt="@p.ProductName" /> } else { <i class="bi bi-box"></i> }</div>
                                <div class="flex-grow-1">
                                    <div class="r-name">@p.ProductName</div>
                                    <div class="r-sub">
                                        @if (p.Quantity == 0)
                                        {
                                            <span class="ix-badge b-danger">Out of stock</span>
                                        }
                                        else
                                        {

                                            <span class="ix-badge b-warn">@p.Quantity left</span>
                                        }
                                    </div>
                                </div>
                                <a class="ix-restock" asp-controller="PurchaseOrder" asp-action="Create" asp-route-productId="@p.Id" asp-route-quantity="@p.ReorderQuantity">Restock</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="ix-empty">No stock alerts &#127881;</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-4">
            <div class="ix-card ix-p h-100">
                <div class="ix-ph">Top Selling Products</div>
                <div class="ix-pb"><canvas id="topChart" height="200"></canvas></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ix-card ix-p h-100">
                <div class="ix-ph">Products by Category</div>
                <div class="ix-pb">
                    <canvas id="categoryChart" height="170"></canvas>
                    <div class="mt-2">
                        @for (int i = 0; i < Model.CategoryNames.Count && i < 6; i++)
                        {
                            var pct = catTotal == 0 ? 0 : Model.CategoryCounts[i] * 100 / catTotal;
                            <div class="ix-leg">
                                <span class="l"><span class="dot" style="background:@(new[] { "#7C3AED", "#22C55E", "#3b82f6", "#F59E0B", "#ec4899", "#14b8a6" }[i % 6])"></span>@Model.CategoryNames[i]</span>
                                <span>@Model.CategoryCounts[i] (@pct%)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ix-card ix-p h-100">
                <div class="ix-ph">Invoice Payment Status</div>
                <div class="ix-pb">
                    <canvas id="paymentChart" height="170"></canvas>
                    <div class="mt-2">
                        <div class="ix-leg">
                            <span class="l"><span class="dot" style="background:#22C55E"></span>Paid</span>
                            <span>@Model.PaidCount (@(payTotal == 0 ? 0 : Model.PaidCount * 100 / payTotal)%)</span>
                        </div>
                        <div class="ix-leg">
                            <span class="l"><span class="dot" style="background:#F59E0B"></span>Unpaid</span>
                            <span>@Model.UnpaidCount (@(payTotal == 0 ? 0 : Model.UnpaidCount * 100 / payTotal)%)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="ix-card ix-p">
                <div class="ix-ph">Recent Activity <a asp-controller="Invoice" asp-action="Index">View all</a></div>
                <div class="ix-pb pt-2">
                    @if (Model.RecentInvoices.Any())
                    {
                        <div class="row g-2">
                            @foreach (var inv in Model.RecentInvoices.Take(6))
                            {
                                var paid = inv.PaymentStatus == "Paid";
                                <div class="col-md-6">
                                    <div class="ix-tl-item">
                                        <div class="ix-tl-ico" style="background:@(paid ? "linear-gradient(135deg,#22C55E,#16a34a)" : "linear-gradient(135deg,#F59E0B,#d97706)")"><i class="bi bi-receipt"></i></div>
                                        <div class="flex-grow-1">
                                            <div class="ix-tl-title">Invoice @inv.InvoiceNumber</div>
                                            <div class="ix-tl-sub">@inv.CustomerName &#8226; &#8377;@inv.TotalAmount.ToString("N0") &#8226; @inv.PaymentStatus</div>
                                        </div>
                                        <div class="ix-tl-time">@inv.InvoiceDate.ToLocalTime().ToString("dd MMM")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ix-empty">No recent activity yet</div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Dashboard charts use live data, with small demo values so empty databases still look useful.
    const salesMonths = @Html.Raw(JsonSerializer.Serialize(Model.SalesMonths));
    const salesTotals = @Html.Raw(JsonSerializer.Serialize(Model.SalesTotals));
    const catNames = @Html.Raw(JsonSerializer.Serialize(Model.CategoryNames));
    const catCounts = @Html.Raw(JsonSerializer.Serialize(Model.CategoryCounts));
    const topNames = @Html.Raw(JsonSerializer.Serialize(Model.TopProductNames));
    const topQty = @Html.Raw(JsonSerializer.Serialize(Model.TopProductQty));
    const paidCount = @Model.PaidCount;
    const unpaidCount = @Model.UnpaidCount;

    const fallbackSales = [12, 21, 14, 27, 19, 31];
    const trendLabels = salesMonths.length ? salesMonths : ['Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'];
    const trendData = salesTotals.length ? salesTotals : fallbackSales;
    const chartPalette = ['#7c3aed', '#22c55e', '#3b82f6', '#f59e0b', '#ec4899', '#14b8a6'];

    Chart.defaults.color = '#94a3b8';
    Chart.defaults.borderColor = 'rgba(255,255,255,.08)';

    function spark(id, data, color) {
        new Chart(document.getElementById(id), {
            type: 'line',
            data: { labels: data.map(() => ''), datasets: [{ data, borderColor: color, backgroundColor: color.replace(')', ', .14)').replace('rgb', 'rgba'), fill: true, tension: .42, pointRadius: 0, borderWidth: 2 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false } } }
        });
    }

    spark('spark1', trendData, 'rgb(74, 222, 128)');
    spark('spark2', [2, 4, 3, 6, 5, 8], 'rgb(250, 204, 21)');
    spark('spark3', trendData, 'rgb(96, 165, 250)');
    spark('spark4', [4, 7, 5, 9, 6, 8], 'rgb(251, 113, 133)');

    new Chart(document.getElementById('salesChart'), {
        type: 'line',
        data: { labels: trendLabels, datasets: [{ label: 'Sales', data: trendData, borderColor: '#8b5cf6', backgroundColor: 'rgba(124,58,237,.20)', fill: true, tension: .38, pointRadius: 3, pointBackgroundColor: '#a78bfa', pointBorderWidth: 0 }] },
        options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { maxTicksLimit: 4 } }, x: { grid: { display: false } } } }
    });

    new Chart(document.getElementById('topChart'), {
        type: 'bar',
        data: { labels: topNames.length ? topNames : ['Product A', 'Product B', 'Product C'], datasets: [{ data: topQty.length ? topQty : [12, 8, 5], backgroundColor: '#8b5cf6', borderRadius: 6 }] },
        options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true }, x: { grid: { display: false } } } }
    });

    new Chart(document.getElementById('categoryChart'), {
        type: 'doughnut',
        data: { labels: catNames.length ? catNames : ['Products'], datasets: [{ data: catCounts.length ? catCounts : [1], backgroundColor: catCounts.length ? chartPalette : ['#7c3aed'], borderWidth: 0 }] },
        options: { responsive: true, cutout: '64%', plugins: { legend: { display: false } } }
    });

    new Chart(document.getElementById('paymentChart'), {
        type: 'doughnut',
        data: { labels: ['Paid', 'Unpaid'], datasets: [{ data: (paidCount + unpaidCount) ? [paidCount, unpaidCount] : [1, 1], backgroundColor: ['#22c55e', '#f59e0b'], borderWidth: 0 }] },
        options: { responsive: true, cutout: '64%', plugins: { legend: { display: false } } }
    });

    /* ── COUNT-UP ANIMATION ── */
    function countUp(el, target, duration, prefix, suffix) {
        prefix = prefix || ''; suffix = suffix || '';
        var startTime = null;
        var isRupee = prefix === '₹';
        function step(timestamp) {
            if (!startTime) startTime = timestamp;
            var progress = Math.min((timestamp - startTime) / duration, 1);
            // ease out cubic
            var ease = 1 - Math.pow(1 - progress, 3);
            var current = Math.floor(ease * target);
            if (isRupee) {
                el.textContent = '₹' + current.toLocaleString('en-IN') + suffix;
            } else {
                el.textContent = prefix + current.toLocaleString('en-IN') + suffix;
            }
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = prefix + target.toLocaleString('en-IN') + suffix;
        }
        requestAnimationFrame(step);
    }

    // KPI .k-val elements
    document.querySelectorAll('.k-val').forEach(function (el) {
        var raw = el.textContent.trim();
        var prefix = '';
        if (raw.startsWith('₹')) { prefix = '₹'; raw = raw.slice(1); }
        var num = parseInt(raw.replace(/[^0-9]/g, '')) || 0;
        if (num > 0) {
            el.style.display = 'block';
            el.textContent = prefix + '0';
            countUp(el, num, 1600, prefix, '');
        }
    });

    // hero tags
    document.querySelectorAll('.ix-tag b').forEach(function (el) {
        var raw = el.textContent.trim();
        var prefix = raw.startsWith('₹') ? '₹' : '';
        if (prefix) raw = raw.slice(1);
        var num = parseInt(raw.replace(/[^0-9]/g, '')) || 0;
        if (num > 0) {
            el.style.display = 'inline-block';
            el.textContent = prefix + '0';
            countUp(el, num, 1400, prefix, '');
        }
    });

    // mini stat vals
    document.querySelectorAll('.m-val').forEach(function (el) {
        var num = parseInt(el.textContent.replace(/[^0-9]/g, '')) || 0;
        if (num > 0) {
            el.style.display = 'block';
            el.textContent = '0';
            countUp(el, num, 1200, '', '');
        }
    });

    /* ── SPEEDOMETER ── */
    (function () {
        var target = @healthPct;
        var healthColor = target >= 75 ? '#22C55E' : (target >= 40 ? '#F59E0B' : '#EF4444');
        var canvas = document.getElementById('speedoCanvas');
        var ctx = canvas.getContext('2d');
        var valEl = document.getElementById('speedoVal');
        var current = 0;
        var W = canvas.width, H = canvas.height;
        var cx = W / 2, cy = H - 10;
        var R = 68;

        function drawSpeedo(pct) {
            ctx.clearRect(0, 0, W, H);
            var startAngle = Math.PI;        // 180° = left
            var endAngle   = 2 * Math.PI;    // 360° = right

            // track
            ctx.beginPath();
            ctx.arc(cx, cy, R, startAngle, endAngle);
            ctx.strokeStyle = 'rgba(255,255,255,.1)';
            ctx.lineWidth = 14;
            ctx.lineCap = 'round';
            ctx.stroke();

            // filled arc
            var fillEnd = startAngle + (pct / 100) * Math.PI;
            ctx.beginPath();
            ctx.arc(cx, cy, R, startAngle, fillEnd);
            ctx.strokeStyle = healthColor;
            ctx.lineWidth = 14;
            ctx.lineCap = 'round';
            ctx.shadowColor = healthColor;
            ctx.shadowBlur = 16;
            ctx.stroke();
            ctx.shadowBlur = 0;

            // needle
            var angle = startAngle + (pct / 100) * Math.PI;
            var nx = cx + (R) * Math.cos(angle);
            var ny = cy + (R) * Math.sin(angle);
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(nx, ny);
            ctx.strokeStyle = '#fff';
            ctx.lineWidth = 2.5;
            ctx.lineCap = 'round';
            ctx.shadowColor = '#fff';
            ctx.shadowBlur = 8;
            ctx.stroke();
            ctx.shadowBlur = 0;

            // center dot
            ctx.beginPath();
            ctx.arc(cx, cy, 5, 0, 2 * Math.PI);
            ctx.fillStyle = '#fff';
            ctx.fill();

            // labels
            ctx.font = '600 9px Inter, sans-serif';
            ctx.fillStyle = 'rgba(255,255,255,.45)';
            ctx.textAlign = 'center';
            ctx.fillText('0', cx - R - 6, cy + 4);
            ctx.fillText('100', cx + R + 10, cy + 4);
            ctx.fillText('50', cx, cy - R - 8);
        }

        function animate() {
            if (current < target) {
                current = Math.min(current + 1.2, target);
                drawSpeedo(current);
                valEl.textContent = Math.floor(current) + '%';
                requestAnimationFrame(animate);
            } else {
                drawSpeedo(target);
                valEl.textContent = target + '%';
            }
        }
        drawSpeedo(0);
        setTimeout(animate, 300);
    })();
</script>
