@model List<StockFlow.Models.Notification>
@using Microsoft.AspNetCore.Http
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Notifications";
    var activeCategory = ViewBag.ActiveCategory as string ?? "All";
    var role = Context.Session.GetString("Role");

    var categories = new (string Key, string Label, string Icon, bool AdminOnly)[]
    {
        ("All",       "All",       "bi-bell",                 false),
        ("Inventory", "Inventory", "bi-boxes",                false),
        ("Alerts",    "Alerts",    "bi-exclamation-triangle", false),
        ("Account",   "Account",   "bi-person-lock",          false),
        ("Staff",     "Users",     "bi-people",               true),
        ("Supplier",  "Supplier",  "bi-truck",                true),
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-bell me-2"></i>Notifications</h4>
        <p class="text-muted mb-0" style="font-size:14px;">
            @ViewBag.UnreadCount unread notification@(ViewBag.UnreadCount == 1 ? "" : "s")
        </p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-primary btn-sm">
                <i class="bi bi-check2-all me-1"></i>Mark All Read
            </button>
        </form>
        <form asp-action="ClearAll" method="post"
              onsubmit="return confirm('Clear all notifications? This cannot be undone.');">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash me-1"></i>Clear All
            </button>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Category tabs -->
<ul class="nav nav-tabs mb-4">
    @foreach (var cat in categories)
    {
        if (cat.AdminOnly && role != "Admin") continue;
        <li class="nav-item">
            <a class="nav-link @(activeCategory == cat.Key ? "active" : "")"
               asp-action="Index" asp-route-category="@cat.Key">
                <i class="bi @cat.Icon me-1"></i>@cat.Label
            </a>
        </li>
    }
</ul>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-bell-slash" style="font-size:3rem;"></i>
        <p class="mt-3">No notifications in this category.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm" style="border-radius:16px;overflow:hidden;">
        <div class="list-group list-group-flush">
            @foreach (var n in Model)
            {
                string badgeStyle = n.Category switch {
                    "Alerts"    => "background:rgba(239,68,68,.15);color:#ef4444;",
                    "Inventory" => "background:rgba(79,70,229,.15);color:#6366f1;",
                    "Account"   => "background:rgba(107,114,128,.15);color:#6b7280;",
                    "Staff"     => "background:rgba(34,197,94,.15);color:#22c55e;",
                    "Supplier"  => "background:rgba(245,158,11,.15);color:#f59e0b;",
                    _           => "background:rgba(6,182,212,.15);color:#06b6d4;"
                };
                string catIcon = n.Category switch {
                    "Alerts"    => "bi-exclamation-triangle",
                    "Inventory" => "bi-boxes",
                    "Account"   => "bi-person-lock",
                    "Staff"     => "bi-people",
                    "Supplier"  => "bi-truck",
                    _           => "bi-bell"
                };

                <div class="list-group-item @(!n.IsRead ? "fw-semibold" : "text-muted")
                            d-flex align-items-start gap-3 py-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:38px;height:38px;background:rgba(99,102,241,.1)">
                        <i class="bi @catIcon" style="font-size:16px;color:#6366f1;"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start">
                            <span style="font-size:14px;">@n.Message</span>
                            @if (!n.IsRead)
                            {
                                <span class="badge rounded-pill bg-primary ms-2 flex-shrink-0"
                                      style="font-size:10px;">New</span>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <span class="badge" style="@badgeStyle font-size:11px;padding:3px 8px;border-radius:6px;">
                                @n.Category
                            </span>
                            <small class="text-muted" style="font-size:12px;">
                                @n.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </small>
                        </div>
                    </div>
                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" class="flex-shrink-0">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-secondary" title="Mark as read">
                                <i class="bi bi-check2"></i>
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
}
