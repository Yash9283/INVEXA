@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="split-wrap">

    <div class="scene-panel">
        <video autoplay muted loop playsinline>
            <source src="~/videos/login-bg.mp4" type="video/mp4" />
        </video>
        <div class="scene-fade"></div>
    </div>

    <div class="form-panel">
        <div class="panel-grid"></div>
        <div class="form-wrap">

            <div class="brand-logo">
                <img src="~/images/invexa-logo.jpg" alt="Invexa" />
            </div>

            <div class="welcome-block">
                <h2>FORGOT PASSWORD</h2>
                <p>Enter your username to begin password reset</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-danger">@ViewBag.Error</div>
            }

            <form asp-action="ForgotPassword" method="post">

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-person-fill"></i></span>
                    <input type="text" name="username"
                           placeholder="Username"
                           class="form-control"
                           autocomplete="username"
                           required />
                </div>

                <button type="submit" class="login-btn">
                    <i class="bi bi-arrow-right"></i>
                    <span>CONTINUE</span>
                </button>

            </form>

            <p class="register-text">
                <a asp-action="Login">
                    <i class="bi bi-arrow-left"></i> Back to Login
                </a>
            </p>

        </div>
    </div>

</div>
