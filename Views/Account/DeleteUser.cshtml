@model StockFlow.Models.Admin
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete User";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Delete User</h4>
    <a asp-action="Users" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Users
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:480px;border-radius:16px;overflow:hidden;">
    <div class="card-body p-4">

        <div class="alert alert-danger d-flex gap-2 align-items-start mb-4">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div>
                <strong>This action cannot be undone.</strong><br/>
                Are you sure you want to delete this account?
            </div>
        </div>

        <div class="d-flex align-items-center gap-3 mb-4 p-3"
             style="background:rgba(239,68,68,.06);border-radius:12px;">
            <div style="width:44px;height:44px;border-radius:11px;
                        background:linear-gradient(135deg,#6366f1,#8b5cf6);
                        display:flex;align-items:center;justify-content:center;
                        color:#fff;font-weight:700;font-size:17px;">
                @char.ToUpper(Model.Username[0])
            </div>
            <div>
                <div class="fw-semibold">@Model.Username</div>
                <div class="text-muted" style="font-size:12px;">
                    @(Model.Role == "Admin" ? "Administrator" : "User") · ID #@Model.Id
                </div>
            </div>
        </div>

        <form asp-action="DeleteUser" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>Yes, Delete
                </button>
                <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>

    </div>
</div>
