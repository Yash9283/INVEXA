@model StockFlow.Models.Admin
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

<div class="split-wrap">

    <!-- ============ LEFT: your uploaded video, playing on loop ============ -->
    <div class="scene-panel">
        <video autoplay muted loop playsinline>
            <source src="~/videos/login-bg.mp4" type="video/mp4" />
        </video>
        <div class="scene-fade"></div>
    </div>

    <!-- ============ RIGHT: login form ============ -->
    <div class="form-panel">
        <div class="panel-grid"></div>
        <div class="form-wrap">
            <div class="brand-logo">
                <img src="~/images/invexa-logo.jpg" alt="Invexa" />
            </div>

            <div class="welcome-block">
                <h2>WELCOME BACK</h2>
                <p>Select your access level to continue</p>
            </div>

            <!-- Login type toggle -->
            <div class="login-tabs">
                <button type="button" class="login-tab active" data-tab="user">
                    <i class="bi bi-person"></i> User
                </button>
                <button type="button" class="login-tab" data-tab="admin">
                    <i class="bi bi-shield-lock"></i> Admin
                </button>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-danger">
                    @ViewBag.Error
                </div>
            }

            <!-- USER FORM — targets Login POST -->
            <form asp-controller="Account" asp-action="Login" method="post"
                id="userForm" class="login-form">

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-person-fill"></i></span>
                    <input asp-for="Username" placeholder="Username" class="form-control"
                        autocomplete="username" />
                </div>

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="Password" type="password" placeholder="Password"
                        class="form-control" id="passwordInputUser" autocomplete="current-password" />
                    <button type="button" class="toggle-eye" onclick="togglePwd('passwordInputUser',this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <button type="submit" class="login-btn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>LOGIN</span>
                </button>

            </form>

            <!-- ADMIN FORM — targets AdminLogin POST -->
            <form asp-controller="Account" asp-action="AdminLogin" method="post"
                id="adminForm" class="login-form" style="display:none;">

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-person-fill"></i></span>
                    <input name="Username" placeholder="Admin Username" class="form-control"
                        autocomplete="username" />
                </div>

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-lock-fill"></i></span>
                    <input name="Password" type="password" placeholder="Password"
                        class="form-control" id="passwordInputAdmin" autocomplete="current-password" />
                    <button type="button" class="toggle-eye" onclick="togglePwd('passwordInputAdmin',this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <button type="submit" class="login-btn btn-admin">
                    <i class="bi bi-shield-lock"></i>
                    <span>LOGIN AS ADMIN</span>
                </button>

            </form>

            <div id="registerRow">
                <p class="register-text">
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Register">Register here</a>
                </p>
            </div>
            <p class="register-text">
                <a asp-action="ForgotPassword">Forgot your password?</a>
            </p>
        </div>
    </div>
</div>

<script>
    // ── Determine which tab to activate on load ───────────────
    // If AdminLogin POST returned an error, ViewBag.ActiveTab == "admin"
    var initialTab = '@(ViewBag.ActiveTab ?? "user")';

    var tabs        = document.querySelectorAll('.login-tab');
    var userForm    = document.getElementById('userForm');
    var adminForm   = document.getElementById('adminForm');
    var registerRow = document.getElementById('registerRow');

    function activateTab(role) {
        tabs.forEach(function(t) {
            t.classList.toggle('active', t.getAttribute('data-tab') === role);
        });
        if (role === 'admin') {
            userForm.style.display    = 'none';
            adminForm.style.display   = '';
            registerRow.style.display = 'none';
        } else {
            userForm.style.display    = '';
            adminForm.style.display   = 'none';
            registerRow.style.display = '';
        }
    }

    // Apply initial tab (handles error redirect back to admin tab)
    activateTab(initialTab);

    // Tab click handler
    tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
            activateTab(this.getAttribute('data-tab'));
        });
    });

    // ── Password toggle (shared) ──────────────────────────────
    function togglePwd(inputId, btn) {
        var input = document.getElementById(inputId);
        var icon  = btn.querySelector('i');
        if (input.type === 'password') {
            input.type    = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type    = 'password';
            icon.className = 'bi bi-eye';
        }
    }

    // ── Submit feedback ───────────────────────────────────────
    [userForm, adminForm].forEach(function(form) {
        form.addEventListener('submit', function() {
            var btn      = this.querySelector('.login-btn');
            var span     = btn.querySelector('span');
            span.textContent  = 'SIGNING IN...';
            btn.disabled = true;
        });
    });

    // ── Click ripple ──────────────────────────────────────────
    document.querySelectorAll('.login-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            var rect   = btn.getBoundingClientRect();
            var ripple = document.createElement('span');
            var size   = Math.max(rect.width, rect.height);
            ripple.className      = 'ripple';
            ripple.style.width    = ripple.style.height = size + 'px';
            ripple.style.left     = (e.clientX - rect.left - size / 2) + 'px';
            ripple.style.top      = (e.clientY - rect.top  - size / 2) + 'px';
            btn.appendChild(ripple);
            setTimeout(function() { ripple.remove(); }, 650);
        });
    });
</script>
