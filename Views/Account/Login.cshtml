@model StockFlow.Models.Admin
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

<style>
.login-tab {
    text-transform: uppercase; letter-spacing: .6px;
    color: #c7d0e8 !important;
    background: rgba(255,255,255,.03) !important;
    border: 1px solid rgba(139,92,246,.22) !important;
    position: relative;
}
.login-tab i { color: #a78bfa !important; }
.login-tab:hover { border-color: rgba(168,85,247,.5) !important; color: #fff !important; }
.login-tab.active {
    color: #fff !important;
    background: linear-gradient(135deg, #7c3aed, #a855f7) !important;
    border-color: transparent !important;
    box-shadow: 0 8px 26px rgba(124,58,237,.55) !important;
}
.login-tab.active i { color: #fff !important; }
.login-tab.active::after {
    content: ""; position: absolute; bottom: -6px; left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 13px; height: 13px; background: #a855f7; border-radius: 2px;
}

.login-form {
    background: rgba(24,18,46,.5) !important;
    border: 1px solid rgba(139,92,246,.28) !important;
    border-radius: 18px !important;
    padding: 20px 18px !important;
    box-shadow: 0 16px 44px rgba(2,6,23,.55), inset 0 1px 0 rgba(255,255,255,.05) !important;
    backdrop-filter: blur(12px); margin-top: 6px;
}

.input-group-custom {
    background: rgba(255,255,255,.04) !important;
    border: 1px solid rgba(139,92,246,.28) !important;
}
.input-group-custom:focus-within {
    border-color: rgba(168,85,247,.75) !important;
    box-shadow: 0 0 0 3px rgba(139,92,246,.20), 0 0 22px rgba(139,92,246,.15) !important;
}
.input-group-custom .icon-tab { background: rgba(139,92,246,.16) !important; }
.input-group-custom .icon-tab i { color: #c4b5fd !important; }
.input-group-custom input { color: #ffffff !important; }
.input-group-custom input::placeholder { color: rgba(255,255,255,.42) !important; }
.input-group-custom .toggle-eye:hover { color: #c4b5fd !important; }

.login-btn {
    background: linear-gradient(90deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%) !important;
    box-shadow: 0 10px 30px rgba(139,92,246,.5) !important;
}
.login-btn:hover { box-shadow: 0 16px 42px rgba(236,72,153,.5), 0 0 60px rgba(139,92,246,.25) !important; }
.login-btn.btn-admin {
    background: linear-gradient(90deg, #7c3aed 0%, #a855f7 50%, #d946ef 100%) !important;
    box-shadow: 0 10px 30px rgba(168,85,247,.5) !important;
}
.login-btn.btn-supplier {
    background: linear-gradient(90deg, #2563eb 0%, #6366f1 50%, #8b5cf6 100%) !important;
    box-shadow: 0 10px 30px rgba(99,102,241,.5) !important;
}

.register-text a { color: #60a5fa !important; }
#registerRow .register-text a { color: #ec4899 !important; }
.register-text a:hover { color: #ffffff !important; }

.login-footer { text-align: center; color: rgba(255,255,255,.34); font-size: 12px; letter-spacing: .3px; margin-top: 22px; }
.brand-logo img { mix-blend-mode: normal !important; width: 255px !important; }
</style>

<div class="split-wrap">

    <!-- ============ LEFT: your uploaded video, playing on loop ============ -->
    <div class="scene-panel">
        <video autoplay muted loop playsinline>
            <source src="~/videos/login-bg.mp4" type="video/mp4" />
        </video>
        <div class="scene-fade"></div>
    </div>

    <!-- ============ RIGHT: login form ============ -->
    <div class="form-panel">
        <div class="panel-grid"></div>
        <div class="form-wrap">
            <div class="brand-logo">
                <img src="~/images/invexa-logo.png" alt="Invexa" asp-append-version="true" />
            </div>

            <div class="welcome-block">
                <h2>WELCOME BACK</h2>
                <p>Select your access level to continue</p>
            </div>

            <!-- Login type toggle -->
            <div class="login-tabs">
                <button type="button" class="login-tab active" data-tab="user">
                    <i class="bi bi-person"></i> Employee
                </button>
                <button type="button" class="login-tab" data-tab="supplier">
                    <i class="bi bi-truck"></i> Supplier
                </button>
                <button type="button" class="login-tab" data-tab="admin">
                    <i class="bi bi-shield-lock"></i> Admin
                </button>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-danger">
                    @ViewBag.Error
                </div>
            }

            <!-- USER FORM — targets Login POST -->
            <form asp-controller="Account" asp-action="Login" method="post"
                id="userForm" class="login-form">

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-person-fill"></i></span>
                    <input asp-for="Username" placeholder="Username" class="form-control"
                        autocomplete="username" />
                </div>

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="Password" type="password" placeholder="Password"
                        class="form-control" id="passwordInputUser" autocomplete="current-password" />
                    <button type="button" class="toggle-eye" onclick="togglePwd('passwordInputUser',this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <button type="submit" class="login-btn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>LOGIN</span>
                </button>

            </form>

            <!-- SUPPLIER FORM — supplier accounts only -->
            <form asp-controller="Account" asp-action="SupplierLogin" method="post"
                id="supplierForm" class="login-form" style="display:none;">

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-truck"></i></span>
                    <input name="Username" placeholder="Supplier Username" class="form-control"
                        autocomplete="username" />
                </div>

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-lock-fill"></i></span>
                    <input name="Password" type="password" placeholder="Password"
                        class="form-control" id="passwordInputSupplier" autocomplete="current-password" />
                    <button type="button" class="toggle-eye" onclick="togglePwd('passwordInputSupplier',this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <button type="submit" class="login-btn btn-supplier">
                    <i class="bi bi-truck"></i>
                    <span>LOGIN AS SUPPLIER</span>
                </button>

            </form>

            <!-- ADMIN FORM — targets AdminLogin POST -->
            <form asp-controller="Account" asp-action="AdminLogin" method="post"
                id="adminForm" class="login-form" style="display:none;">

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-person-fill"></i></span>
                    <input name="Username" placeholder="Admin Username" class="form-control"
                        autocomplete="username" />
                </div>

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-lock-fill"></i></span>
                    <input name="Password" type="password" placeholder="Password"
                        class="form-control" id="passwordInputAdmin" autocomplete="current-password" />
                    <button type="button" class="toggle-eye" onclick="togglePwd('passwordInputAdmin',this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <button type="submit" class="login-btn btn-admin">
                    <i class="bi bi-shield-lock"></i>
                    <span>LOGIN AS ADMIN</span>
                </button>

            </form>

            <div id="registerRow">
                <p class="register-text">
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Register">Register here</a>
                </p>
            </div>
            <p class="register-text">
                <a asp-action="ForgotPassword">Forgot your password?</a>
            </p>
            <p class="login-footer">&copy; 2025 INVEXA. All rights reserved.</p>
        </div>
    </div>
</div>

<script>
    // ── Determine which tab to activate on load ───────────────
    // Keep the role tab active when a login action returns an error.
    var initialTab = '@(ViewBag.ActiveTab ?? "user")';

    var tabs        = document.querySelectorAll('.login-tab');
    var userForm    = document.getElementById('userForm');
    var supplierForm = document.getElementById('supplierForm');
    var adminForm   = document.getElementById('adminForm');
    var registerRow = document.getElementById('registerRow');

    function activateTab(role) {
        tabs.forEach(function(t) {
            t.classList.toggle('active', t.getAttribute('data-tab') === role);
        });
        if (role === 'admin') {
            userForm.style.display    = 'none';
            supplierForm.style.display = 'none';
            adminForm.style.display   = '';
            registerRow.style.display = 'none';
        } else if (role === 'supplier') {
            userForm.style.display    = 'none';
            supplierForm.style.display = '';
            adminForm.style.display   = 'none';
            registerRow.style.display = 'none';
        } else {
            userForm.style.display    = '';
            supplierForm.style.display = 'none';
            adminForm.style.display   = 'none';
            registerRow.style.display = '';
        }
    }

    // Apply initial tab (handles error redirect back to admin tab)
    activateTab(initialTab);

    // Tab click handler
    tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
            activateTab(this.getAttribute('data-tab'));
        });
    });

    // ── Password toggle (shared) ──────────────────────────────
    function togglePwd(inputId, btn) {
        var input = document.getElementById(inputId);
        var icon  = btn.querySelector('i');
        if (input.type === 'password') {
            input.type    = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type    = 'password';
            icon.className = 'bi bi-eye';
        }
    }

    // ── Submit feedback ───────────────────────────────────────
    [userForm, supplierForm, adminForm].forEach(function(form) {
        form.addEventListener('submit', function() {
            var btn      = this.querySelector('.login-btn');
            var span     = btn.querySelector('span');
            span.textContent  = 'SIGNING IN...';
            btn.disabled = true;
        });
    });

    // ── Click ripple ──────────────────────────────────────────
    document.querySelectorAll('.login-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            var rect   = btn.getBoundingClientRect();
            var ripple = document.createElement('span');
            var size   = Math.max(rect.width, rect.height);
            ripple.className      = 'ripple';
            ripple.style.width    = ripple.style.height = size + 'px';
            ripple.style.left     = (e.clientX - rect.left - size / 2) + 'px';
            ripple.style.top      = (e.clientY - rect.top  - size / 2) + 'px';
            btn.appendChild(ripple);
            setTimeout(function() { ripple.remove(); }, 650);
        });
    });
</script>
