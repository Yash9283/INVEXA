@model StockFlow.Models.Admin
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

<div class="split-wrap">

    <!-- ============ LEFT: your uploaded video, playing on loop ============ -->
    <div class="scene-panel">
        <video autoplay muted loop playsinline>
            <source src="~/videos/login-bg.mp4" type="video/mp4" />
        </video>
        <div class="scene-fade"></div>
    </div>

    <!-- ============ RIGHT: login form ============ -->
    <div class="form-panel">
        <div class="panel-grid"></div>
        <div class="form-wrap">
            <div class="brand-logo">
                <img src="~/images/invexa-logo.jpg" alt="Invexa" />
            </div>

            <div class="welcome-block">
                <h2>WELCOME BACK</h2>
                <p>Select your access level to continue</p>
            </div>

            <!-- Login type toggle -->
            <div class="login-tabs">
                <button type="button" class="login-tab active" data-tab="user">
                    <i class="bi bi-person"></i> User
                </button>
                <button type="button" class="login-tab" data-tab="admin">
                    <i class="bi bi-shield-lock"></i> Admin
                </button>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" id="loginForm">

                <!-- hidden role field -->
                <input type="hidden" name="LoginRole" id="loginRole" value="user" />

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-person-fill"></i></span>
                    <input asp-for="Username" placeholder="Username" class="form-control" autocomplete="username" />
                </div>

                <div class="input-group-custom">
                    <span class="icon-tab"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="Password" type="password" placeholder="Password" class="form-control" id="passwordInput" autocomplete="current-password" />
                    <button type="button" class="toggle-eye" id="toggleEye"><i class="bi bi-eye"></i></button>
                </div>

                <button type="submit" class="login-btn" id="loginBtn">
                    <i class="bi bi-box-arrow-in-right" id="loginIcon"></i>
                    <span id="loginBtnText">LOGIN</span>
                </button>
            </form>



            <p class="register-text" id="registerRow">
                Don't have an account?
                <a asp-controller="Account" asp-action="Register">Register here</a>
            </p>
        </div>
    </div>
</div>

<script>
    // ── Tab switcher ──────────────────────────────────────
    var tabs       = document.querySelectorAll('.login-tab');
    var roleInp    = document.getElementById('loginRole');
    var loginBtn   = document.getElementById('loginBtn');
    var loginIcon  = document.getElementById('loginIcon');
    var loginBtnText = document.getElementById('loginBtnText');
    var registerRow  = document.getElementById('registerRow');

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            tabs.forEach(function (t) { t.classList.remove('active'); });
            this.classList.add('active');

            var role = this.getAttribute('data-tab');
            roleInp.value = role;

            if (role === 'admin') {
                loginBtnText.textContent = 'LOGIN AS ADMIN';
                loginIcon.className = 'bi bi-shield-lock';
                loginBtn.classList.add('btn-admin');
                registerRow.style.display = 'none';
            } else {
                loginBtnText.textContent = 'LOGIN';
                loginIcon.className = 'bi bi-box-arrow-in-right';
                loginBtn.classList.remove('btn-admin');
                registerRow.style.display = '';
            }
        });
    });

    // ── Password toggle ───────────────────────────────────
    document.getElementById('toggleEye').addEventListener('click', function () {
        var input = document.getElementById('passwordInput');
        var icon  = this.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    });

    // ── Submit feedback ───────────────────────────────────
    document.getElementById('loginForm').addEventListener('submit', function () {
        loginBtnText.textContent = 'SIGNING IN...';
        loginBtn.disabled = true;
    });

    // ── Click ripple ──────────────────────────────────────
    loginBtn.addEventListener('click', function (e) {
        var rect   = loginBtn.getBoundingClientRect();
        var ripple = document.createElement('span');
        var size   = Math.max(rect.width, rect.height);
        ripple.className      = 'ripple';
        ripple.style.width    = ripple.style.height = size + 'px';
        ripple.style.left     = (e.clientX - rect.left - size / 2) + 'px';
        ripple.style.top      = (e.clientY - rect.top  - size / 2) + 'px';
        loginBtn.appendChild(ripple);
        setTimeout(function () { ripple.remove(); }, 650);
    });
</script>
