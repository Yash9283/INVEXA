@model StockFlow.Models.Admin
@{
    ViewData["Title"] = "Change Credentials";
    Layout = "_AdminLayout";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .cc { margin: -22px -26px 0; padding: 40px 26px; min-height: calc(100vh - 74px);
        --card:#162033; --bd:rgba(255,255,255,.06); --text:#F8FAFC; --sec:#94A3B8; --primary:#7C3AED;
        background:#0F172A; color:var(--text); font-family:'Plus Jakarta Sans',system-ui,sans-serif;
        display:flex; justify-content:center; align-items:flex-start; }
    .cc *, .cc *::before, .cc *::after { box-sizing:border-box; font-family:inherit; }
    .cc-card { width:100%; max-width:520px; background:var(--card); border:1px solid var(--bd);
        border-radius:18px; padding:30px 30px 34px; box-shadow:0 12px 30px rgba(2,6,23,.4); }
    .cc-ico { width:54px; height:54px; border-radius:14px; background:rgba(124,58,237,.15); color:#a78bfa;
        display:grid; place-items:center; font-size:26px; margin-bottom:16px; }
    .cc-card h1 { font-size:22px; font-weight:700; margin:0 0 4px; }
    .cc-card .sub { color:var(--sec); font-size:13.5px; margin:0 0 22px; }
    .cc-label { font-size:13px; font-weight:600; color:var(--sec); margin:16px 0 7px; display:block; }
    .cc-input { width:100%; height:46px; background:#0F172A; border:1px solid var(--bd); border-radius:11px;
        padding:0 14px; color:var(--text); font-size:14px; outline:none; transition:.2s; }
    .cc-input:focus { border-color:rgba(124,58,237,.6); }
    .cc-input::placeholder { color:#5b6b7f; }
    .cc-hint { font-size:11.5px; color:var(--sec); margin-top:5px; }
    .cc-divider { border:0; border-top:1px solid var(--bd); margin:22px 0 4px; }
    .cc-alert { border-radius:11px; padding:11px 14px; font-size:13.5px; margin-bottom:18px; }
    .cc-alert.err { background:rgba(239,68,68,.14); color:#fca5a5; border:1px solid rgba(239,68,68,.3); }
    .cc-actions { display:flex; gap:12px; margin-top:26px; }
    .cc-btn { flex:1; height:46px; border-radius:11px; font-size:14px; font-weight:600; border:none;
        cursor:pointer; display:inline-flex; align-items:center; justify-content:center; gap:8px; text-decoration:none; transition:.2s; }
    .cc-btn.save { background:linear-gradient(135deg,#7C3AED,#6d28d9); color:#fff; }
    .cc-btn.save:hover { opacity:.92; }
    .cc-btn.cancel { background:transparent; border:1px solid var(--bd); color:var(--sec); }
    .cc-btn.cancel:hover { background:rgba(255,255,255,.04); color:var(--text); }
</style>

<div class="cc">
    <div class="cc-card">
        <div class="cc-ico"><i class="bi bi-key"></i></div>
        <h1>Change Username &amp; Password</h1>
        <p class="sub">Change your username and password here..</p>

        @if (ViewBag.Error != null)
        {
            <div class="cc-alert err"><i class="bi bi-exclamation-circle me-1"></i>@ViewBag.Error</div>
        }

        <form asp-action="ChangeCredentials" method="post">
            <label class="cc-label">Current password <span style="color:#f87171">*</span></label>
            <input class="cc-input" type="password" name="currentPassword" placeholder="Enter your current password" autocomplete="current-password" />

            <hr class="cc-divider" />

            <label class="cc-label">New username</label>
            <input class="cc-input" type="text" name="newUsername" value="@Model.Username" autocomplete="off" />
            <div class="cc-hint">Badalna na ho to same rehne dein.</div>

            <label class="cc-label">New password</label>
            <input class="cc-input" type="password" name="newPassword" placeholder="Leave blank to keep current password" autocomplete="new-password" />
            <div class="cc-hint">Kam se kam 8 characters. Password na badalna ho to khaali chhod dein.</div>

            <label class="cc-label">Confirm new password</label>
            <input class="cc-input" type="password" name="confirmPassword" placeholder="Re-enter new password" autocomplete="new-password" />

            <div class="cc-actions">
                <a asp-action="Profile" class="cc-btn cancel">Cancel</a>
                <button type="submit" class="cc-btn save"><i class="bi bi-check2"></i> Save Changes</button>
            </div>
        </form>
    </div>
</div>
