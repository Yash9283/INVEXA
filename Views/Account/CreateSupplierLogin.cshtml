@using System.Linq
@{
    ViewData["Title"] = "Create Supplier Login";
    Layout = "_AdminLayout";
    var suppliers = ViewBag.Suppliers as List<StockFlow.Models.Supplier> ?? new List<StockFlow.Models.Supplier>();
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .cc { margin:-22px -26px 0; padding:40px 26px; min-height:calc(100vh - 74px);
        --card:#162033; --bd:rgba(255,255,255,.06); --text:#F8FAFC; --sec:#94A3B8;
        background:#0F172A; color:var(--text); font-family:'Plus Jakarta Sans',system-ui,sans-serif;
        display:flex; justify-content:center; align-items:flex-start; }
    .cc *, .cc *::before, .cc *::after { box-sizing:border-box; font-family:inherit; }
    .cc-card { width:100%; max-width:540px; background:var(--card); border:1px solid var(--bd);
        border-radius:18px; padding:30px 30px 34px; box-shadow:0 12px 30px rgba(2,6,23,.4); }
    .cc-ico { width:54px; height:54px; border-radius:14px; background:rgba(124,58,237,.15); color:#a78bfa;
        display:grid; place-items:center; font-size:26px; margin-bottom:16px; }
    .cc-card h1 { font-size:22px; font-weight:700; margin:0 0 4px; }
    .cc-card .sub { color:var(--sec); font-size:13.5px; margin:0 0 22px; }
    .cc-label { font-size:13px; font-weight:600; color:var(--sec); margin:16px 0 7px; display:block; }
    .cc-input { width:100%; height:46px; background:#0F172A; border:1px solid var(--bd); border-radius:11px;
        padding:0 14px; color:var(--text); font-size:14px; outline:none; }
    .cc-input:focus { border-color:rgba(124,58,237,.6); }
    select.cc-input { appearance:auto; }
    .cc-hint { font-size:11.5px; color:var(--sec); margin-top:5px; }
    .cc-alert { border-radius:11px; padding:11px 14px; font-size:13.5px; margin-bottom:18px;
        background:rgba(239,68,68,.14); color:#fca5a5; border:1px solid rgba(239,68,68,.3); }
    .cc-actions { display:flex; gap:12px; margin-top:26px; }
    .cc-btn { flex:1; height:46px; border-radius:11px; font-size:14px; font-weight:600; border:none; cursor:pointer;
        display:inline-flex; align-items:center; justify-content:center; gap:8px; text-decoration:none; }
    .cc-btn.save { background:linear-gradient(135deg,#7C3AED,#6d28d9); color:#fff; }
    .cc-btn.cancel { background:transparent; border:1px solid var(--bd); color:var(--sec); }
</style>

<div class="cc">
    <div class="cc-card">
        <div class="cc-ico"><i class="bi bi-truck"></i></div>
        <h1>Create Supplier Login</h1>
        <p class="sub">Create a login for a supplier. They will be able to sign in and view only their own purchase orders.</p>

        @if (ViewBag.Error != null)
        {
            <div class="cc-alert"><i class="bi bi-exclamation-circle me-1"></i>@ViewBag.Error</div>
        }

        <form asp-action="CreateSupplierLogin" method="post">
            <label class="cc-label">Supplier</label>
            <select class="cc-input" name="supplierId" required>
                <option value="">-- Choose a supplier --</option>
                @foreach (var s in suppliers)
                {
                    <option value="@s.Id">@s.SupplierName</option>
                }
            </select>
            @if (!suppliers.Any())
            {
                <div class="cc-hint">First add a supplier (from the Suppliers page), then you can create their login here.</div>
            }

            <label class="cc-label">Username</label>
            <input class="cc-input" type="text" name="username" placeholder="e.g. techgear_supplier" autocomplete="off" />

            <label class="cc-label">Password</label>
            <input class="cc-input" type="password" name="password" placeholder="At least 8 characters" autocomplete="new-password" />
            <div class="cc-hint">Share this username and password with the supplier. They will use it to sign in.</div>

            <div class="cc-actions">
                <a asp-action="Users" class="cc-btn cancel">Cancel</a>
                <button type="submit" class="cc-btn save"><i class="bi bi-plus-lg"></i> Create Login</button>
            </div>
        </form>
    </div>
</div>
