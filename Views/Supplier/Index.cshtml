@model List<StockFlow.Models.Supplier>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Supplier Management</h2>

    @if (Context.Session.GetString("Role") == "Admin")
    {
        <a asp-action="Create" class="btn btn-success">Add New Supplier</a>
    }
</div>

<div class="mb-3" style="max-width:380px;">
    <div class="input-group">
        <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text" id="supplierSearch" class="form-control border-start-0"
               placeholder="Search suppliers..." autocomplete="off" />
    </div>
</div>

<div class="d-flex gap-2 mb-3">
    <a asp-controller="Export" asp-action="SuppliersExcel"
       class="btn btn-sm btn-outline-success">
        <i class="bi bi-file-earmark-excel me-1"></i>Excel
    </a>
    <a asp-controller="Export" asp-action="SuppliersPdf"
       class="btn btn-sm btn-outline-danger">
        <i class="bi bi-file-earmark-pdf me-1"></i>PDF
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Supplier Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody id="supplierTableBody">
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.SupplierName</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <td>
                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
<script>
(function () {
    function norm(s) { return (s || '').toLowerCase().replace(/\s+/g, ''); }
    var input = document.getElementById('supplierSearch');
    var tbody = document.getElementById('supplierTableBody');
    input.addEventListener('input', function () {
        var term = norm(this.value);
        tbody.querySelectorAll('tr').forEach(function (row) {
            // col 1=SupplierName, 2=Email, 3=Phone, 4=Address
            var text = norm(
                (row.cells[1]?.textContent || '') + ' ' +
                (row.cells[2]?.textContent || '') + ' ' +
                (row.cells[3]?.textContent || '')
            );
            row.style.display = !term || text.includes(term) ? '' : 'none';
        });
    });
})();
</script>
}
