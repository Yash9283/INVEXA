@model List<StockFlow.Models.Supplier>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Suppliers";
}

<style>
    /* Background Image with Light Overlay */
    .supplier-page-wrapper {
        position: relative;
        min-height: 100vh;
        padding: 30px;
        margin: -22px -26px;
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    }

    .supplier-page-wrapper::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('/Images/supplier-bg.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        opacity: 0.85;
        filter: brightness(1.3);
        z-index: 0;
        pointer-events: none;
    }
    
    .supplier-page-wrapper::after {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.25) 0%, rgba(15, 23, 42, 0.35) 100%);
        z-index: 0;
        pointer-events: none;
    }

    .supplier-page-wrapper > * {
        position: relative;
        z-index: 2;
    }

    /* Header Section */
    .supplier-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
    }

    .supplier-header-left h1 {
        color: #ffffff;
        font-size: 32px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .supplier-header-left p {
        color: rgba(255, 255, 255, 0.6);
        font-size: 14px;
        margin: 0;
    }

    .btn-add-supplier {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-add-supplier:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
        color: white;
    }

    /* Search and Export Section */
    .controls-section {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
        align-items: center;
    }

    .search-box {
        flex: 1;
        max-width: 400px;
        position: relative;
    }

    .search-box input {
        width: 100%;
        padding: 12px 16px 12px 45px;
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 12px;
        color: rgba(255, 255, 255, 0.95);
        font-size: 14px;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }
        color: white;
        font-size: 14px;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .search-box input::placeholder {
        color: rgba(255, 255, 255, 0.9);
    }

    .search-box input:focus {
        outline: none;
        border-color: #667eea;
        background: rgba(255, 255, 255, 0.12);
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2);
    }

    .search-box i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, 0.5);
    }

    .export-buttons {
        display: flex;
        gap: 10px;
    }

    .btn-export {
        padding: 10px 20px;
        border-radius: 8px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        background: rgba(15, 23, 42, 0.5);
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        backdrop-filter: blur(10px);
    }

    .btn-export:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.5);
        transform: translateY(-2px);
        color: white;
    }

    .btn-export.excel {
        border-color: rgba(16, 185, 129, 0.6);
        color: #6ee7b7;
    }

    .btn-export.excel:hover {
        background: rgba(16, 185, 129, 0.25);
        border-color: #10b981;
        color: #6ee7b7;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

    .btn-export.pdf {
        border-color: rgba(239, 68, 68, 0.6);
        color: #fca5a5;
    }

    .btn-export.pdf:hover {
        background: rgba(239, 68, 68, 0.25);
        border-color: #ef4444;
        color: #fca5a5;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

    /* Glassmorphism Table */
    .supplier-table-container {
        background: transparent !important;
        backdrop-filter: blur(4px) !important;
        border: 2px solid rgba(99, 102, 241, 0.6) !important;
        border-radius: 16px !important;
        padding: 0 !important;
        overflow: hidden !important;
        box-shadow: 0 0 25px rgba(99, 102, 241, 0.4) !important;
    }

    .supplier-table {
        width: 100% !important;
        margin: 0 !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
        background: transparent !important;
    }

    .supplier-table thead {
        background: rgba(99, 102, 241, 0.25) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
    }

    .supplier-table thead th {
        padding: 18px 20px !important;
        color: #ffffff !important;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8) !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.5px !important;
        border: none !important;
        cursor: pointer !important;
        user-select: none !important;
        background: transparent !important;
    }

    .supplier-table thead th i {
        margin-left: 5px !important;
        font-size: 11px !important;
        opacity: 0.6 !important;
    }

    .supplier-table tbody tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        transition: all 0.3s ease !important;
        background: rgba(128, 128, 128, 0.35) !important;
        backdrop-filter: blur(12px) !important;
    }

    .supplier-table tbody tr:hover {
        background: rgba(128, 128, 128, 0.45) !important;
    }

    .supplier-table tbody tr:last-child {
        border-bottom: none !important;
    }

    .supplier-table tbody td {
        padding: 18px 20px !important;
        color: #ffffff !important;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8) !important;
        font-size: 14px !important;
        border: none !important;
        vertical-align: middle !important;
        background: transparent !important;
    }

    /* ID Column */
    .id-cell {
        width: 80px;
        font-weight: 600;
        color: rgba(102, 126, 234, 1);
    }

    /* Supplier Name with Avatar */
    .supplier-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .supplier-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .supplier-avatar i {
        color: white;
        font-size: 18px;
    }

    .supplier-info {
        display: flex;
        flex-direction: column;
    }

    .supplier-info .name {
        font-weight: 500;
        color: white;
        margin-bottom: 2px;
    }

    .supplier-info .status {
        font-size: 11px;
        color: #10b981;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .supplier-info .status::before {
        content: '●';
        font-size: 8px;
    }

    /* Contact Info */
    .contact-cell {
        display: flex;
        align-items: center;
        gap: 8px;
        color: rgba(255, 255, 255, 0.95);
    }

    .contact-cell i {
        color: rgba(102, 126, 234, 0.8);
        font-size: 14px;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-action {
        padding: 8px 16px;
        border-radius: 6px;
        border: 2px solid;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-edit {
        background: rgba(15, 23, 42, 0.5);
        color: #60a5fa;
        border-color: rgba(59, 130, 246, 0.6);
    }

    .btn-edit:hover {
        background: rgba(59, 130, 246, 0.25);
        color: #60a5fa;
        border-color: #3b82f6;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
    }

    .btn-delete {
        background: rgba(15, 23, 42, 0.5);
        color: #f87171;
        border-color: rgba(239, 68, 68, 0.6);
    }

    .btn-delete:hover {
        background: rgba(239, 68, 68, 0.25);
        color: #f87171;
        border-color: #ef4444;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

    /* Pagination */
    .pagination-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        padding: 15px 20px;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .pagination-info {
        color: rgba(255, 255, 255, 0.6);
        font-size: 14px;
    }

    .pagination-controls {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .pagination-btn {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: rgba(15, 23, 42, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: rgba(255, 255, 255, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .pagination-btn:hover:not(.disabled) {
        background: rgba(102, 126, 234, 0.2);
        border-color: #667eea;
        color: white;
    }

    .pagination-btn.active {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: transparent;
        color: white;
    }

    .pagination-btn.disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    /* Alerts */
    .alert {
        padding: 15px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        border: 1px solid;
        backdrop-filter: blur(10px);
    }

    .alert-success {
        background: rgba(16, 185, 129, 0.15);
        border-color: rgba(16, 185, 129, 0.3);
        color: #6ee7b7;
    }

    .alert-danger {
        background: rgba(239, 68, 68, 0.15);
        border-color: rgba(239, 68, 68, 0.3);
        color: #fca5a5;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .supplier-header {
            flex-direction: column;
            gap: 20px;
        }

        .controls-section {
            flex-direction: column;
        }

        .search-box {
            max-width: 100%;
        }

        .supplier-table-container {
            overflow-x: auto;
        }

        .supplier-table {
            min-width: 900px;
        }
    }
</style>

<div class="supplier-page-wrapper">
    <!-- Header -->
    <div class="supplier-header">
        <div class="supplier-header-left">
            <h1>Supplier Management</h1>
        </div>
        @if (Context.Session.GetString("Role") == "Admin")
        {
            <a asp-action="Create" class="btn-add-supplier">
                <i class="bi bi-plus-lg"></i>
                Add New Supplier
            </a>
        }
    </div>

    <!-- Controls Section -->
    <div class="controls-section">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="supplierSearch" placeholder="Search suppliers by name, email, or phone..." autocomplete="off" />
        </div>
        <div class="export-buttons">
            <a asp-controller="Export" asp-action="SuppliersExcel" class="btn-export excel">
                <i class="bi bi-file-earmark-excel"></i>
                Excel
            </a>
            <a asp-controller="Export" asp-action="SuppliersPdf" class="btn-export pdf">
                <i class="bi bi-file-earmark-pdf"></i>
                PDF
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        </div>
    }

    <!-- Table -->
    <div class="supplier-table-container">
        <table class="supplier-table">
            <thead>
                <tr>
                    <th class="id-cell">
                        ID <i class="bi bi-chevron-expand"></i>
                    </th>
                    <th>
                        Supplier Name <i class="bi bi-chevron-expand"></i>
                    </th>
                    <th>
                        Email <i class="bi bi-chevron-expand"></i>
                    </th>
                    <th>
                        Phone <i class="bi bi-chevron-expand"></i>
                    </th>
                    <th>
                        Address <i class="bi bi-chevron-expand"></i>
                    </th>
                    <th style="text-align: center;">Action</th>
                </tr>
            </thead>
            <tbody id="supplierTableBody">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="id-cell">@item.Id</td>
                        <td>
                            <div class="supplier-name-cell">
                                <div class="supplier-avatar">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="supplier-info">
                                    <span class="name">@item.SupplierName</span>
                                    <span class="status">Active</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="contact-cell">
                                <i class="bi bi-envelope"></i>
                                <span>@item.Email</span>
                            </div>
                        </td>
                        <td>
                            <div class="contact-cell">
                                <i class="bi bi-telephone"></i>
                                <span>@item.Phone</span>
                            </div>
                        </td>
                        <td>
                            <div class="contact-cell">
                                <i class="bi bi-geo-alt"></i>
                                <span>@item.Address</span>
                            </div>
                        </td>
                        <td>
                            @if (Context.Session.GetString("Role") == "Admin")
                            {
                                <div class="action-buttons">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit">
                                        <i class="bi bi-pencil"></i>
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-delete">
                                        <i class="bi bi-trash"></i>
                                        Delete
                                    </a>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="pagination-section">
        <div class="pagination-info">
            Showing <span id="currentCount">@Model.Count</span> to @Model.Count of @Model.Count suppliers
        </div>
        <div class="pagination-controls">
            <button class="pagination-btn disabled">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="pagination-btn active">1</button>
            <button class="pagination-btn disabled">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    function norm(s) { return (s || '').toLowerCase().replace(/\s+/g, ''); }
    var input = document.getElementById('supplierSearch');
    var tbody = document.getElementById('supplierTableBody');
    var currentCount = document.getElementById('currentCount');
    
    input.addEventListener('input', function () {
        var term = norm(this.value);
        var visibleCount = 0;
        
        tbody.querySelectorAll('tr').forEach(function (row) {
            var cells = row.cells;
            // Extract text from supplier name (cell 1), email (cell 2), phone (cell 3)
            var nameText = cells[1]?.querySelector('.name')?.textContent || '';
            var emailText = cells[2]?.querySelector('.contact-cell span')?.textContent || '';
            var phoneText = cells[3]?.querySelector('.contact-cell span')?.textContent || '';
            
            var text = norm(nameText + ' ' + emailText + ' ' + phoneText);
            var isVisible = !term || text.includes(term);
            
            row.style.display = isVisible ? '' : 'none';
            if (isVisible) visibleCount++;
        });
        
        currentCount.textContent = visibleCount;
    });
})();
</script>
}
