@model List<StockFlow.Models.Product>
@using System.Linq
@using Microsoft.AspNetCore.Http
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Live Stock";
    var isAdmin   = Context.Session.GetString("Role") == "Admin";
    int total     = Model.Count;
    int outOf     = Model.Count(p => p.Quantity == 0);
    int low       = Model.Count(p => p.Quantity > 0 && p.Quantity <= p.ReorderLevel);
    int available = Model.Count(p => p.Quantity > p.ReorderLevel);
}

<style>
/* ── wrapper ── */
.ls-wrap {
    position: relative;
    margin: -22px -26px 0;
    padding: 32px 28px 52px;
    min-height: calc(100vh - 60px);
    font-family: 'Inter', sans-serif;
}
.ls-wrap::before {
    content: ""; position: absolute; inset: 0;
    background-image: url('/images/livestock-bg.jpeg?v=1');
    background-size: cover; background-position: center;
    background-repeat: no-repeat;
    z-index: 0; pointer-events: none;
}
.ls-wrap::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(160deg,
        rgba(4,12,28,.78) 0%,
        rgba(4,12,28,.62) 40%,
        rgba(4,12,28,.62) 70%,
        rgba(4,12,28,.80) 100%);
    z-index: 0; pointer-events: none;
}
.ls-wrap > * { position: relative; z-index: 1; }

/* ── header ── */
.ls-header { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:26px; }
.ls-header-left h1 { font-size:28px; font-weight:800; color:#fff; margin:0; letter-spacing:-.4px; text-shadow:0 2px 20px rgba(0,0,0,.7); }
.ls-header-left h1 i { color:#4ade80; margin-right:10px; }
.ls-header-left p { font-size:13px; color:#94a3b8; margin:5px 0 0; }
.ls-header-right { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }

/* ── buttons ── */
.btn-adjust {
    background:linear-gradient(135deg,#16a34a,#22c55e);
    color:#fff; border:none; border-radius:10px;
    padding:10px 20px; font-size:13.5px; font-weight:700;
    display:inline-flex; align-items:center; gap:7px;
    text-decoration:none;
    box-shadow:0 4px 20px rgba(34,197,94,.4);
    transition:transform .18s,box-shadow .18s;
}
.btn-adjust:hover { transform:translateY(-2px); box-shadow:0 8px 28px rgba(34,197,94,.55); color:#fff; }
.btn-exp { border-radius:9px; padding:8px 14px; font-size:12.5px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none; transition:all .18s; }
.btn-exp-g { background:rgba(34,197,94,.15); color:#86efac; border:1px solid rgba(34,197,94,.35); }
.btn-exp-g:hover { background:rgba(34,197,94,.30); color:#fff; }
.btn-exp-r { background:rgba(239,68,68,.15); color:#fca5a5; border:1px solid rgba(239,68,68,.35); }
.btn-exp-r:hover { background:rgba(239,68,68,.30); color:#fff; }
.btn-ledger { background:rgba(124,58,237,.18); color:#c4b5fd; border:1px solid rgba(124,58,237,.38); border-radius:9px; padding:8px 14px; font-size:12.5px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none; transition:all .18s; }
.btn-ledger:hover { background:rgba(124,58,237,.35); color:#fff; }

/* ── stat cards ── */
.ls-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:24px; }
@@media(max-width:900px){ .ls-stats { grid-template-columns:repeat(2,1fr); } }
.lsc { border-radius:14px; padding:18px 20px; display:flex; align-items:center; gap:14px; border:1.5px solid rgba(255,255,255,.22); transition:transform .2s; background:transparent; }
.lsc:hover { transform:translateY(-2px); }
.lsc-icon { width:48px; height:48px; border-radius:13px; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:22px; }
.lsc-val { font-size:24px; font-weight:800; color:#fff; line-height:1; text-shadow:0 2px 8px rgba(0,0,0,.5); }
.lsc-lbl { font-size:11.5px; font-weight:600; margin-top:3px; }
.lsc-note { font-size:11px; margin-top:2px; }

.lsc-purple { border-color:rgba(124,58,237,.45); }
.lsc-purple .lsc-icon { background:rgba(124,58,237,.25); color:#c4b5fd; }
.lsc-purple .lsc-lbl  { color:#c4b5fd; }
.lsc-purple .lsc-note { color:rgba(196,181,253,.6); }

.lsc-green  { border-color:rgba(34,197,94,.45); }
.lsc-green  .lsc-icon { background:rgba(34,197,94,.25); color:#86efac; }
.lsc-green  .lsc-lbl  { color:#86efac; }
.lsc-green  .lsc-note { color:rgba(134,239,172,.6); }

.lsc-amber  { border-color:rgba(245,158,11,.45); }
.lsc-amber  .lsc-icon { background:rgba(245,158,11,.25); color:#fcd34d; }
.lsc-amber  .lsc-lbl  { color:#fcd34d; }
.lsc-amber  .lsc-note { color:rgba(252,211,77,.6); }

.lsc-red    { border-color:rgba(239,68,68,.45); }
.lsc-red    .lsc-icon { background:rgba(239,68,68,.25); color:#fca5a5; }
.lsc-red    .lsc-lbl  { color:#fca5a5; }
.lsc-red    .lsc-note { color:rgba(252,165,165,.6); }

/* ── search ── */
.ls-toolbar { display:flex; align-items:center; gap:10px; margin-bottom:20px; flex-wrap:wrap; }
.ls-search { position:relative; flex:1; max-width:380px; }
.ls-search input {
    width:100%; background:rgba(0,0,0,.50);
    border:1.5px solid rgba(255,255,255,.28);
    border-radius:10px; padding:10px 14px 10px 40px;
    font-size:13.5px; color:#fff;
    font-family:'Inter',sans-serif; outline:none;
    transition:border-color .18s,box-shadow .18s;
    caret-color:#ffffff;
}
.ls-search input::placeholder { color:rgba(255,255,255,.5); }
.ls-search input:focus { border-color:rgba(34,197,94,.8); box-shadow:0 0 0 3px rgba(34,197,94,.18); background:rgba(0,0,0,.65); }
.ls-search i { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:rgba(255,255,255,.55); font-size:15px; pointer-events:none; }

/* ── glass table card ── */
.ls-card {
    background: transparent;
    border: 1.5px solid rgba(255,255,255,.25);
    border-radius: 18px; overflow: hidden;
    box-shadow: 0 0 0 1px rgba(34,197,94,.12), 0 4px 24px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.07);
}

/* bootstrap reset */
.ls-card .table { --bs-table-bg:transparent; --bs-table-hover-bg:transparent; --bs-table-striped-bg:transparent; --bs-table-color:#fff; color:#fff; width:100%; margin:0; }
.ls-card .table > :not(caption) > * { background-color:transparent !important; }
.ls-card .table > :not(caption) > * > * { background-color:transparent !important; border-bottom-color:rgba(255,255,255,.10) !important; color:#fff !important; box-shadow:none !important; }
.ls-card .table-hover > tbody > tr:hover > * { background-color:rgba(34,197,94,.07) !important; }

/* thead */
.ls-card thead tr { background:rgba(10,60,30,.75) !important; }
.ls-card thead th { color:#fff !important; font-size:10.5px !important; font-weight:800 !important; letter-spacing:1.4px !important; text-transform:uppercase !important; padding:14px 18px !important; border:none !important; border-bottom:2px solid rgba(34,197,94,.45) !important; background:transparent !important; text-shadow:0 1px 5px rgba(0,0,0,.5); white-space:nowrap; }

/* tbody */
.ls-card tbody td { padding:14px 18px !important; vertical-align:middle !important; }

/* ── cells ── */
.c-prod { display:flex; align-items:center; gap:12px; }
.c-prod-ico { width:40px; height:40px; border-radius:11px; background:rgba(34,197,94,.15); color:#86efac; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
.c-prod-name { font-weight:700; color:#fff; font-size:14px; text-shadow:0 1px 5px rgba(0,0,0,.4); }
.c-prod-cat  { font-size:12px; color:rgba(255,255,255,.55); margin-top:1px; }

.c-sku { display:inline-block; background:rgba(124,58,237,.22); color:#ddd6fe; border:1px solid rgba(124,58,237,.40); padding:3px 10px; border-radius:7px; font-size:11.5px; font-weight:700; font-family:monospace; letter-spacing:.4px; }
.c-sup { font-size:13px; color:rgba(255,255,255,.75); font-weight:500; }

/* stock badge */
.stk-badge { display:inline-flex; align-items:center; gap:5px; border-radius:20px; padding:4px 12px; font-size:12.5px; font-weight:700; }
.stk-ok    { background:rgba(34,197,94,.22);  color:#86efac; border:1px solid rgba(34,197,94,.45); }
.stk-low   { background:rgba(245,158,11,.22); color:#fcd34d; border:1px solid rgba(245,158,11,.45); }
.stk-out   { background:rgba(239,68,68,.22);  color:#fca5a5; border:1px solid rgba(239,68,68,.45); }
.stk-sub   { font-size:11px; color:rgba(255,255,255,.5); margin-top:3px; }

/* reorder progress */
.r-bar-wrap { width:130px; }
.r-bar-lbl  { font-size:12.5px; color:#fff; font-weight:600; margin-bottom:5px; }
.r-bar      { height:5px; background:rgba(255,255,255,.1); border-radius:999px; overflow:hidden; margin-bottom:3px; }
.r-fill-ok  { height:100%; border-radius:999px; background:linear-gradient(90deg,#16a34a,#22c55e); }
.r-fill-low { height:100%; border-radius:999px; background:linear-gradient(90deg,#d97706,#f59e0b); }
.r-fill-out { height:100%; border-radius:999px; background:linear-gradient(90deg,#dc2626,#ef4444); }
.r-note     { font-size:11px; color:rgba(255,255,255,.45); }

/* date */
.c-date  { font-size:13px; color:#fff; font-weight:600; }
.c-time  { font-size:11.5px; color:rgba(255,255,255,.5); margin-top:2px; }

/* adjust btn */
.ab-adjust { font-size:12px; font-weight:600; padding:6px 14px; border-radius:9px; border:1px solid rgba(34,197,94,.45); background:rgba(34,197,94,.18); color:#86efac; text-decoration:none; display:inline-flex; align-items:center; gap:5px; transition:all .15s; }
.ab-adjust:hover { background:rgba(34,197,94,.38); color:#fff; }

.ls-foot { padding:13px 20px; color:rgba(255,255,255,.5); font-size:12.5px; border-top:1px solid rgba(255,255,255,.08); }
.ls-empty { text-align:center; padding:50px; color:rgba(255,255,255,.35); font-size:14px; }

/* responsive: wide table scrolls inside its card instead of clipping the whole page */
.ls-card .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.ls-card .table { min-width: 780px; }
@@media (max-width: 640px){
    .ls-stats { grid-template-columns: 1fr; }
    .ls-header-left h1 { font-size: 22px; }
    .ls-search { max-width: none; width: 100%; }
}
</style>

<div class="ls-wrap">

    <!-- Header -->
    <div class="ls-header">
        <div class="ls-header-left">
            <h1><i class="bi bi-graph-up"></i>Live Stock</h1>
            <p style="color:#ffffff !important;font-weight:600 !important;text-shadow:0 2px 6px rgba(0,0,0,0.8) !important;">Real-time inventory levels &middot; @Model.Count product@(Model.Count != 1 ? "s" : "") tracked</p>
        </div>
        <div class="ls-header-right">
            <a asp-action="Movements" class="btn-ledger">
                <i class="bi bi-journal-text"></i>Ledger
            </a>
            <a asp-controller="Export" asp-action="StockExcel" class="btn-exp btn-exp-g">
                <i class="bi bi-file-earmark-excel"></i>Excel
            </a>
            <a asp-controller="Export" asp-action="StockPdf" class="btn-exp btn-exp-r">
                <i class="bi bi-file-earmark-pdf"></i>PDF
            </a>
            @if (isAdmin) {
                <a asp-action="Adjust" class="btn-adjust">
                    <i class="bi bi-plus-lg"></i>Adjust Stock
                </a>
            }
        </div>
    </div>

    <!-- Stat cards -->
    <div class="ls-stats">
        <div class="lsc lsc-purple">
            <div class="lsc-icon"><i class="bi bi-boxes"></i></div>
            <div>
                <div class="lsc-val">@total</div>
                <div class="lsc-lbl">Total Products</div>
                <div class="lsc-note">All inventory items</div>
            </div>
        </div>
        <div class="lsc lsc-green">
            <div class="lsc-icon"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="lsc-val">@available</div>
                <div class="lsc-lbl">In Stock</div>
                <div class="lsc-note">Above reorder level</div>
            </div>
        </div>
        <div class="lsc lsc-amber">
            <div class="lsc-icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div>
                <div class="lsc-val">@low</div>
                <div class="lsc-lbl">Low Stock</div>
                <div class="lsc-note">Needs attention</div>
            </div>
        </div>
        <div class="lsc lsc-red">
            <div class="lsc-icon"><i class="bi bi-x-circle"></i></div>
            <div>
                <div class="lsc-val">@outOf</div>
                <div class="lsc-lbl">Out of Stock</div>
                <div class="lsc-note">Immediate reorder</div>
            </div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="ls-toolbar">
        <div class="ls-search">
            <i class="bi bi-search"></i>
            <input id="lsSearch" type="text" placeholder="Search product, SKU, supplier..." autocomplete="off" />
        </div>
    </div>

    <!-- Table -->
    <div class="ls-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Supplier</th>
                        <th>Stock</th>
                        <th>Reorder Level</th>
                        <th>Updated</th>
                        @if (isAdmin) { <th></th> }
                    </tr>
                </thead>
                <tbody id="lsBody">
                    @foreach (var p in Model) {
                        var status    = p.Quantity == 0 ? "out" : (p.Quantity <= p.ReorderLevel ? "low" : "ok");
                        var statusTxt = p.Quantity == 0 ? "Out of Stock" : (p.Quantity <= p.ReorderLevel ? "Low Stock" : "In Stock");
                        var fill      = p.ReorderLevel > 0 ? Math.Min(100, (int)Math.Round(p.Quantity * 100.0 / p.ReorderLevel)) : 100;
                        var category  = p.Category?.CategoryName ?? p.CategoryName ?? "—";
                        <tr class="ls-item" data-name="@((p.ProductName + " " + p.SKU + " " + (p.Supplier?.SupplierName ?? "")).ToLower())">
                            <td>
                                <div class="c-prod">
                                    <div class="c-prod-ico"><i class="bi bi-box-seam"></i></div>
                                    <div>
                                        <div class="c-prod-name">@p.ProductName</div>
                                        <div class="c-prod-cat">@category</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="c-sku">@p.SKU</span></td>
                            <td><span class="c-sup">@(string.IsNullOrWhiteSpace(p.Supplier?.SupplierName) ? "—" : p.Supplier!.SupplierName)</span></td>
                            <td>
                                <span class="stk-badge stk-@status">
                                    <i class="bi @(status == "ok" ? "bi-check-circle-fill" : status == "low" ? "bi-exclamation-circle-fill" : "bi-x-circle-fill")"></i>
                                    @p.Quantity pcs
                                </span>
                                <div class="stk-sub">@statusTxt</div>
                            </td>
                            <td>
                                <div class="r-bar-wrap">
                                    <div class="r-bar-lbl">@p.ReorderLevel pcs</div>
                                    <div class="r-bar">
                                        <div class="r-fill-@status" style="width:@(fill)%"></div>
                                    </div>
                                    <div class="r-note">Order qty: @p.ReorderQuantity</div>
                                </div>
                            </td>
                            <td>
                                <div class="c-date">@p.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                <div class="c-time">@p.UpdatedAt.ToLocalTime().ToString("hh:mm tt")</div>
                            </td>
                            @if (isAdmin) {
                                <td class="text-end">
                                    <a asp-action="Adjust" asp-route-productId="@p.Id" class="ab-adjust">
                                        <i class="bi bi-sliders"></i>Adjust
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                    @if (!Model.Any()) {
                        <tr><td colspan="7" class="ls-empty">No products in inventory yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ls-foot" id="lsFoot">Showing @Model.Count product@(Model.Count == 1 ? "" : "s")</div>
    </div>

</div>

@section Scripts {
<script>
(function () {
    var inp   = document.getElementById('lsSearch');
    var rows  = Array.from(document.querySelectorAll('#lsBody .ls-item'));
    var foot  = document.getElementById('lsFoot');
    inp.addEventListener('input', function () {
        var q = inp.value.trim().toLowerCase();
        var shown = 0;
        rows.forEach(function(r) {
            var match = !q || r.getAttribute('data-name').indexOf(q) !== -1;
            r.style.display = match ? '' : 'none';
            if (match) shown++;
        });
        foot.textContent = 'Showing ' + shown + ' product' + (shown === 1 ? '' : 's');
    });

    // Force tbody transparent
    document.querySelectorAll('.ls-card table, .ls-card table tbody, .ls-card table tbody tr, .ls-card table tbody td').forEach(function(el) {
        el.style.setProperty('background', 'transparent', 'important');
        el.style.setProperty('background-color', 'transparent', 'important');
    });
})();
</script>
}
