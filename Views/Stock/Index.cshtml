@model List<StockFlow.Models.Product>
@using System.Linq
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Live Stock";
    var isAdmin = Context.Session.GetString("Role") == "Admin";

    int total     = Model.Count;
    int outOf     = Model.Count(p => p.Quantity == 0);
    int low       = Model.Count(p => p.Quantity > 0 && p.Quantity <= p.ReorderLevel);
    int available = Model.Count(p => p.Quantity > p.ReorderLevel);
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* ===== Live Stock — premium dark UI (frontend only) ===== */
    .lsx {
        margin: -22px -26px 0; padding: 26px 26px 44px; min-height: calc(100vh - 74px);
        --bg: #0F172A; --card: #162033; --primary: #7C3AED; --success: #22C55E;
        --danger: #EF4444; --warning: #F59E0B; --text: #F8FAFC; --sec: #94A3B8;
        --bd: rgba(255,255,255,.06);
        background: var(--bg); color: var(--text);
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    }
    .lsx *, .lsx *::before, .lsx *::after { font-family: inherit; box-sizing: border-box; }

    /* Header + toolbar */
    .ls-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 24px; flex-wrap: wrap; }
    .ls-head h1 { font-size: 26px; font-weight: 700; margin: 0 0 4px; }
    .ls-head p { color: var(--sec); font-size: 14px; margin: 0; }
    .ls-tools { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .ls-btn {
        display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px;
        border-radius: 12px; border: 1px solid var(--bd); background: var(--card); color: var(--text);
        font-size: 13.5px; font-weight: 600; text-decoration: none; transition: .2s; white-space: nowrap;
    }
    .ls-btn:hover { border-color: rgba(124,58,237,.5); background: rgba(124,58,237,.10); color: var(--text); }
    .ls-btn i { font-size: 16px; }
    .ls-btn.excel i { color: #22C55E; }
    .ls-btn.pdf i { color: #EF4444; }
    .ls-btn-primary { background: linear-gradient(135deg,#7C3AED,#6d28d9); border-color: transparent; }
    .ls-btn-primary:hover { opacity: .92; background: linear-gradient(135deg,#7C3AED,#6d28d9); }

    /* Stat cards */
    .ls-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 22px; }
    .ls-stat {
        background: var(--card); border: 1px solid var(--bd); border-radius: 18px; padding: 20px 22px;
        display: flex; align-items: center; gap: 16px; box-shadow: 0 8px 24px rgba(2,6,23,.30); transition: transform .25s;
    }
    .ls-stat:hover { transform: translateY(-3px); }
    .ls-stat .s-ico { width: 48px; height: 48px; border-radius: 13px; display: grid; place-items: center; font-size: 22px; flex: 0 0 48px; }
    .ls-stat .s-lbl { font-size: 12.5px; color: var(--sec); font-weight: 600; }
    .ls-stat .s-val { font-size: 26px; font-weight: 800; line-height: 1.1; }
    .ls-stat .s-note { font-size: 11.5px; color: var(--sec); }
    .i-purple { background: rgba(124,58,237,.15); color: #a78bfa; }
    .i-green  { background: rgba(34,197,94,.15);  color: #4ade80; }
    .i-amber  { background: rgba(245,158,11,.15); color: #fbbf24; }
    .i-red    { background: rgba(239,68,68,.15);  color: #f87171; }

    /* Search */
    .ls-search {
        display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--bd);
        border-radius: 14px; padding: 12px 16px; margin-bottom: 20px;
    }
    .ls-search i { color: var(--sec); font-size: 17px; }
    .ls-search input { flex: 1; background: transparent; border: none; outline: none; color: var(--text); font-size: 14px; }
    .ls-search input::placeholder { color: var(--sec); }

    /* Table card */
    .ls-card { background: var(--card); border: 1px solid var(--bd); border-radius: 18px; overflow: hidden; box-shadow: 0 8px 24px rgba(2,6,23,.30); }
    .ls-table { width: 100%; border-collapse: collapse; }
    .ls-table thead th {
        position: sticky; top: 0; background: #1b2740; color: var(--sec); text-align: left;
        font-size: 12px; font-weight: 700; letter-spacing: .3px; text-transform: uppercase;
        padding: 14px 20px; border-bottom: 1px solid var(--bd); z-index: 1;
    }
    .ls-table tbody td { padding: 16px 20px; border-bottom: 1px solid var(--bd); font-size: 13.5px; vertical-align: middle; }
    .ls-table tbody tr { transition: background .2s; }
    .ls-table tbody tr:hover { background: rgba(255,255,255,.03); }
    .ls-table tbody tr:last-child td { border-bottom: none; }

    /* Product cell */
    .ls-prod { display: flex; align-items: center; gap: 13px; }
    .ls-prod .p-ico { width: 42px; height: 42px; border-radius: 11px; background: rgba(124,58,237,.12); color: #a78bfa;
        display: grid; place-items: center; font-size: 19px; flex: 0 0 42px; }
    .ls-prod .p-name { font-weight: 700; color: var(--text); }
    .ls-prod .p-type { font-size: 12px; color: var(--sec); }

    /* SKU badge */
    .ls-sku { display: inline-block; background: rgba(124,58,237,.12); color: #a78bfa; border: 1px solid rgba(124,58,237,.25);
        padding: 3px 10px; border-radius: 8px; font-size: 12px; font-weight: 700; letter-spacing: .3px; }
    .ls-sup { color: var(--sec); }

    /* Stock badge */
    .ls-stock .val { display: inline-block; padding: 4px 11px; border-radius: 999px; font-size: 12.5px; font-weight: 700; }
    .ls-stock .st { font-size: 11.5px; margin-top: 3px; display: flex; align-items: center; gap: 5px; }
    .ls-stock .dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
    .badge-red   { background: rgba(239,68,68,.16);  color: #fca5a5; }
    .badge-amber { background: rgba(245,158,11,.16); color: #fcd34d; }
    .badge-green { background: rgba(34,197,94,.16);  color: #86efac; }
    .txt-red { color: #f87171; } .txt-amber { color: #fbbf24; } .txt-green { color: #4ade80; }
    .bg-red { background: #ef4444; } .bg-amber { background: #f59e0b; } .bg-green { background: #22c55e; }

    /* Reorder trigger + progress */
    .ls-reorder .r-lbl { font-size: 13px; font-weight: 600; }
    .ls-reorder .r-bar { height: 5px; width: 130px; background: rgba(255,255,255,.08); border-radius: 999px; margin: 6px 0 3px; overflow: hidden; }
    .ls-reorder .r-fill { height: 100%; border-radius: 999px; }
    .ls-reorder .r-note { font-size: 11px; color: var(--sec); }

    /* Updated */
    .ls-upd .u-date { font-weight: 600; font-size: 13px; }
    .ls-upd .u-time { font-size: 12px; color: var(--sec); }

    /* Row Adjust button */
    .ls-adjust { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 10px;
        border: 1px solid rgba(124,58,237,.5); color: #a78bfa; background: transparent; font-size: 12.5px; font-weight: 600;
        text-decoration: none; transition: .2s; }
    .ls-adjust:hover { background: rgba(124,58,237,.14); color: #c4b5fd; }

    .ls-foot { padding: 14px 20px; color: var(--sec); font-size: 12.5px; border-top: 1px solid var(--bd); }
    .ls-empty { text-align: center; color: var(--sec); padding: 34px 0; }

    @@media (max-width: 991px) { .ls-stats { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 767px) { .lsx { margin: -22px -16px 0; padding: 20px 16px 36px; } .ls-stats { grid-template-columns: 1fr; } }
</style>

<div class="lsx">

    <!-- Header + toolbar -->
    <div class="ls-head">
        <div>
            <h1>Live Stock</h1>
            <p>Monitor inventory levels in real time.</p>
        </div>
        <div class="ls-tools">
            <a asp-action="Movements" class="ls-btn"><i class="bi bi-journal-text"></i> Ledger</a>
            <a asp-controller="Export" asp-action="StockExcel" class="ls-btn excel"><i class="bi bi-file-earmark-excel"></i> Excel</a>
            <a asp-controller="Export" asp-action="StockPdf" class="ls-btn pdf"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
            @if (isAdmin)
            {
                <a asp-action="Adjust" class="ls-btn ls-btn-primary"><i class="bi bi-plus-lg"></i> Adjust Stock</a>
            }
        </div>
    </div>

    <!-- Stat cards -->
    <div class="ls-stats">
        <div class="ls-stat">
            <div class="s-ico i-purple"><i class="bi bi-bag"></i></div>
            <div><div class="s-lbl">Total Products</div><div class="s-val">@total</div><div class="s-note">All products in inventory</div></div>
        </div>
        <div class="ls-stat">
            <div class="s-ico i-green"><i class="bi bi-box-seam"></i></div>
            <div><div class="s-lbl">Available</div><div class="s-val">@available</div><div class="s-note">Above reorder level</div></div>
        </div>
        <div class="ls-stat">
            <div class="s-ico i-amber"><i class="bi bi-exclamation-triangle"></i></div>
            <div><div class="s-lbl">Low Stock</div><div class="s-val">@low</div><div class="s-note">Need attention</div></div>
        </div>
        <div class="ls-stat">
            <div class="s-ico i-red"><i class="bi bi-x-circle"></i></div>
            <div><div class="s-lbl">Out of Stock</div><div class="s-val">@outOf</div><div class="s-note">Products out of stock</div></div>
        </div>
    </div>

    <!-- Search -->
    <div class="ls-search">
        <i class="bi bi-search"></i>
        <input id="lsSearch" type="text" placeholder="Search products..." autocomplete="off" />
    </div>

    <!-- Table -->
    <div class="ls-card">
        <div class="table-responsive">
            <table class="ls-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Supplier</th>
                        <th>Available</th>
                        <th>Reorder Trigger</th>
                        <th>Updated</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody id="lsBody">
                    @foreach (var p in Model)
                    {
                        var status = p.Quantity == 0 ? "red" : (p.Quantity <= p.ReorderLevel ? "amber" : "green");
                        var statusText = p.Quantity == 0 ? "Out of stock" : (p.Quantity <= p.ReorderLevel ? "Low stock" : "In stock");
                        var fill = p.ReorderLevel > 0 ? Math.Min(100, (int)Math.Round(p.Quantity * 100.0 / p.ReorderLevel)) : 100;
                        var category = p.Category?.CategoryName ?? p.CategoryName ?? "—";
                        <tr class="ls-item" data-name="@(((p.ProductName ?? "") + " " + (p.SKU ?? "")).ToLower())">
                            <td>
                                <div class="ls-prod">
                                    <div class="p-ico"><i class="bi bi-box-seam"></i></div>
                                    <div>
                                        <div class="p-name">@p.ProductName</div>
                                        <div class="p-type">@category</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="ls-sku">@p.SKU</span></td>
                            <td><span class="ls-sup">@(string.IsNullOrWhiteSpace(p.Supplier?.SupplierName) ? "No Supplier" : p.Supplier!.SupplierName)</span></td>
                            <td>
                                <div class="ls-stock">
                                    <span class="val badge-@status">@p.Quantity pcs</span>
                                    <div class="st txt-@status"><span class="dot bg-@status"></span>@statusText</div>
                                </div>
                            </td>
                            <td>
                                <div class="ls-reorder">
                                    <div class="r-lbl">@p.ReorderLevel / @p.ReorderQuantity pcs</div>
                                    <div class="r-bar"><div class="r-fill bg-@status" style="width:@(fill)%"></div></div>
                                    <div class="r-note">Threshold: @p.ReorderQuantity pcs</div>
                                </div>
                            </td>
                            <td>
                                <div class="ls-upd">
                                    <div class="u-date">@p.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div class="u-time">@p.UpdatedAt.ToLocalTime().ToString("hh:mm tt")</div>
                                </div>
                            </td>
                            <td class="text-end">
                                @if (isAdmin)
                                {
                                    <a asp-action="Adjust" asp-route-productId="@p.Id" class="ls-adjust"><i class="bi bi-pencil"></i> Adjust</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ls-foot" id="lsFoot">Showing @Model.Count product@(Model.Count == 1 ? "" : "s")</div>
    </div>

</div>

<script>
    // Minimal client-side search (filters the already-loaded rows; no backend change)
    (function () {
        var input = document.getElementById('lsSearch');
        var rows = Array.prototype.slice.call(document.querySelectorAll('#lsBody .ls-item'));
        var foot = document.getElementById('lsFoot');
        if (!input) return;
        input.addEventListener('input', function () {
            var q = input.value.trim().toLowerCase();
            var shown = 0;
            rows.forEach(function (r) {
                var match = r.getAttribute('data-name').indexOf(q) !== -1;
                r.style.display = match ? '' : 'none';
                if (match) shown++;
            });
            foot.textContent = 'Showing ' + shown + ' product' + (shown === 1 ? '' : 's');
        });
    })();
</script>
