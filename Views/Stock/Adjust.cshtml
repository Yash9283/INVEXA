@model StockFlow.Models.StockAdjustmentViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Adjust Stock";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Stock adjustment</h2>
        <p class="text-muted mb-0">
            Use a positive value to add stock and a negative value to remove it.
        </p>
    </div>

    <a asp-action="Movements" class="btn btn-outline-secondary">
        Ledger
    </a>
</div>

<div class="card shadow-sm border-0" style="max-width: 680px;">
    <div class="card-body p-4">

        <form asp-action="Adjust" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ProductId" class="form-label">
                    Product
                </label>

                <select asp-for="ProductId"
                        asp-items="@(ViewBag.Products)"
                        class="form-select">
                    <option value="">Choose product</option>
                </select>
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="MovementType" class="form-label">
                        Reason
                    </label>

                    <select asp-for="MovementType" class="form-select">
                        <option>Adjustment</option>
                        <option>Damage</option>
                        <option>Return</option>
                        <option>Purchase</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="QuantityDelta" class="form-label">
                        Quantity change
                    </label>

                    <input asp-for="QuantityDelta"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="QuantityDelta" class="text-danger"></span>
                </div>

            </div>

            <div class="mt-3">
                <label asp-for="Notes" class="form-label">
                    Notes
                </label>

                <textarea asp-for="Notes"
                          class="form-control"
                          rows="3"></textarea>
            </div>

            <button class="btn btn-primary mt-4">
                Save to ledger
            </button>

        </form>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
